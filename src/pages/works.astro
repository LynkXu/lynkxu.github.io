---
import ReadingShell from '../layouts/ReadingShell.astro';
import { works } from '../data/works';

const title = '项目';
const description = '我的项目。';
const pageTitleClass = 'r-page-title r-works__title !m-0 ![font-family:var(--r-font-body)] ![font-size:var(--r-text-page)] !font-semibold !leading-[var(--r-lh-tight)] !tracking-[-0.018em] !text-[var(--r-ink)]';
const workHeadClass = 'r-works__head mb-[var(--r-space-lg)]';
const workEmptyClass = 'r-works__empty m-0 [font-family:var(--r-font-body)] [font-size:var(--r-text-sm)] text-[var(--r-ink-soft)]';
const workListClass = 'r-work-list m-0 grid list-none grid-cols-[max-content_minmax(0,1fr)] gap-x-[var(--r-space-md)] gap-y-[var(--r-space-sm)] p-0 max-[640px]:grid-cols-1';
const workItemClass = 'r-work col-span-2 grid grid-cols-subgrid items-baseline max-[640px]:col-span-1 max-[640px]:grid-cols-1 max-[640px]:gap-y-[0.15rem]';
const workTitleClass = 'r-work__title inline-flex w-fit shrink-0 items-baseline justify-self-start gap-[var(--r-space-xs)] whitespace-nowrap !border-b-0 ![font-family:var(--r-font-body)] ![font-size:var(--text-md)] !font-normal !leading-[var(--r-lh-tight)] !text-[var(--r-ink)] !no-underline hover:!text-[var(--r-link)]';
const workNameClass = 'underline decoration-[var(--r-link-underline-color)] decoration-[1px] underline-offset-[var(--r-link-underline-offset)]';
const workMarkClass = 'r-work__mark inline-block h-[0.72em] w-[0.72em] shrink-0 self-center text-[var(--r-ink-soft)]';
const workDescClass = 'r-work__desc !m-0 min-w-0 ![font-family:var(--r-font-body)] ![font-size:var(--r-text-sm)] !font-normal !leading-[1.55] !text-[var(--r-ink-soft)]';

function isExternal(href: string) {
	return href.startsWith('http://') || href.startsWith('https://');
}
---

<ReadingShell title={title} description={description}>
	<section class="r-works" aria-labelledby="works-title">
		<header class={workHeadClass}>
			<h1 id="works-title" class={pageTitleClass}>项目</h1>
		</header>

		{works.length === 0 ? (
			<p class={workEmptyClass}>还没有项目。</p>
		) : (
			<ul class={workListClass}>
				{works.map((work) => {
					const external = isExternal(work.href);
					return (
						<li class={workItemClass}>
							<a
								href={work.href}
								class={workTitleClass}
								target={external ? '_blank' : undefined}
								rel={external ? 'noopener noreferrer' : undefined}
							>
								<span class={workNameClass}>{work.title}</span>
								{external && (
									<svg class={workMarkClass} viewBox="0 0 12 12" aria-hidden="true">
										<path d="M3.25 3.25h5.5v5.5M8.75 3.25 3.25 8.75" fill="none" stroke="currentColor" stroke-width="1.35" stroke-linecap="square" />
									</svg>
								)}
								{external && <span class="sr-only">（在新标签页打开）</span>}
							</a>
							<p class={workDescClass}>{work.description}</p>
						</li>
					);
				})}
			</ul>
		)}
	</section>
</ReadingShell>
