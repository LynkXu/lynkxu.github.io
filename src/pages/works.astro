---
import ReadingShell from '../layouts/ReadingShell.astro';
import { works } from '../data/works';

const title = '项目';
const description = '我的项目。';
const workEmptyClass = 'r-works__empty m-0 [font-family:var(--r-font-body)] [font-size:var(--r-text-sm)] text-[var(--r-ink-soft)]';

function isExternal(href: string) {
	return href.startsWith('http://') || href.startsWith('https://');
}

function resolveIconSrc(icon?: string) {
	if (!icon) return 'https://cdn.simpleicons.org/github';
	if (icon.startsWith('/') || icon.startsWith('http')) return icon;
	return `https://cdn.simpleicons.org/${icon}`;
}
---

<ReadingShell title={title} description={description}>
	<section class="r-works" aria-labelledby="works-title">
		<header class="r-works__head r-page-head">
			<h1 id="works-title" class="r-page-title r-works__title r-page-head__title">项目</h1>
			<p class="r-works__note r-page-head__note">一些做过或仍在维护的小项目。</p>
		</header>

		{works.length === 0 ? (
			<div class="r-card">
				<p class={workEmptyClass}>还没有项目。</p>
			</div>
		) : (
			<ul class="r-work-grid">
				{works.map((work) => {
					const external = isExternal(work.href);
					const iconSrc = resolveIconSrc(work.icon);
					const invertDark = work.icon ? Boolean(work.invertDark) : true;
					const stackLabel = work.stack?.length ? work.stack.join(' / ') : work.kind;
					const hasFoot = Boolean(work.status || stackLabel || work.year);
					return (
						<li class="r-work-item">
							<a
								href={work.href}
								class:list={['r-work-card', { 'r-work-card--active': work.active }]}
								target={external ? '_blank' : undefined}
								rel={external ? 'noopener noreferrer' : undefined}
							>
								<div class="r-work-card__body">
									<div class="r-work-card__head">
										<div class="r-work-card__identity">
											<span class:list={['r-work-card__icon', { 'invert-dark': invertDark }]} aria-hidden="true">
												<img
													src={iconSrc}
													alt=""
													width="20"
													height="20"
													style={work.iconScale ? `--icon-scale: ${work.iconScale}` : undefined}
													loading="lazy"
													decoding="async"
												/>
											</span>
											<span class="r-work-card__title">{work.title}</span>
										</div>
										{external && (
											<svg class="r-work-card__mark" viewBox="0 0 12 12" aria-hidden="true">
												<path d="M3.5 3.5h5v5M8.5 3.5L3.5 8.5" fill="none" stroke="currentColor" stroke-width="1.45" stroke-linecap="round" stroke-linejoin="round" />
											</svg>
										)}
										{external && <span class="sr-only">（在新标签页打开）</span>}
									</div>

									<p class="r-work-card__desc">{work.description}</p>
								</div>

								{hasFoot && (
									<div class="r-work-card__foot">
										<div class="r-work-card__meta">
											{work.status && (
												<span class:list={['r-work-card__status', { 'r-work-card__status--active': work.active }]}>
													{work.active && <span class="r-work-card__dot" aria-hidden="true"></span>}
													<span>{work.status}</span>
												</span>
											)}
											{work.status && stackLabel && (
												<span class="r-work-card__sep" aria-hidden="true">·</span>
											)}
											{stackLabel && <span class="r-work-card__stack">{stackLabel}</span>}
										</div>
										{work.year && <span class="r-work-card__year">{work.year}</span>}
									</div>
								)}
							</a>
						</li>
					);
				})}
			</ul>
		)}
	</section>
</ReadingShell>

<style>
	/* 均等两列项目卡片网格：顶行「图标 + 标题」组合对齐外链箭头，中段简介，底栏承接状态/技术栈/年份。 */
	.r-work-grid {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.95rem;
	}

	.r-work-item {
		display: flex;
	}

	.r-work-card {
		display: flex;
		flex-direction: column;
		width: 100%;
		overflow: hidden;
		padding: 0;
		border: 1px solid var(--r-card-border, var(--r-rule)) !important;
		border-radius: var(--r-card-radius, 6px);
		background: var(--r-card-bg, var(--r-bg));
		box-shadow: var(--r-card-shadow, none);
		text-decoration: none !important;
		color: inherit !important;
		transition: border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
	}

	.r-work-card:hover {
		border-color: color-mix(in oklab, var(--r-ink) 18%, var(--r-card-bg, var(--r-bg))) !important;
		transform: translateY(-1px);
		opacity: 1 !important;
	}

	.r-work-card:focus-visible {
		outline: 2px solid color-mix(in oklab, var(--r-link) 55%, transparent);
		outline-offset: 2px;
	}

	.r-work-card__body {
		flex: 1;
		padding: 1.2rem 1.25rem 1.1rem;
	}

	.r-work-card__head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
	}

	.r-work-card__identity {
		display: inline-flex;
		align-items: center;
		gap: 0.58rem;
		min-width: 0;
	}

	.r-work-card__icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
		width: 20px;
		height: 20px;
		background: transparent;
		border: 0;
		box-shadow: none;
	}

	.r-work-card__icon img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: contain;
	}

	.r-work-card__icon img[style*="--icon-scale"] {
		transform: scale(var(--icon-scale));
	}

	:global([data-theme="dark"]) .r-work-card__icon.invert-dark img {
		filter: invert(1);
	}

	@media (prefers-color-scheme: dark) {
		:global(:root:not([data-theme])) .r-work-card__icon.invert-dark img {
			filter: invert(1);
		}
	}

	.r-work-card__title {
		font-family: var(--r-font-body);
		font-size: 1.02rem;
		font-weight: 600;
		line-height: var(--r-lh-tight);
		letter-spacing: -0.012em;
		color: var(--r-ink-strong, var(--r-ink));
		transition: color 0.2s ease;
	}

	.r-work-card:hover .r-work-card__title {
		color: var(--r-link);
	}

	.r-work-card__mark {
		display: inline-block;
		width: 11px;
		height: 11px;
		flex-shrink: 0;
		color: var(--r-ink-faint);
		transition: transform 0.2s ease, color 0.2s ease;
	}

	.r-work-card:hover .r-work-card__mark {
		transform: translate(1px, -1px);
		color: var(--r-link);
	}

	.r-work-card__desc {
		margin: 0.62rem 0 0 !important;
		font-family: var(--r-font-body);
		font-size: 0.89rem;
		font-weight: 400;
		line-height: 1.66;
		color: var(--r-ink-soft);
	}

	.r-work-card__foot {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--r-space-sm);
		padding: 0.56rem 1.25rem;
		border-top: 1px solid var(--r-divider);
		background: color-mix(in oklab, var(--r-bg) 52%, var(--r-card-bg, var(--r-bg)));
		font-family: var(--r-font-ui);
		font-size: 0.72rem;
		line-height: 1.4;
		color: var(--r-ink-faint);
	}

	.r-work-card__meta {
		display: inline-flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.36rem;
		min-width: 0;
	}

	.r-work-card__status {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		color: var(--r-ink-soft);
	}

	.r-work-card__status--active {
		color: var(--r-link);
		font-weight: 500;
	}

	.r-work-card__dot {
		width: 0.34rem;
		height: 0.34rem;
		border-radius: 9999px;
		background: var(--r-link);
		flex-shrink: 0;
	}

	.r-work-card__sep {
		opacity: 0.55;
	}

	.r-work-card__year {
		flex-shrink: 0;
		font-family: var(--r-font-code);
		font-size: 0.7rem;
		font-variant-numeric: tabular-nums;
		color: var(--r-ink-faint);
	}

	@media (max-width: 640px) {
		.r-work-grid {
			grid-template-columns: 1fr;
			gap: 0.85rem;
		}

		.r-work-card__body {
			padding: 1.05rem 1.05rem 0.95rem;
		}

		.r-work-card__foot {
			padding: 0.54rem 1.05rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.r-work-card,
		.r-work-card__title,
		.r-work-card__mark {
			transition: none;
		}

		.r-work-card:hover,
		.r-work-card:hover .r-work-card__mark {
			transform: none;
		}
	}
</style>
