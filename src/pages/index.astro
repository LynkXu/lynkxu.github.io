---
import { getCollection } from 'astro:content';
import ReadingShell from '../layouts/ReadingShell.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { filterDrafts } from '../utils/drafts';
import AboutTraits from '../components/AboutTraits.astro';

const posts = filterDrafts(await getCollection('blog'))
	.filter((post) => !post.id.startsWith('en/'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const latestPosts = posts.slice(0, 8);
const sectionTitleClass = 'r-section__title !m-0 ![font-family:var(--r-font-ui)] ![font-size:var(--r-text-sm)] !font-semibold !tracking-[0.03em] !text-[var(--r-ink)]';
const homeIntroClass = 'r-home-intro r-card r-card--intro';
const homeIntroTextClass = 'r-home-intro__text !m-0 ![font-family:var(--r-font-body)] ![font-size:var(--r-text-lg)] !font-semibold !leading-[var(--r-lh-tight)] !tracking-[-0.018em] !text-[var(--r-ink-strong,var(--r-ink))]';

const profileLinks = [
	{ href: 'https://github.com/lynkxu', label: 'GitHub', external: true },
	{ href: 'https://mastodon.social/@lynkxu', label: 'Mastodon', external: true },
	{ href: '/about', label: '关于 →', external: false },
];

function getPostHref(post: (typeof posts)[number]) {
	return `/blog/${post.data.slug ?? post.id}.html`;
}
---

<ReadingShell title={SITE_TITLE} description={SITE_DESCRIPTION} className="reading-home">
	<section class={homeIntroClass} aria-label="简介">
		<div class="r-home-intro__main">
			<div class="r-home-intro__copy">
				<h1 class={homeIntroTextClass}>你好，我是 Lynk。</h1>
				<p class="r-home-intro__welcome"><span>很高兴你发现了这里。</span><span>希望你喜欢我写的内容，也祝你今天过得开心。</span></p>
			</div>
			<img class="r-home-intro__portrait" src="/avatar-224.webp" width="224" height="224" alt="Lynk 的个人头像" />
		</div>

		<div class="r-home-intro__foot">
			<AboutTraits variant="chips" />
			<nav class="r-home-intro__links" aria-label="快捷入口">
				{profileLinks.map((link) => (
					<a
						href={link.href}
						class="r-home-intro__link"
						target={link.external ? '_blank' : undefined}
						rel={link.external ? 'noopener noreferrer' : undefined}
					>
						{link.label}
					</a>
				))}
			</nav>
		</div>
	</section>

	<section class="r-section r-card" aria-labelledby="home-writing-title">
		<header class="r-section__head">
			<h2 id="home-writing-title" class={sectionTitleClass}>最近文章</h2>
			<a class="home-section-more" href="/blog">全部文章</a>
		</header>

		<ol class="r-post-list">
			{latestPosts.map((post) => (
				<li class="r-post-list__item">
					<a href={getPostHref(post)} class="r-post-list__title">{post.data.title}</a>
					<span class="r-post-list__date">
						<FormattedDate date={post.data.pubDate} />
					</span>
				</li>
			))}
		</ol>
	</section>

</ReadingShell>

<style>
	/* 首页藏书票双层名片（H1）：保持克制字号，通过上下呼吸与底栏纸签拉出从容体量。 */
	.r-home-intro {
		--r-traits-gap: 0px;
		margin-bottom: 0;
	}

	.r-home-intro__main {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		column-gap: clamp(1.5rem, 4vw, 2.25rem);
		align-items: center;
		padding: clamp(1.8rem, 4.2vw, 2.45rem) clamp(1.2rem, 3.8vw, 2.4rem) clamp(1.65rem, 3.8vw, 2.15rem);
	}

	.r-home-intro__copy {
		min-width: 0;
	}

	.r-home-intro__welcome {
		margin: 0.65rem 0 0;
		font-family: var(--r-font-body);
		font-size: 0.95rem;
		font-weight: 400;
		line-height: 1.78;
		color: var(--r-ink-soft);
		text-wrap: pretty;
	}

	.r-home-intro__welcome span + span {
		margin-inline-start: 0.25em;
	}

	.r-home-intro__portrait {
		width: 4.75rem;
		height: 4.75rem;
		aspect-ratio: 1;
		object-fit: cover;
		padding: 3px;
		border-radius: 50%;
		background: var(--r-card-bg, var(--r-bg));
		border: 1px solid color-mix(in oklab, var(--r-ink) 11%, transparent);
		box-shadow: 0 2px 8px rgba(15, 23, 42, 0.04);
		box-sizing: border-box;
	}

	:root[data-theme="dark"] .r-home-intro__portrait {
		box-shadow: 0 2px 8px rgba(0, 0, 0, 0.26);
	}

	@media (prefers-color-scheme: dark) {
		:root:not([data-theme]) .r-home-intro__portrait {
			box-shadow: 0 2px 8px rgba(0, 0, 0, 0.26);
		}
	}

	.r-home-intro__foot {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.65rem 1rem;
		padding: 0.9rem clamp(1.2rem, 3.8vw, 2.4rem);
		border-top: 1px solid var(--r-divider);
		background: color-mix(in oklab, var(--r-bg) 52%, var(--r-card-bg, var(--r-bg)));
	}

	.r-home-intro__links {
		display: inline-flex;
		align-items: center;
		gap: 0.9rem;
		flex-shrink: 0;
		font-family: var(--r-font-ui);
		font-size: 0.76rem;
		line-height: 1.4;
	}

	.r-home-intro__link {
		border-bottom: 0 !important;
		color: var(--r-ink-soft) !important;
		text-decoration: underline;
		text-decoration-color: transparent;
		text-decoration-thickness: 1px;
		text-underline-offset: var(--r-link-underline-offset);
		transition: color 0.2s ease, text-decoration-color 0.2s ease;
	}

	.r-home-intro__link:hover {
		color: var(--r-link) !important;
		text-decoration-color: var(--r-link-underline-color);
	}

	.home-section-more {
		font-family: var(--r-font-ui);
		font-size: var(--r-text-xs);
		color: var(--r-link);
		border-bottom: 0;
		text-decoration: underline;
		text-decoration-color: transparent;
		text-decoration-thickness: 1px;
		text-underline-offset: var(--r-link-underline-offset);
		transition: color 0.2s ease, text-decoration-color 0.2s ease;
	}

	.home-section-more:hover {
		color: var(--r-link);
		text-decoration-color: var(--r-link-underline-color);
	}

	@media (max-width: 640px) {
		.r-home-intro__main {
			column-gap: var(--space-md);
			align-items: start;
			padding: 1.4rem 1.05rem 1.25rem;
		}

		.r-home-intro__welcome {
			margin-top: 0.5rem;
			font-size: 0.92rem;
		}

		.r-home-intro__portrait {
			width: 3.75rem;
			height: 3.75rem;
			padding: 2px;
		}

		.r-home-intro__foot {
			padding: 0.78rem 1.05rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.r-home-intro__link,
		.home-section-more {
			transition: none;
		}
	}
</style>
