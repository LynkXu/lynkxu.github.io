---
import { getCollection } from 'astro:content';
import ReadingShell from '../layouts/ReadingShell.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { filterDrafts } from '../utils/drafts';
import AboutTraits from '../components/AboutTraits.astro';

const posts = filterDrafts(await getCollection('blog'))
	.filter((post) => !post.id.startsWith('en/'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const latestPosts = posts.slice(0, 5);
const sectionTitleClass = 'r-section__title !m-0 ![font-family:var(--r-font-ui)] ![font-size:var(--r-text-sm)] !font-semibold !tracking-[0.03em] !text-[var(--r-ink)]';
const homeIntroClass = 'r-home-intro';
const homeIntroTextClass = 'r-home-intro__text !m-0 ![font-family:var(--r-font-body)] ![font-size:var(--r-text-page)] !font-semibold !leading-[var(--r-lh-tight)] !tracking-[-0.018em] !text-[var(--r-ink)]';

function getPostHref(post: (typeof posts)[number]) {
	return `/blog/${post.data.slug ?? post.id}.html`;
}
---

<ReadingShell title={SITE_TITLE} description={SITE_DESCRIPTION} className="reading-home">
	<section class={homeIntroClass} aria-label="简介">
		<h1 class={homeIntroTextClass}>你好，我是 Lynk。</h1>
		<p class="r-home-intro__welcome"><span>很高兴你发现了这里。</span><span>希望你喜欢我写的内容，也祝你今天过得开心。</span></p>
		<img class="r-home-intro__portrait" src="/avatar-224.webp" width="224" height="224" alt="Lynk 的个人头像" />
		<AboutTraits />
	</section>

	<section class="r-section" aria-labelledby="home-writing-title">
		<header class="r-section__head">
			<h2 id="home-writing-title" class={sectionTitleClass}>最近文章</h2>
			<a class="home-section-more" href="/blog">全部文章</a>
		</header>

		<ol class="r-post-list">
			{latestPosts.map((post) => (
				<li class="r-post-list__item">
					<a href={getPostHref(post)} class="r-post-list__title">{post.data.title}</a>
					<span class="r-post-list__date">
						<FormattedDate date={post.data.pubDate} />
					</span>
				</li>
			))}
		</ol>
	</section>

</ReadingShell>

<style>
	/* 首页以文章为主体；标题和日期沿用非专题页的公共索引规则。 */
	:global(.portal-surface:not(.portal-surface--wide).reading-home) {
		--r-header-content-space: var(--space-2xl);
	}

	.r-home-intro {
		--r-traits-gap: 0px;
		display: grid;
		grid-template-columns: minmax(0, 1fr) calc(var(--space-4xl) + var(--space-md));
		column-gap: var(--space-xl);
		row-gap: var(--space-md);
		align-items: start;
		margin-bottom: var(--space-3xl);
	}

	.r-home-intro__text { grid-column: 1; }

	.r-home-intro__welcome {
		grid-column: 1;
		max-inline-size: 26em;
		margin: 0;
		font-family: var(--r-font-body);
		font-size: var(--text-md);
		font-weight: 400;
		line-height: var(--lh-body);
		color: var(--r-ink-soft);
	}

	.r-home-intro__welcome span { display: block; }

	.r-home-intro__portrait {
		grid-column: 2;
		grid-row: 1 / 3;
		width: 100%;
		height: auto;
		aspect-ratio: 1;
		object-fit: contain;
		border-radius: 50%;
		border: 0;
		box-sizing: border-box;
	}

	.r-home-intro :global(.r-about__traits) { grid-column: 1 / -1; }

	@media (max-width: 640px) {
		:global(.portal-surface:not(.portal-surface--wide).reading-home) {
			--r-header-content-space: var(--space-xl);
		}

		.r-home-intro {
			margin-bottom: var(--space-2xl);
			grid-template-columns: minmax(0, 1fr) var(--space-4xl);
			column-gap: var(--space-md);
		}
		.r-home-intro__text { align-self: center; }
		.r-home-intro__portrait { grid-row: 1; }
		.r-home-intro__welcome { grid-column: 1 / -1; }
	}

	.r-section { margin-bottom: 0; }

	.home-section-more {
		font-family: var(--r-font-ui);
		font-size: var(--r-text-xs);
		font-weight: 400;
		color: var(--r-link);
		white-space: nowrap;
	}

</style>
