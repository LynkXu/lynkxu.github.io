---
import { getCollection } from 'astro:content';
import ReadingShell from '../layouts/ReadingShell.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { filterDrafts } from '../utils/drafts';
import { getAllGossips } from '../utils/gossips';
import { toPlainExcerpt } from '../utils/plain-text';

const posts = filterDrafts(await getCollection('blog'))
	.filter((post) => !post.id.startsWith('en/'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const latestPosts = posts.slice(0, 6);
const latestGossips = (await getAllGossips()).slice(0, 3);
const sectionTitleClass = 'r-section__title !m-0 ![font-family:var(--r-font-ui)] ![font-size:var(--r-text-sm)] !font-semibold !tracking-[0.03em] !text-[var(--r-ink-soft)]';
const homeIntroClass = 'r-home-intro m-0 mb-[var(--r-space-2xl)]';
const homeIntroTextClass = 'r-home-intro__text !m-0 ![font-family:var(--r-font-body)] ![font-size:var(--r-text-page)] !font-medium !leading-[var(--r-lh-tight)] !tracking-[-0.018em] !text-[var(--r-ink)]';

function getPostHref(post: (typeof posts)[number]) {
	return `/blog/${post.data.slug ?? post.id}.html`;
}
---

<ReadingShell title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<section class={homeIntroClass} aria-label="简介">
		<h1 class={homeIntroTextClass}>你好，我是 Lynk。</h1>
	</section>

	<section class="r-section" aria-labelledby="home-writing-title">
		<header class="r-section__head">
			<h2 id="home-writing-title" class={sectionTitleClass}>最近文章</h2>
			<a href="/blog" class="r-section__more" aria-label="查看全部文章">全部</a>
		</header>

		<ol class="r-post-list">
			{latestPosts.map((post) => (
				<li class="r-post-list__item">
					<a href={getPostHref(post)} class="r-post-list__title">{post.data.title}</a>
					<span class="r-post-list__date">
						<FormattedDate date={post.data.pubDate} />
					</span>
				</li>
			))}
		</ol>
	</section>

	{latestGossips.length > 0 && (
		<section class="r-section" aria-labelledby="home-notes-title">
			<header class="r-section__head">
				<h2 id="home-notes-title" class={sectionTitleClass}>碎语</h2>
				<a href="/shuoshuo" class="r-section__more" aria-label="查看全部碎语">全部</a>
			</header>

			<ul class="r-note-list">
				{latestGossips.map((gossip) => {
					const excerpt = toPlainExcerpt(gossip.body || '', 80);
					return (
						<li class="r-note-list__item">
							<a href="/shuoshuo">
								<span class="r-note-list__date">
									<FormattedDate date={gossip.data.pubDate} />
								</span>
								<span class="home-note-excerpt">{excerpt || '（无文字）'}</span>
							</a>
						</li>
					);
				})}
			</ul>
		</section>
	)}
</ReadingShell>

<style>
	/* 首页把文章目录和碎语预览组合在一起；局部调整密度，沿用阅读布局的 token。 */
	.r-section + .r-section {
		margin-top: var(--r-space-2xl);
	}

	.r-post-list {
		gap: var(--r-space-sm);
	}

	.r-note-list {
		gap: var(--r-space-sm);
	}

	.r-note-list a {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		align-items: start;
		column-gap: var(--r-space-md);
		white-space: normal;
		padding: 0;
	}

	.home-note-excerpt {
		grid-column: 1;
		overflow: hidden;
		white-space: nowrap;
		text-overflow: ellipsis;
		line-height: 1.55;
	}

	.r-note-list__date {
		grid-column: 2;
		grid-row: 1;
		margin: 0;
		font-weight: 500;
		line-height: 1.3;
	}

	@media (max-width: 640px) {
		.r-post-list__item {
			grid-template-columns: minmax(0, 1fr);
			gap: 0.1rem;
		}

		.r-post-list__date {
			grid-column: 1;
			justify-self: start;
			text-align: left;
		}

		.r-note-list a {
			grid-template-columns: minmax(0, 1fr);
			row-gap: 0.1rem;
		}

		.home-note-excerpt {
			grid-column: 1;
			grid-row: 1;
			white-space: normal;
		}

		.r-note-list__date {
			grid-column: 1;
			grid-row: 2;
			justify-self: start;
		}
	}
</style>
