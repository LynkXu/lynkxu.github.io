---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import ReadingShell from '../layouts/ReadingShell.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { filterDrafts } from '../utils/drafts';
import heroPhoto from '../content/photography/IMG_7136.jpeg';

const posts = filterDrafts(await getCollection('blog'))
	.filter((post) => !post.id.startsWith('en/'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const latestPosts = posts.slice(0, 8);
const sectionTitleClass = 'r-section__title !m-0 ![font-family:var(--r-font-ui)] ![font-size:var(--r-text-sm)] !font-semibold !tracking-[0.03em] !text-[var(--r-ink)]';

function getPostHref(post: (typeof posts)[number]) {
	return `/blog/${post.data.slug ?? post.id}.html`;
}
---

<ReadingShell title={SITE_TITLE} description={SITE_DESCRIPTION} className="reading-home">
	<div class="r-home-sheet r-card">
		<figure class="r-home-cover">
			<Image
				src={heroPhoto}
				alt="暮色中的湖面、远山与长桥"
				width={1400}
				format="webp"
				quality={85}
				loading="eager"
				decoding="async"
				fetchpriority="high"
				class="r-home-cover__image"
			/>
		</figure>

		<div class="r-home-body">
			<section class="r-home-intro" aria-label="简介">
				<h1 class="r-home-intro__title">你好，我是 Lynk。</h1>

				<p class="r-home-intro__welcome">
					很高兴你发现了这里。希望你喜欢我写的内容，也祝你今天过得开心。
					<a href="/about" class="r-home-intro__about">关于我 →</a>
				</p>
			</section>

			<section class="r-section r-home-writing" aria-labelledby="home-writing-title">
				<header class="r-section__head r-home-writing__head">
					<h2 id="home-writing-title" class={sectionTitleClass}>最近文章</h2>
					<a class="home-section-more" href="/blog">全部文章</a>
				</header>

				<ol class="r-post-list">
					{latestPosts.map((post) => (
						<li class="r-post-list__item">
							<a href={getPostHref(post)} class="r-post-list__title">{post.data.title}</a>
							<span class="r-post-list__date">
								<FormattedDate date={post.data.pubDate} />
							</span>
						</li>
					))}
				</ol>
			</section>
		</div>
	</div>
</ReadingShell>

<style>
	/* 首页扉页单白卡：沿用文章页顶部贴边封面语法（无嵌套内框），纯单轴直下进入文章目录。 */
	:global(.portal-surface:not(.portal-surface--wide)) .r-home-sheet.r-card {
		padding: 0;
		overflow: hidden;
	}

	.r-home-cover {
		margin: 0;
		aspect-ratio: 16 / 6.4;
		max-height: 290px;
		background: color-mix(in oklab, var(--r-bg) 70%, var(--r-card-bg, var(--r-bg)));
		border-bottom: 1px solid var(--r-divider);
	}

	.r-home-cover__image {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center 48%;
	}

	.r-home-body {
		padding: clamp(1.5rem, 3.6vw, 2.2rem) clamp(1.2rem, 3.5vw, 2.25rem) clamp(1.65rem, 3.8vw, 2.35rem);
	}

	.r-home-intro {
		margin: 0;
	}

	.r-home-intro__title {
		margin: 0 !important;
		font-family: var(--r-font-body) !important;
		font-size: var(--text-lg) !important;
		font-weight: 600 !important;
		line-height: var(--r-lh-tight) !important;
		letter-spacing: -0.014em !important;
		color: var(--r-ink-strong, var(--r-ink)) !important;
	}

	.r-home-intro__welcome {
		margin: 0.45rem 0 0;
		font-family: var(--r-font-body);
		font-size: 0.94rem;
		font-weight: 400;
		line-height: 1.8;
		color: var(--r-ink-soft);
		text-wrap: pretty;
	}

	.r-home-intro__about {
		display: inline-block;
		margin-inline-start: 0.45rem;
		font-family: var(--r-font-ui);
		font-size: var(--r-text-xs);
		color: var(--r-link) !important;
		border-bottom: 0 !important;
		text-decoration: underline;
		text-decoration-color: transparent;
		text-decoration-thickness: 1px;
		text-underline-offset: var(--r-link-underline-offset);
		transition: color 0.2s ease, text-decoration-color 0.2s ease;
	}

	.r-home-intro__about:hover {
		color: var(--r-link) !important;
		text-decoration-color: var(--r-link-underline-color);
	}

	.r-home-writing {
		margin-top: clamp(1.7rem, 3.8vw, 2.25rem);
		margin-bottom: 0;
	}

	.r-home-writing__head {
		padding-bottom: 0.7rem !important;
		margin-bottom: var(--space-md) !important;
		border-bottom: 1px solid var(--r-rule) !important;
	}

	.home-section-more {
		font-family: var(--r-font-ui);
		font-size: var(--r-text-xs);
		color: var(--r-link);
		border-bottom: 0;
		text-decoration: underline;
		text-decoration-color: transparent;
		text-decoration-thickness: 1px;
		text-underline-offset: var(--r-link-underline-offset);
		transition: color 0.2s ease, text-decoration-color 0.2s ease;
	}

	.home-section-more:hover {
		color: var(--r-link);
		text-decoration-color: var(--r-link-underline-color);
	}

	@media (max-width: 640px) {
		.r-home-cover {
			aspect-ratio: 16 / 8.5;
			max-height: 220px;
		}

		.r-home-body {
			padding: 1.25rem 1.05rem 1.35rem;
		}

		.r-home-intro__welcome {
			margin-top: 0.5rem;
			font-size: 0.91rem;
			line-height: 1.74;
		}

		.r-home-writing {
			margin-top: 1.45rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.r-home-intro__about,
		.home-section-more {
			transition: none;
		}
	}
</style>
