---
import { getCollection } from 'astro:content';
import ReadingShell from '../layouts/ReadingShell.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { filterDrafts } from '../utils/drafts';
import AboutTraits from '../components/AboutTraits.astro';

const posts = filterDrafts(await getCollection('blog'))
	.filter((post) => !post.id.startsWith('en/'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const latestPosts = posts.slice(0, 5);
const sectionTitleClass = 'r-section__title !m-0 ![font-family:var(--r-font-ui)] ![font-size:var(--r-text-sm)] !font-semibold !tracking-[0.03em] !text-[var(--r-ink)]';
const homeIntroClass = 'r-home-intro';
const homeIntroTextClass = 'r-home-intro__text !m-0 ![font-family:var(--r-font-body)] ![font-size:var(--r-text-lg)] !font-medium !leading-[var(--r-lh-tight)] !tracking-[-0.018em] !text-[var(--r-ink)]';

function getPostHref(post: (typeof posts)[number]) {
	return `/blog/${post.data.slug ?? post.id}.html`;
}
---

<ReadingShell title={SITE_TITLE} description={SITE_DESCRIPTION} className="reading-home">
	<section class={homeIntroClass} aria-label="简介">
		<h1 class={homeIntroTextClass}>你好，我是 Lynk。</h1>
		<AboutTraits />
	</section>

	<section class="r-section" aria-labelledby="home-writing-title">
		<header class="r-section__head">
			<h2 id="home-writing-title" class={sectionTitleClass}>最近文章</h2>
			<a class="home-section-more" href="/blog">全部文章</a>
		</header>

		<ol class="r-post-list">
			{latestPosts.map((post) => (
				<li class="r-post-list__item">
					<a href={getPostHref(post)} class="r-post-list__title">{post.data.title}</a>
					<span class="r-post-list__date">
						<FormattedDate date={post.data.pubDate} />
					</span>
				</li>
			))}
		</ol>
	</section>

</ReadingShell>

<style>
	/* 首页以文章为主体；标题和日期沿用非专题页的公共索引规则。 */
	.r-home-intro {
		--r-traits-gap: var(--space-sm);
		margin-bottom: var(--space-2xl);
	}

	.r-section { margin-bottom: 0; }

	.home-section-more {
		font-family: var(--r-font-ui);
		font-size: var(--r-text-xs);
		font-weight: 400;
		color: var(--r-link);
		white-space: nowrap;
	}

	@media (max-width: 640px) {
		.r-home-intro { margin-bottom: var(--space-xl); }
	}
</style>
