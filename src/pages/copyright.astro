---
import ReadingShell from '../layouts/ReadingShell.astro';

const rights = [
	{ label: '共享', desc: '你可以自由复制、分享本站内容' },
	{ label: '改编', desc: '你可以基于本站内容进行二次创作' },
	{ label: '署名', desc: '转载或改编时必须注明作者及来源' },
	{ label: '非商业', desc: '不得将内容用于商业用途' },
];
const sectionTitleClass = 'r-section__title !m-0 ![font-family:var(--r-font-ui)] ![font-size:var(--r-text-sm)] !font-semibold !tracking-[0.03em] !text-[var(--r-ink-soft)]';
const pageTitleClass = 'r-page-title !m-0 !mb-[var(--r-space-lg)] ![font-family:var(--r-font-body)] ![font-size:var(--r-text-page)] !font-semibold !leading-[var(--r-lh-tight)] !tracking-[-0.018em] !text-[var(--r-ink)]';
const rightsListClass = 'r-copyright__list m-0 flex list-none flex-col gap-[0.75rem] p-0';
const rightsItemClass = 'grid gap-[0.2rem]';
const rightsLabelClass = 'font-semibold text-[var(--r-ink)]';
const rightsDescClass = '[font-size:var(--r-text-sm)] text-[var(--r-ink-soft)]';
const copyrightNoteClass = 'r-copyright__note mt-[var(--r-space-xl)] [font-family:var(--r-font-ui)] [font-size:var(--r-text-xs)] leading-[1.7] text-[var(--r-ink-faint)]';
const copyrightNoteLinkClass = 'border-b-0 text-[var(--r-ink-soft)] underline decoration-transparent decoration-1 underline-offset-[var(--r-link-underline-offset)] transition-[color,text-decoration-color] duration-200 hover:text-[var(--r-link)] hover:decoration-[var(--r-link-underline-color)]';
---

<ReadingShell title="Copyright" description="Copyright and license information for lynkxu.github.io.">
	<article class="r-copyright">
		<h1 class={pageTitleClass}>CC BY-NC 4.0</h1>
		<p class="r-prose">
			本站内容采用
			<a href="https://creativecommons.org/licenses/by-nc/4.0/" target="_blank" rel="noopener noreferrer">
				知识共享署名-非商业性使用 4.0 国际许可协议
			</a>
			进行许可。
		</p>

		<section class="r-section" aria-labelledby="rights-title">
			<h2 id="rights-title" class={sectionTitleClass}>你可以做什么</h2>
			<ul class={rightsListClass}>
				{rights.map((item) => (
					<li class={rightsItemClass}>
						<strong class={rightsLabelClass}>{item.label}</strong>
						<span class={rightsDescClass}>{item.desc}</span>
					</li>
				))}
			</ul>
		</section>

		<p class={copyrightNoteClass}>
			<a
				href="https://creativecommons.org/licenses/by-nc/4.0/"
				target="_blank"
				rel="noopener noreferrer"
				class={copyrightNoteLinkClass}
			>
				查看完整协议
			</a>
			<br />
			© 2020 – {new Date().getFullYear()} LynkXu. All rights reserved.
		</p>
	</article>
</ReadingShell>
