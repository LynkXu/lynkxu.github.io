---
import Base from '../layouts/Base.astro';
import SimpleHeader from '../components/SimpleHeader.astro';
import MediaCard from '../components/MediaCard.astro';
import neodbData from '../data/neodb.json';
import {
  formatRecordedMonth,
  getAlternateTitle,
  getMediaStatusLabel,
  getPreferredTitle,
  toFilledStars,
} from '../lib/media-filter';

const title = '书影音';
const description = '书影音';

interface LocalizedTitle {
  lang?: string;
  text?: string;
}

interface NeoDBItem {
  uuid?: string;
  item: {
    title: string;
    display_title?: string;
    cover_image_url?: string | null;
    brief?: string | null;
    rating?: number | null;
    url?: string | null;
    localized_title?: LocalizedTitle[];
  };
  comment_text?: string | null;
  rating_grade?: number | null;
  created_time: string;
  shelf_type?: string;
  publication_year?: string | null;
}

type MediaKind = 'book' | 'tv' | 'movie' | 'game';

const mediaKinds: Array<{ key: 'all' | MediaKind; label: string }> = [
  { key: 'all', label: '全部' },
  { key: 'book', label: '书籍' },
  { key: 'movie', label: '电影' },
  { key: 'tv', label: '剧集' },
  { key: 'game', label: '游戏' },
];

const kindLabels: Record<MediaKind, string> = {
  book: '书籍',
  movie: '电影',
  tv: '剧集',
  game: '游戏',
};

const getTimestamp = (value?: string) => {
  const time = value ? new Date(value).getTime() : 0;
  return Number.isFinite(time) ? time : 0;
};

const records = (Object.keys(kindLabels) as MediaKind[])
  .flatMap((kind) => ((neodbData[kind] || []) as NeoDBItem[]).map((record) => ({ kind, record })))
  .sort((a, b) => getTimestamp(b.record.created_time) - getTimestamp(a.record.created_time));

const recordsByYear = records.reduce((groups, entry) => {
  const parsedYear = new Date(entry.record.created_time).getUTCFullYear();
  const year = Number.isFinite(parsedYear) ? String(parsedYear) : '未知';
  (groups[year] ||= []).push(entry);
  return groups;
}, {} as Record<string, typeof records>);

const sortedYears = Object.keys(recordsByYear).sort((a, b) => Number(b) - Number(a));
const getTitle = (entry: NeoDBItem) =>
  getPreferredTitle(
    entry.item.localized_title,
    entry.item.title,
    entry.item.display_title,
  );
const getSubtitle = (entry: NeoDBItem, preferredTitle: string) =>
  getAlternateTitle(entry.item.localized_title, preferredTitle);
const getCover = (entry: NeoDBItem) => entry.item.cover_image_url || '';
const getLink = (entry: NeoDBItem) => {
  const url = entry.item.url;
  if (!url) return 'https://neodb.social';
  return url.startsWith('http') ? url : `https://neodb.social${url}`;
};
---

<Base title={title} description={description} useCard={false} hideHeader fullWidth className="media-layout">
  <div class="media-page" data-media-page>
    <SimpleHeader title="Media" />

    <main class="media-main">
      <div class="media-heading">
        <h1>书影音</h1>
        <div class="media-filters" role="toolbar" aria-label="按类型筛选">
          {mediaKinds.map((kind) => (
            <button
              type="button"
              class="media-filter"
              data-media-filter={kind.key}
              aria-pressed={kind.key === 'all' ? 'true' : 'false'}
            >
              {kind.label}
            </button>
          ))}
        </div>
      </div>

      <div class="media-years" aria-live="polite">
        {sortedYears.map((year) => (
          <section class="media-year" data-media-year aria-labelledby={`media-year-${year}`}>
            <div class="year-heading">
              <h2 id={`media-year-${year}`}>{year}</h2>
              <span data-media-year-count data-total={recordsByYear[year].length}>
                {recordsByYear[year].length} 条记录
              </span>
            </div>
            <div class="media-grid">
              {recordsByYear[year].map(({ kind, record }) => {
                const itemTitle = getTitle(record);
                return (
                  <div data-media-item={kind}>
                    <MediaCard
                      title={itemTitle}
                      subtitle={getSubtitle(record, itemTitle)}
                      cover={getCover(record)}
                      comment={record.comment_text}
                      recordedDate={formatRecordedMonth(record.created_time)}
                      year={record.publication_year}
                      link={getLink(record)}
                      statusLabel={getMediaStatusLabel(kind, record.shelf_type)}
                      kind={kindLabels[kind]}
                      stars={toFilledStars(record.rating_grade)}
                    />
                  </div>
                );
              })}
            </div>
          </section>
        ))}
      </div>
    </main>
  </div>

  <style>
    :global(body.full-width .global-layout-transparent.media-layout) {
      width: 100%;
      max-width: var(--topic-shell-width);
      margin-inline: auto;
      padding: 0;
    }

    :global(.media-layout > main) {
      width: 100%;
    }

    .media-page {
      min-height: 100vh;
      background: var(--page-bg);
    }

    .media-page :global(.simple-header) {
      width: 100%;
      max-width: none;
      padding-inline: var(--page-inline);
    }

    .media-main {
      width: 100%;
      margin-inline: auto;
      padding: 0 var(--page-inline) var(--space-3xl);
    }

    .media-heading {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: var(--space-xl);
      margin: 0 0 var(--space-lg);
      padding-bottom: var(--space-md);
      border-bottom: 1px solid var(--paper-card-border-soft);
    }

    .media-heading h1,
    .year-heading h2 {
      margin: 0;
      color: var(--heading-color);
      font-family: var(--serif-font);
      font-weight: var(--weight-bold);
    }

    .media-heading h1 {
      display: block;
      font-size: var(--text-2xl);
      line-height: var(--lh-tight);
      letter-spacing: var(--tracking-tight);
      text-align: left;
    }

    .media-filters {
      display: flex;
      align-items: center;
      gap: var(--space-xs);
      overflow-x: auto;
      scrollbar-width: none;
    }

    .media-filters::-webkit-scrollbar {
      display: none;
    }

    .media-filter {
      appearance: none;
      padding: 0.28rem 0.7rem;
      border: 0;
      border-radius: 999px;
      background: transparent;
      color: var(--gray-color);
      cursor: pointer;
      font-family: var(--ui-font);
      font-size: var(--text-sm);
      font-weight: var(--weight-semibold);
      line-height: 1.2;
      white-space: nowrap;
      transition: color 0.2s ease, background 0.2s ease;
    }

    .media-filter:hover {
      color: var(--heading-color);
    }

    .media-filter[aria-pressed='true'] {
      background: var(--heading-color);
      color: var(--page-bg);
    }

    .media-filter:focus-visible {
      outline: 2px solid color-mix(in oklab, var(--accent-color) 72%, transparent);
      outline-offset: 3px;
    }

    .media-years {
      display: flex;
      flex-direction: column;
      gap: var(--space-xl);
      margin-top: 0;
    }

    .media-year[hidden],
    :global([data-media-item][hidden]) {
      display: none;
    }

    .year-heading {
      display: flex;
      align-items: baseline;
      gap: var(--space-sm);
      margin: 0 0 var(--space-sm);
    }

    .year-heading h2 {
      font-size: var(--text-lg);
      font-variant-numeric: tabular-nums;
      line-height: var(--lh-tight);
    }

    .year-heading span {
      color: var(--gray-color);
      font-family: var(--ui-font);
      font-size: var(--text-xs);
    }

    .media-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-lg) var(--space-xl);
      padding-top: var(--space-md);
      border-top: 1px solid var(--paper-card-border-soft);
    }

    @media (max-width: 760px) {
      .media-heading {
        align-items: flex-start;
        flex-direction: column;
        gap: var(--space-sm);
      }

      .media-filters {
        width: 100%;
      }

      .media-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    @media (max-width: 520px) {
      .media-grid {
        grid-template-columns: 1fr;
        gap: var(--space-md);
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .media-filter {
        transition: none;
      }
    }
  </style>
</Base>

<script>
  import { matchesMediaFilter } from '../lib/media-filter';

  const page = document.querySelector<HTMLElement>('[data-media-page]');
  if (page) {
    const filters = Array.from(page.querySelectorAll<HTMLButtonElement>('[data-media-filter]'));
    const items = Array.from(page.querySelectorAll<HTMLElement>('[data-media-item]'));
    const years = Array.from(page.querySelectorAll<HTMLElement>('[data-media-year]'));

    const applyFilter = (activeKind: string) => {
      items.forEach((item) => {
        item.hidden = !matchesMediaFilter(item.dataset.mediaItem || '', activeKind);
      });
      years.forEach((year) => {
        const visibleItems = Array.from(year.querySelectorAll<HTMLElement>('[data-media-item]'))
          .filter((item) => !item.hidden);
        year.hidden = visibleItems.length === 0;
        const count = year.querySelector<HTMLElement>('[data-media-year-count]');
        if (count) count.textContent = `${visibleItems.length} 条记录`;
      });
    };

    filters.forEach((filter) => {
      filter.addEventListener('click', () => {
        filters.forEach((candidate) => {
          candidate.setAttribute('aria-pressed', String(candidate === filter));
        });
        applyFilter(filter.dataset.mediaFilter || 'all');
      });
    });
  }
</script>
