---
import { getCollection } from 'astro:content';
import ReadingShell from '../../layouts/ReadingShell.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { INCLUDE_DRAFTS, filterDrafts } from '../../utils/drafts';

export async function getStaticPaths() {
	const allPosts = filterDrafts(await getCollection('blog'));
	const tags = new Set<string>();

	allPosts.forEach((post) => {
		if (post.data.tags) {
			post.data.tags.forEach((tag) => tags.add(tag));
		}
	});

	return Array.from(tags).map((tag) => {
		const filteredPosts = allPosts
			.filter((post) => post.data.tags && post.data.tags.includes(tag))
			.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

		return {
			params: { tag },
			props: { posts: filteredPosts, tag },
		};
	});
}

const { posts, tag } = Astro.props;
const pageTitleClass = 'r-page-title !m-0 !mb-[var(--r-space-lg)] ![font-family:var(--r-font-body)] ![font-size:var(--r-text-page)] !font-semibold !leading-[var(--r-lh-tight)] !tracking-[-0.018em] !text-[var(--r-ink)]';
const tagMetaClass = 'r-tag-meta mt-[-0.75rem] mb-[var(--r-space-lg)] flex flex-wrap gap-x-[1rem] gap-y-[0.5rem] [font-family:var(--r-font-ui)] [font-size:var(--r-text-xs)] text-[var(--r-ink-faint)]';
const tagMetaLinkClass = 'border-b-0 text-[var(--r-ink-soft)] underline decoration-transparent decoration-1 underline-offset-[var(--r-link-underline-offset)] transition-[color,text-decoration-color] duration-200 hover:text-[var(--r-link)] hover:decoration-[var(--r-link-underline-color)]';
---

<ReadingShell title={`标签：${tag}`} description={`带有「${tag}」标签的全部文章`}>
	<h1 class={pageTitleClass}>{tag}</h1>

	<p class={tagMetaClass}>
		<span>{posts.length} 篇文章</span>
		<a href="/tags" class={tagMetaLinkClass}>← 全部标签</a>
	</p>

	<ol class="r-post-list">
		{posts.map((post) => (
			<li class="r-post-list__item">
				<div class="r-post-list__main">
					<a
						href={`/blog/${post.data.slug ?? post.id}.html`}
						class="r-post-list__title"
						transition:name={`post-title-${post.id}`}
					>
						{post.data.title}
					</a>
					{INCLUDE_DRAFTS && post.data.draft && <span class="r-draft">草稿</span>}
				</div>
				<span class="r-post-list__date">
					<FormattedDate date={post.data.pubDate} />
				</span>
			</li>
		))}
	</ol>
</ReadingShell>
