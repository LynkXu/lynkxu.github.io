---
import Base from '../layouts/Base.astro';
import SimpleHeader from '../components/SimpleHeader.astro';
import { getCollection } from 'astro:content';
import { travelPlaces, type TravelPlace } from '../data/travel-places';
import { getTravelArticleHref, groupTravelArticlesByPlace } from '../lib/travel-articles';
import { getPlaceMonth } from '../lib/travel-map-state';
import { filterDrafts } from '../utils/drafts';

const getDateValue = (date: string) => {
  const match = date.match(/\d{4}([-.]\d{2})?/);
  return match ? match[0].replace('.', '-') : '';
};

const visitedPlaces = travelPlaces
  .filter((place) => !place.status)
  .sort((a, b) => getDateValue(b.date).localeCompare(getDateValue(a.date)));

const placesByYear = visitedPlaces.reduce((groups, place) => {
  const year = place.date.match(/\d{4}/)?.[0] || '其他';
  (groups[year] ||= []).push(place);
  return groups;
}, {} as Record<string, TravelPlace[]>);

const sortedYears = Object.keys(placesByYear).sort((a, b) => b.localeCompare(a));
const travelArticlesByPlace = groupTravelArticlesByPlace(filterDrafts(await getCollection('blog')));
const placesWithArticles = travelPlaces.filter((place) => travelArticlesByPlace[place.id]?.length);
const mapPlaces = travelPlaces.map((place) => ({
  ...place,
  articleCount: travelArticlesByPlace[place.id]?.length ?? 0,
}));

const getArticleDate = (date: Date) => {
  const month = String(date.getMonth() + 1).padStart(2, '0');
  const day = String(date.getDate()).padStart(2, '0');
  return `${date.getFullYear()}.${month}.${day}`;
};

const title = '旅行足迹';
const description = '旅行足迹';
---

<Base title={title} description={description} fullWidth hideHeader useCard={false} className="travel-layout">
  <link rel="dns-prefetch" href="https://unpkg.com" slot="head" />
  <link rel="preconnect" href="https://unpkg.com" crossorigin="" slot="head" />
  <link rel="preconnect" href="https://geo.datav.aliyun.com" crossorigin="" slot="head" />
  <link
    rel="stylesheet"
    href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
    integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
    crossorigin=""
    slot="head"
  />
  <script
    is:inline
    src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
    integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
    crossorigin=""
    defer
    slot="head"
  ></script>

  <div class="travel-page">
    <SimpleHeader title="Travel" />

    <main class="travel-main">
      <div class="page-heading">
        <h1>旅行足迹</h1>
      </div>

      <section class="travel-stage">
        <section class="map-section" aria-label="旅行地图">
          <div class="map-frame">
            <div
              id="travel-map"
              data-places={JSON.stringify(mapPlaces)}
              aria-label="可交互的旅行足迹地图"
            ></div>
            <div class="map-state">
              <p id="travel-map-selection" class="sr-only" aria-live="polite">世界</p>
              <button id="travel-map-reset" type="button" hidden>
                <svg viewBox="0 0 24 24" width="13" height="13" aria-hidden="true" focusable="false">
                  <circle cx="12" cy="12" r="8" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
                  <ellipse cx="12" cy="12" rx="3.2" ry="8" fill="none" stroke="currentColor" stroke-width="1.5"></ellipse>
                  <path d="M4 12h16M6.2 7.5h11.6M6.2 16.5h11.6" fill="none" stroke="currentColor" stroke-width="1.5"></path>
                </svg>
                返回世界
              </button>
              <button id="travel-map-related" type="button" hidden>
                <span>查看旅行记录</span>
                <span aria-hidden="true">↓</span>
              </button>
            </div>
          </div>
        </section>

        {placesWithArticles.length > 0 && (
          <section id="travel-related" class="travel-related" aria-live="polite" hidden>
            {placesWithArticles.map((place) => {
              const articles = travelArticlesByPlace[place.id];
              return (
                <div class="related-place" data-related-place={place.id} hidden>
                  <div class="related-heading">
                    <h2>{place.name}旅行记录</h2>
                    <p class="related-meta">{articles.length} 篇</p>
                  </div>
                  <ol class="related-list">
                    {articles.map((article) => (
                      <li>
                        <a href={getTravelArticleHref(article)}>{article.data.title}</a>
                        <time datetime={article.data.pubDate.toISOString()}>{getArticleDate(article.data.pubDate)}</time>
                      </li>
                    ))}
                  </ol>
                </div>
              );
            })}
          </section>
        )}
      </section>

      <section class="travel-archive" aria-labelledby="travel-archive-title">
        <div class="archive-heading">
          <h2 id="travel-archive-title">城市与日期</h2>
        </div>

        <div class="year-grid">
          {sortedYears.map((year) => (
            <section class="year-group" aria-labelledby={`travel-year-${year}`}>
              <h3 id={`travel-year-${year}`}>{year}</h3>
              <div class="place-list">
                {placesByYear[year].map((place) => {
                  const placeIndex = travelPlaces.indexOf(place);
                  return (
                    <button
                      class="place-row"
                      type="button"
                      data-place-index={placeIndex}
                      data-place-name={place.name}
                    >
                      <span class="place-date">{getPlaceMonth(place.date, year)}</span>
                      <strong>{place.name}</strong>
                      {place.location && <span class="place-location">{place.location}</span>}
                      <span class="place-arrow" aria-hidden="true">→</span>
                    </button>
                  );
                })}
              </div>
            </section>
          ))}
        </div>
      </section>
    </main>
  </div>

  <style>
    :global(body.full-width .global-layout-transparent.travel-layout) {
      width: 100%;
      max-width: var(--topic-shell-width);
      margin-inline: auto;
      padding: 0;
    }

    :global(.travel-layout > main) {
      width: 100%;
    }

    .travel-page {
      min-height: 100vh;
      background: var(--page-bg);
    }

    .travel-page :global(.simple-header) {
      width: 100%;
      max-width: none;
      padding-inline: var(--page-inline);
    }

    .travel-main {
      width: 100%;
      margin-inline: auto;
      padding: 0 var(--page-inline) var(--space-3xl);
    }

    .page-heading {
      margin: 0 0 var(--space-lg);
    }

    .page-heading h1,
    .archive-heading h2,
    .related-heading h2,
    .year-group h3 {
      color: var(--heading-color);
      font-family: var(--serif-font);
      font-weight: var(--weight-bold);
    }

    .page-heading h1 {
      display: block;
      margin: 0;
      font-size: var(--text-2xl);
      line-height: var(--lh-tight);
      letter-spacing: var(--tracking-tight);
      text-align: left;
    }

    .travel-stage {
      display: grid;
      gap: var(--space-sm);
    }

    .map-frame {
      position: relative;
      overflow: hidden;
      border: 1px solid var(--paper-card-border);
      border-radius: var(--paper-card-radius);
      background: var(--paper-card-bg);
    }

    #travel-map {
      width: 100%;
      height: clamp(320px, 38vw, 460px);
      background: color-mix(in oklab, var(--accent-color) 4%, var(--content-bg));
      z-index: 1;
    }

    .map-state {
      position: absolute;
      z-index: 500;
      top: var(--space-sm);
      right: var(--space-sm);
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      gap: var(--space-xs);
      max-width: calc(100% - 5rem);
    }

    .sr-only {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }

    #travel-map-reset,
    #travel-map-related {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      appearance: none;
      padding: 0.34rem 0.62rem;
      border: 1px solid var(--paper-card-border);
      border-radius: var(--paper-card-radius);
      background: color-mix(in oklab, var(--content-bg) 94%, transparent);
      box-shadow: 0 1px 2px rgba(15, 23, 42, 0.05);
      backdrop-filter: blur(12px);
      color: var(--text-color);
      cursor: pointer;
      font: inherit;
      font-family: var(--ui-font);
      font-size: var(--text-xs);
      font-weight: var(--weight-semibold);
      line-height: 1;
      transition: color 0.2s ease, border-color 0.2s ease, background 0.2s ease;
    }

    #travel-map-related {
      background: color-mix(in oklab, var(--accent-soft-bg) 72%, var(--content-bg));
      color: var(--heading-color);
    }

    #travel-map-reset[hidden],
    #travel-map-related[hidden] {
      display: none;
    }

    #travel-map-reset:hover,
    #travel-map-related:hover {
      border-color: var(--paper-hover-border);
      background: var(--paper-hover-bg);
      color: var(--link-color);
    }

    #travel-map-reset:focus-visible,
    #travel-map-related:focus-visible,
    .place-row:focus-visible {
      outline: 2px solid color-mix(in oklab, var(--accent-color) 72%, transparent);
      outline-offset: 3px;
    }

    .travel-archive {
      margin-top: var(--space-xl);
    }

    .travel-related {
      padding-top: var(--space-md);
      border-block: 1px solid var(--paper-card-border);
    }

    .travel-related[hidden],
    .related-place[hidden] {
      display: none;
    }

    .related-heading {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      justify-content: space-between;
      gap: var(--space-xs) var(--space-md);
      margin-bottom: var(--space-xs);
    }

    .related-heading h2 {
      margin: 0;
      font-size: var(--text-lg);
      line-height: var(--lh-tight);
    }

    .related-meta {
      margin: 0;
      color: var(--gray-color);
      font-family: var(--ui-font);
      font-size: var(--text-xs);
      line-height: 1.4;
    }

    .related-list {
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .related-list li {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: baseline;
      gap: var(--space-md);
      padding-block: var(--space-sm);
      border-top: 1px solid var(--paper-card-border-soft);
    }

    .related-list a {
      color: var(--heading-color);
      font-family: var(--serif-font);
      font-size: var(--text-md);
      font-weight: var(--weight-semibold);
      line-height: calc(var(--lh-tight) + 0.08);
      text-decoration: none;
      transition: color 0.2s ease;
    }

    .related-list a:hover {
      color: var(--link-color);
    }

    .related-list a:focus-visible {
      border-radius: 2px;
      outline: 2px solid color-mix(in oklab, var(--accent-color) 72%, transparent);
      outline-offset: 3px;
    }

    .related-list time {
      color: var(--gray-color);
      font-family: var(--code-font);
      font-size: 0.7rem;
      font-variant-numeric: tabular-nums;
    }

    .archive-heading {
      margin-bottom: var(--space-lg);
      padding-bottom: var(--space-sm);
      border-bottom: 1px solid var(--paper-card-border-soft);
    }

    .archive-heading h2 {
      display: block;
      margin: 0;
      font-size: var(--text-lg);
      line-height: var(--lh-tight);
      text-align: left;
    }

    .year-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-2xl);
      margin-top: 0;
    }

    .year-group {
      min-width: 0;
    }

    .year-group h3 {
      margin: 0 0 var(--space-xs);
      font-size: var(--text-md);
      font-variant-numeric: tabular-nums;
      line-height: var(--lh-tight);
    }

    .place-list {
      border-top: 1px solid var(--paper-card-border-soft);
    }

    .place-row {
      display: grid;
      grid-template-columns: 2.1rem minmax(0, auto) minmax(0, 1fr) auto;
      align-items: baseline;
      width: 100%;
      min-height: 2.35rem;
      padding: var(--space-xs) 0;
      border: 0;
      border-bottom: 1px solid var(--paper-card-border-soft);
      border-radius: 0;
      background: transparent;
      color: var(--text-color);
      cursor: pointer;
      font-family: var(--ui-font);
      text-align: left;
      transition: color 0.2s ease;
    }

    .place-row:hover,
    .place-row[aria-current='true'] {
      color: var(--link-color);
    }

    .place-date,
    .place-location {
      color: var(--gray-color);
      font-family: var(--code-font);
      font-size: 0.7rem;
      font-variant-numeric: tabular-nums;
    }

    .place-row strong {
      overflow: hidden;
      margin-right: var(--space-xs);
      color: var(--heading-color);
      font-family: var(--serif-font);
      font-size: 0.92rem;
      font-weight: var(--weight-semibold);
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .place-location {
      overflow: hidden;
      min-width: 0;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .place-arrow {
      color: var(--faint-color);
      font-size: var(--text-sm);
      transition: transform 0.2s ease, color 0.2s ease;
    }

    .place-row:hover .place-arrow,
    .place-row[aria-current='true'] .place-arrow {
      color: var(--link-color);
      transform: translateX(2px);
    }

    .place-row:hover strong,
    .place-row[aria-current='true'] strong {
      color: var(--link-color);
    }

    :global(.leaflet-container) {
      font-family: var(--ui-font);
      background: color-mix(in oklab, var(--accent-color) 4%, var(--content-bg));
    }

    :global(.leaflet-bar) {
      overflow: hidden;
      border: 1px solid var(--paper-card-border);
      border-radius: var(--paper-card-radius);
      box-shadow: 0 1px 2px rgba(15, 23, 42, 0.05);
    }

    :global(.leaflet-bar a),
    :global(.leaflet-bar a:hover) {
      width: 28px;
      height: 28px;
      border-bottom: 1px solid var(--paper-card-border);
      background: color-mix(in oklab, var(--content-bg) 94%, transparent);
      color: var(--heading-color);
      line-height: 28px;
    }

    :global(.leaflet-control-attribution) {
      background: color-mix(in oklab, var(--content-bg) 88%, transparent);
      color: var(--gray-color);
      font-family: var(--ui-font);
    }

    :global(.leaflet-bar a:last-child) {
      border-bottom: 0;
    }

    :global(.leaflet-control-scale) {
      margin-left: var(--space-sm);
      margin-bottom: var(--space-sm);
    }

    :global(.leaflet-control-scale-line) {
      border-color: var(--paper-card-border);
      background: color-mix(in oklab, var(--content-bg) 88%, transparent);
      color: var(--gray-color);
      font-family: var(--ui-font);
      font-size: 0.62rem;
    }

    :global(.leaflet-tooltip.travel-map-tip) {
      padding: 0.32rem 0.56rem;
      border: 1px solid var(--paper-card-border);
      border-radius: var(--paper-card-radius);
      background: color-mix(in oklab, var(--content-bg) 96%, transparent);
      box-shadow: 0 1px 2px rgba(15, 23, 42, 0.05);
      color: var(--heading-color);
      font-family: var(--ui-font);
      font-size: var(--text-xs);
      font-weight: var(--weight-semibold);
      white-space: nowrap;
    }

    :global(.leaflet-tooltip.travel-map-tip::before) {
      border-top-color: var(--content-bg);
    }

    :global([data-theme='dark'] .leaflet-tile-pane) {
      filter: brightness(0.72) saturate(0.65) contrast(1.06);
    }

    :global([data-theme='dark'] .leaflet-bar a),
    :global([data-theme='dark'] .leaflet-bar a:hover) {
      background: color-mix(in oklab, var(--content-bg) 92%, transparent);
      color: var(--heading-color);
    }

    :global([data-theme='dark'] .leaflet-control-attribution) {
      background: color-mix(in oklab, var(--content-bg) 82%, transparent);
    }

    @media (max-width: 900px) {
      .year-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: var(--space-xl);
      }
    }

    @media (max-width: 640px) {
      .page-heading {
        margin-bottom: var(--space-md);
      }

      #travel-map {
        height: 280px;
      }

      .map-state {
        right: var(--space-xs);
        top: var(--space-xs);
      }

      .year-grid {
        grid-template-columns: 1fr;
        gap: var(--space-lg);
      }
    }

    @media (prefers-reduced-motion: reduce) {
      #travel-map-reset,
      #travel-map-related,
      .place-row,
      .place-arrow,
      .related-list a {
        transition: none;
      }
    }
  </style>
</Base>

  <script>
    import {
      CITY_FOCUS_MAX_ZOOM,
      gcj02GeoJSONToWgs84,
      getBoundaryUrl,
      getFittedLng,
      getSelectionLabel,
      isBoundaryVisible,
    } from '../lib/travel-map-state';

    type ClientPlace = {
      id: string;
      name: string;
      lat: number;
      lng: number;
      date: string;
      status?: 'living' | 'hometown';
      country?: string;
      adminCode?: string;
      location?: string;
      articleCount?: number;
    };

    const initializeTravelMap = () => {
      const Leaflet = (window as typeof window & { L?: any }).L;
      const container = document.querySelector<HTMLElement>('#travel-map');
      if (!Leaflet || !container || (container as HTMLElement & { _leaflet_id?: number })._leaflet_id) return;

      let places: ClientPlace[] = [];
      try {
        places = JSON.parse(container.dataset.places || '[]');
      } catch {
        return;
      }

      const selection = document.querySelector<HTMLElement>('#travel-map-selection');
      const resetButton = document.querySelector<HTMLButtonElement>('#travel-map-reset');
      const relatedButton = document.querySelector<HTMLButtonElement>('#travel-map-related');
      const placeButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-place-index]'));
      const travelStage = document.querySelector<HTMLElement>('.travel-stage');
      const relatedSection = document.querySelector<HTMLElement>('#travel-related');
      const relatedPlaces = Array.from(document.querySelectorAll<HTMLElement>('[data-related-place]'));
      const accent = getComputedStyle(document.documentElement).getPropertyValue('--accent-color').trim() || '#58715f';
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const map = Leaflet.map(container, {
        scrollWheelZoom: true,
        wheelPxPerZoomLevel: 80,
        worldCopyJump: true,
        zoomControl: true,
        attributionControl: true,
      });

      Leaflet.tileLayer('https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png?key=cb1_2xmb_1_d1f716b1071e92bec7091f43', {
        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> &copy; <a href="https://carto.com/attributions">CARTO</a>',
        maxZoom: 19,
      }).addTo(map);
      Leaflet.control.scale({ imperial: false, maxWidth: 96 }).addTo(map);

      let activeBoundary: any = null;
      let activePlaceIndex: number | null = null;
      const boundaryCache = new Map<string, unknown>();

      const lngs = places.map((place) => place.lng);
      const browseTipOptions = {
        direction: 'top',
        offset: [0, -8],
        className: 'travel-map-tip',
        opacity: 1,
      };
      const bindBrowseTip = (marker: any, place: ClientPlace) => {
        const articleCount = place.articleCount ?? 0;
        if (articleCount < 1) return;
        marker.bindTooltip(`${place.name} · ${articleCount} 篇`, browseTipOptions);
      };
      const markers = places.map((place, index) => {
        const isHome = place.status === 'living' || place.status === 'hometown';
        const hasArticles = (place.articleCount ?? 0) > 0;
        const marker = Leaflet.circleMarker([place.lat, getFittedLng(place.lng, lngs)], {
          radius: isHome ? 6 : hasArticles ? 5.2 : 4.5,
          color: accent,
          weight: isHome ? 2 : hasArticles ? 1.7 : 1.4,
          opacity: 0.9,
          fillColor: accent,
          fillOpacity: isHome ? 0.38 : hasArticles ? 0.32 : 0.22,
        }).addTo(map);
        bindBrowseTip(marker, place);
        marker.on('click', () => void selectPlace(index));
        return marker;
      });

      const worldBounds = Leaflet.latLngBounds(
        places.map((place) => [place.lat, getFittedLng(place.lng, lngs)]),
      );
      let viewAnimation = 0;

      const motionOptions = (animate = true) => ({
        animate: animate && !reduceMotion,
        duration: animate && !reduceMotion ? 0.65 : 0,
      });

      const beginViewAnimation = () => {
        viewAnimation += 1;
        const token = viewAnimation;
        map.once('moveend', () => {
          if (viewAnimation === token) viewAnimation = 0;
        });
      };

      const fitWorld = (animate = false) => {
        if (!worldBounds.isValid()) return;
        map.stop();
        map.invalidateSize();
        beginViewAnimation();
        map.fitBounds(worldBounds, { ...motionOptions(animate), maxZoom: 4.2, padding: [28, 36] });
      };

      const removeBoundary = () => {
        if (activeBoundary && map.hasLayer(activeBoundary)) map.removeLayer(activeBoundary);
      };

      const clearSelectionTip = () => {
        markers.forEach((marker, index) => {
          marker.unbindTooltip();
          bindBrowseTip(marker, places[index]);
        });
      };

      const showRelatedArticles = (placeId?: string) => {
        const active = relatedPlaces.find((group) => group.dataset.relatedPlace === placeId);
        relatedPlaces.forEach((group) => {
          group.hidden = group !== active;
        });
        if (relatedSection) relatedSection.hidden = !active;
        if (relatedButton) {
          const articleCount = places.find((place) => place.id === placeId)?.articleCount ?? 0;
          relatedButton.hidden = !active;
          relatedButton.firstElementChild!.textContent = `查看 ${articleCount} 篇旅行记录`;
        }
      };

      const showSelectionTip = (index: number) => {
        const place = places[index];
        clearSelectionTip();
        markers[index]?.unbindTooltip().bindTooltip(getSelectionLabel(place.name, place.date, place.articleCount), {
          permanent: true,
          direction: 'top',
          offset: [0, -10],
          className: 'travel-map-tip',
          opacity: 1,
        }).openTooltip();
      };

      const focusMarker = (index: number) => {
        const place = places[index];
        map.stop();
        map.invalidateSize();
        beginViewAnimation();
        map.flyTo([place.lat, getFittedLng(place.lng, lngs)], CITY_FOCUS_MAX_ZOOM, motionOptions(true));
        showSelectionTip(index);
      };

      const showBoundaryView = (index: number) => {
        if (!activeBoundary) {
          focusMarker(index);
          return;
        }
        const bounds = activeBoundary.getBounds();
        if (!bounds.isValid()) {
          focusMarker(index);
          return;
        }

        map.stop();
        map.invalidateSize();
        const fittedZoom = map.getBoundsZoom(bounds, false, Leaflet.point(28, 36));
        if (fittedZoom < CITY_FOCUS_MAX_ZOOM) {
          focusMarker(index);
          return;
        }
        beginViewAnimation();
        map.fitBounds(bounds, {
          ...motionOptions(true),
          padding: [28, 36],
          maxZoom: CITY_FOCUS_MAX_ZOOM,
        });
      };

      async function selectPlace(index: number) {
        const place = places[index];
        if (!place) return;

        activePlaceIndex = index;
        removeBoundary();
        activeBoundary = null;
        if (selection) selection.textContent = getSelectionLabel(place.name, place.date, place.articleCount);
        if (resetButton) resetButton.hidden = false;
        showRelatedArticles(place.id);
        showSelectionTip(index);
        placeButtons.forEach((button) => {
          if (Number(button.dataset.placeIndex) === index) {
            button.setAttribute('aria-current', 'true');
          } else {
            button.removeAttribute('aria-current');
          }
        });

        const boundaryUrl = getBoundaryUrl(place.adminCode);
        if (!boundaryUrl || !place.adminCode) {
          focusMarker(index);
          return;
        }

        try {
          let geometry = boundaryCache.get(place.adminCode);
          if (!geometry) {
            const response = await fetch(boundaryUrl);
            if (!response.ok) throw new Error(`Boundary request failed: ${response.status}`);
            geometry = gcj02GeoJSONToWgs84(await response.json());
            boundaryCache.set(place.adminCode, geometry);
          }
          if (activePlaceIndex !== index) return;

          activeBoundary = Leaflet.geoJSON(geometry, {
            interactive: false,
            smoothFactor: 1.4,
            style: {
              color: accent,
              weight: 1.2,
              opacity: 0.72,
              fillColor: accent,
              fillOpacity: 0.1,
            },
          }).addTo(map);
          showBoundaryView(index);
        } catch {
          focusMarker(index);
        }
      }

      map.on('zoomend', () => {
        if (!activeBoundary || viewAnimation > 0) return;
        if (isBoundaryVisible(map.getZoom())) {
          if (!map.hasLayer(activeBoundary)) activeBoundary.addTo(map);
        } else {
          removeBoundary();
        }
      });

      resetButton?.addEventListener('click', () => {
        activePlaceIndex = null;
        removeBoundary();
        activeBoundary = null;
        clearSelectionTip();
        if (selection) selection.textContent = '世界';
        resetButton.hidden = true;
        showRelatedArticles();
        placeButtons.forEach((button) => button.removeAttribute('aria-current'));
        fitWorld(true);
      });

      relatedButton?.addEventListener('click', () => {
        relatedSection?.scrollIntoView({
          behavior: reduceMotion ? 'auto' : 'smooth',
          block: 'center',
        });
      });

      placeButtons.forEach((button) => {
        button.addEventListener('click', () => {
          const index = Number(button.dataset.placeIndex);
          if (!Number.isInteger(index)) return;
          void selectPlace(index);
          travelStage?.scrollIntoView({
            behavior: reduceMotion ? 'auto' : 'smooth',
            block: 'start',
          });
        });
      });

      window.addEventListener('resize', () => {
        map.invalidateSize();
        if (activePlaceIndex === null) fitWorld();
      });
      fitWorld();
      requestAnimationFrame(() => fitWorld());
    };

    const leafletScript = document.querySelector<HTMLScriptElement>('script[src*="leaflet.js"]');
    if ((window as typeof window & { L?: any }).L) {
      initializeTravelMap();
    } else {
      leafletScript?.addEventListener('load', initializeTravelMap, { once: true });
    }
  </script>
