---
const today = new Date();
const currentYear = today.getFullYear();
---

<footer class='group/footer'>
	<p class='copyright m-0 [font-family:var(--ui-font)] text-[0.68rem] font-light leading-[1.5] tracking-[0.01em] text-[var(--faint-color)] transition-colors duration-200 group-hover/footer:text-[var(--gray-color)]'>
		© 2020 – {currentYear} <a class='text-inherit' href='/'>LynkXu</a>
	</p>
</footer>

<style>
	footer {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		align-items: end;
		gap: 1rem;
		width: min(var(--blog-shell-width, 68rem), calc(100% - clamp(2rem, 6vw, 5.5rem)));
		margin: 0 auto;
		padding: clamp(1.1rem, 2vw, 1.45rem) 0 clamp(2rem, 4vw, 3rem);
		border-top: 1px solid var(--paper-card-border-soft);
	}

	:global(body:has(.blog-surface-layout)) footer {
		grid-template-columns: minmax(0, 1fr);
		width: 100%;
		margin-right: 0;
		margin-left: 0;
		margin-top: clamp(1.4rem, 4vw, 2.6rem);
		text-align: left;
	}

	:global(body:has(.blog-surface-layout)) footer::before {
		content: none !important;
	}

	:global(body:has(.blog-surface-layout) .ledger-main > footer > *) {
		grid-column: auto !important;
	}

	/* Fix for full-width layout pages */
	:global(body.full-width) footer {
		max-width: 1200px;
		margin: 0 auto;
		padding: var(--space-lg) var(--page-inline);
		box-sizing: border-box;
	}

	.copyright a {
		color: inherit;
	}

	@media (max-width: 480px) {
		footer {
			grid-template-columns: 1fr;
			align-items: start;
			gap: 0.4rem;
		}

		:global(body:has(.blog-surface-layout)) footer {
			grid-template-columns: 1fr;
		}
	}
</style>
