---
interface Props {
  title: string;
  description?: string;
  href?: string;
  className?: string;
}

const { title, description, className = '' } = Astro.props;
const hasActions = Astro.slots.has('actions');
---

<header
  class:list={[
    'simple-header',
    'r-page-head',
    { 'simple-header--with-actions': hasActions },
    className,
  ]}
>
  <div class="simple-header__main">
    <h1 class="r-page-title r-page-head__title">{title}</h1>
    {description && <p class="r-page-head__note">{description}</p>}
  </div>
  {hasActions && (
    <div class="simple-header__actions">
      <slot name="actions" />
    </div>
  )}
</header>

<style>
  .simple-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-md) var(--space-xl);
    width: 100%;
    box-sizing: border-box;
  }

  .simple-header__main {
    min-width: 0;
  }

  .simple-header__actions {
    flex-shrink: 0;
    max-width: 100%;
  }

  @media (max-width: 760px) {
    .simple-header--with-actions {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-sm);
    }

    .simple-header__actions {
      width: 100%;
    }
  }
</style>
