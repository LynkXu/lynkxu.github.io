---
const texts = {
	placeholder: '搜索标题、摘要或标签…',
	closeLabel: '关闭搜索',
	searchTip: '输入关键词，支持检索标题、摘要、标签与分类',
	keyboardTip: '<span class="search-key-hint"><kbd>↑</kbd><kbd>↓</kbd> 选择</span><span class="search-key-sep" aria-hidden="true">·</span><span class="search-key-hint"><kbd>Enter</kbd> 打开</span><span class="search-key-sep" aria-hidden="true">·</span><span class="search-key-hint"><kbd>Esc</kbd> 关闭</span>',
	resultsCount: '找到 <strong>{count}</strong> 篇文章',
	noResults: '没有找到相关文章',
	loadingText: '正在加载索引…',
	draftBadge: '草稿',
};
---

<!-- 搜索弹窗 -->
<div id="search-modal" class="search-modal" role="dialog" aria-modal="true" aria-label="搜索文章" aria-hidden="true">
	<div class="search-modal-overlay"></div>
	<div class="search-modal-content">
		<div class="search-modal-header">
			<div class="search-box">
				<svg class="search-icon" xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<circle cx="11" cy="11" r="8"></circle>
					<path d="m21 21-4.35-4.35"></path>
				</svg>
				<input type="text" id="modal-search-input" placeholder={texts.placeholder} autocomplete="off" aria-label="搜索关键词" />
				<button type="button" class="close-btn" id="close-search-modal" aria-label={texts.closeLabel} title="关闭 (Esc)">
					<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<line x1="18" y1="6" x2="6" y2="18"></line>
						<line x1="6" y1="6" x2="18" y2="18"></line>
					</svg>
				</button>
			</div>
		</div>

		<div id="modal-search-stats" class="search-stats" aria-live="polite"></div>

		<div id="modal-search-results" class="search-results">
			<div class="search-tips">
				<p>{texts.searchTip}</p>
				<p class="search-tips__keys" set:html={texts.keyboardTip}></p>
			</div>
		</div>
	</div>
</div>

<!-- 搜索功能 -->
<script is:inline define:vars={{ texts }}>
	window.SEARCH_TEXTS = texts;
</script>

<script is:inline>
	(function () {
		var posts = [];
		var dataLoaded = false;

		function escapeHtml(str) {
			return String(str || '')
				.replace(/&/g, '&amp;')
				.replace(/</g, '&lt;')
				.replace(/>/g, '&gt;')
				.replace(/"/g, '&quot;')
				.replace(/'/g, '&#39;');
		}

		function escapeRegex(str) {
			return str.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
		}

		function loadSearchData() {
			if (dataLoaded) return Promise.resolve(posts);
			return fetch('/search-index.json')
				.then(function (res) { return res.json(); })
				.then(function (data) {
					posts = data || [];
					dataLoaded = true;
					return posts;
				})
				.catch(function () {
					posts = [];
					dataLoaded = true;
					return posts;
				});
		}

		function initSearchModal() {
			const searchModal = document.getElementById('search-modal');
			const searchInput = document.getElementById('modal-search-input');
			const searchResults = document.getElementById('modal-search-results');
			const searchStats = document.getElementById('modal-search-stats');
			const closeBtn = document.getElementById('close-search-modal');
			const overlay = document.querySelector('.search-modal-overlay');

			if (!searchModal || !searchInput || !searchResults || !searchStats || !closeBtn || !overlay) {
				return;
			}

			const texts = window.SEARCH_TEXTS || {};
			const tipsHtml =
				'<div class="search-tips">' +
					'<p>' + escapeHtml(texts.searchTip || '') + '</p>' +
					'<p class="search-tips__keys">' + (texts.keyboardTip || '') + '</p>' +
				'</div>';

			let activeIndex = -1;
			let lastFocusedEl = null;

			function getResultLinks() {
				return Array.from(searchResults.querySelectorAll('a.result-item'));
			}

			function setActiveIndex(nextIndex) {
				const items = getResultLinks();
				if (items.length === 0) {
					activeIndex = -1;
					return;
				}
				activeIndex = ((nextIndex % items.length) + items.length) % items.length;
				items.forEach(function (item, idx) {
					item.classList.toggle('is-active', idx === activeIndex);
				});
				items[activeIndex].scrollIntoView({ block: 'nearest' });
			}

			// 打开弹窗（首次打开时按需懒加载索引，避免普通阅读页面产生多余请求）
			window.openSearchModal = function () {
				lastFocusedEl = document.activeElement instanceof HTMLElement ? document.activeElement : null;
				searchModal.classList.add('active');
				searchModal.setAttribute('aria-hidden', 'false');
				document.body.style.overflow = 'hidden';
				activeIndex = -1;
				loadSearchData();
				setTimeout(function () { searchInput.focus(); }, 60);
			};

			// 关闭弹窗
			function closeSearchModal() {
				searchModal.classList.remove('active');
				searchModal.setAttribute('aria-hidden', 'true');
				document.body.style.overflow = '';
				searchInput.value = '';
				searchResults.innerHTML = tipsHtml;
				searchStats.innerHTML = '';
				activeIndex = -1;
				if (lastFocusedEl && typeof lastFocusedEl.focus === 'function') {
					lastFocusedEl.focus();
				}
			}

			// 搜索函数
			function performSearch(query) {
				const keyword = query.trim().toLowerCase();
				activeIndex = -1;

				if (!keyword) {
					searchResults.innerHTML = tipsHtml;
					searchStats.innerHTML = '';
					return;
				}

				function doSearch() {
					const results = posts.filter(function (post) {
						const titleMatch = (post.title || '').toLowerCase().includes(keyword);
						const descMatch = (post.description || '').toLowerCase().includes(keyword);
						const tagsMatch = (post.tags || []).some(function (tag) { return tag.toLowerCase().includes(keyword); });
						const categoriesMatch = (post.categories || []).some(function (cat) { return cat.toLowerCase().includes(keyword); });
						return titleMatch || descMatch || tagsMatch || categoriesMatch;
					});
					renderResults(results, keyword);
				}

				if (!dataLoaded) {
					searchResults.innerHTML = '<div class="search-tips"><p>' + escapeHtml(texts.loadingText || '加载中…') + '</p></div>';
					loadSearchData().then(doSearch);
				} else {
					doSearch();
				}
			}

			function renderResults(results, keyword) {
				searchStats.innerHTML = (texts.resultsCount || '').replace('{count}', String(results.length));

				if (results.length === 0) {
					searchResults.innerHTML = '<div class="no-results">' + escapeHtml(texts.noResults || '') + '</div>';
					return;
				}

				const safeRegex = new RegExp('(' + escapeRegex(keyword) + ')', 'gi');
				function highlightText(text) {
					return escapeHtml(text).replace(safeRegex, '<mark>$1</mark>');
				}

				const html = results
					.map(function (post) {
						const date = new Date(post.pubDate);
						const formattedDate =
							date.getFullYear() + '.' +
							String(date.getMonth() + 1).padStart(2, '0') + '.' +
							String(date.getDate()).padStart(2, '0');

						var tagsHtml = '';
						if (post.tags && post.tags.length > 0) {
							tagsHtml =
								'<div class="result-tags">' +
								post.tags.map(function (tag) { return '<span class="tag">' + escapeHtml(tag) + '</span>'; }).join('') +
								'</div>';
						}

						var draftHtml = post.draft
							? '<span class="r-draft" aria-label="' + escapeHtml(texts.draftBadge) + '">' + escapeHtml(texts.draftBadge) + '</span>'
							: '';

						var blogUrl = '/blog/' + encodeURIComponent(post.slug) + '.html';

						return (
							'<a class="result-item" href="' + blogUrl + '">' +
								'<div class="result-header">' +
									'<span class="result-title">' +
										highlightText(post.title) +
										draftHtml +
									'</span>' +
									'<span class="result-date">' + formattedDate + '</span>' +
								'</div>' +
								(post.description ? '<p class="result-description">' + highlightText(post.description) + '</p>' : '') +
								tagsHtml +
							'</a>'
						);
					})
					.join('');

				searchResults.innerHTML = html;
				searchResults.scrollTop = 0;
			}

			// 事件监听
			closeBtn.addEventListener('click', closeSearchModal);
			overlay.addEventListener('click', closeSearchModal);

			// 键盘事件
			document.addEventListener('keydown', function (e) {
				if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
					e.preventDefault();
					if (searchModal.classList.contains('active')) {
						closeSearchModal();
					} else {
						window.openSearchModal();
					}
					return;
				}

				if (!searchModal.classList.contains('active')) return;

				if (e.key === 'Escape') {
					e.preventDefault();
					closeSearchModal();
				} else if (e.key === 'ArrowDown') {
					const items = getResultLinks();
					if (items.length > 0) {
						e.preventDefault();
						setActiveIndex(activeIndex + 1);
					}
				} else if (e.key === 'ArrowUp') {
					const items = getResultLinks();
					if (items.length > 0) {
						e.preventDefault();
						setActiveIndex(activeIndex <= 0 ? items.length - 1 : activeIndex - 1);
					}
				} else if (e.key === 'Enter' && activeIndex >= 0) {
					const items = getResultLinks();
					if (items[activeIndex]) {
						e.preventDefault();
						items[activeIndex].click();
					}
				}
			});

			// 实时搜索
			var searchTimeout;
			searchInput.addEventListener('input', function () {
				clearTimeout(searchTimeout);
				searchTimeout = setTimeout(function () {
					performSearch(searchInput.value);
				}, 180);
			});
		}

		if (document.readyState === 'loading') {
			document.addEventListener('DOMContentLoaded', initSearchModal);
		} else {
			initSearchModal();
		}
	})();
</script>

<style>
	.search-modal {
		position: fixed;
		inset: 0;
		z-index: var(--z-modal);
		display: none;
		align-items: flex-start;
		justify-content: center;
		padding: clamp(3rem, 10vh, 6rem) 1rem 1.5rem;
	}

	.search-modal.active {
		display: flex;
	}

	.search-modal-overlay {
		position: absolute;
		inset: 0;
		background: rgba(15, 18, 24, 0.42);
		backdrop-filter: blur(2px);
		-webkit-backdrop-filter: blur(2px);
		animation: searchFadeIn 0.18s ease;
	}

	.search-modal-content {
		position: relative;
		width: 100%;
		max-width: 620px;
		max-height: min(76vh, 620px);
		background: var(--r-bg, var(--content-bg));
		color: var(--r-ink, var(--text-color));
		border: 1px solid var(--r-rule, var(--paper-card-border));
		border-radius: var(--paper-card-radius, 4px);
		box-shadow: 0 12px 36px rgba(15, 23, 42, 0.14);
		display: flex;
		flex-direction: column;
		overflow: hidden;
		font-family: var(--r-font-ui, var(--ui-font));
		animation: searchSlideIn 0.2s cubic-bezier(0.2, 0, 0, 1);
	}

	:global(:root[data-theme="dark"]) .search-modal-content {
		box-shadow: 0 18px 48px rgba(0, 0, 0, 0.48);
	}

	@media (prefers-color-scheme: dark) {
		:global(:root:not([data-theme])) .search-modal-content {
			box-shadow: 0 18px 48px rgba(0, 0, 0, 0.48);
		}
	}

	.search-modal-header {
		padding: 0.75rem 1.15rem;
		border-bottom: 1px solid var(--r-rule, var(--paper-card-border-soft));
		flex-shrink: 0;
	}

	.search-box {
		display: flex;
		align-items: center;
		gap: 0.65rem;
	}

	.search-icon {
		color: var(--r-ink-faint, var(--faint-color));
		flex-shrink: 0;
	}

	#modal-search-input {
		flex: 1;
		min-width: 0;
		padding: 0.4rem 0;
		border: 0;
		outline: none;
		font-family: var(--r-font-ui, var(--ui-font));
		font-size: 0.98rem;
		line-height: 1.5;
		color: var(--r-ink, var(--heading-color));
		background: transparent;
	}

	#modal-search-input::placeholder {
		color: var(--r-ink-faint, var(--faint-color));
		opacity: 1;
	}

	.close-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 32px;
		height: 32px;
		padding: 0;
		border: 0;
		border-radius: 3px;
		background: transparent;
		color: var(--r-ink-soft, var(--gray-color));
		cursor: pointer;
		flex-shrink: 0;
		transition: color 0.18s ease, background-color 0.18s ease;
	}

	.close-btn:hover {
		color: var(--r-ink, var(--heading-color));
		background: color-mix(in oklab, var(--r-ink, var(--heading-color)) 6%, transparent);
	}

	.search-stats {
		padding: 0.6rem 1.15rem 0.2rem;
		font-size: var(--r-text-xs, 0.76rem);
		color: var(--r-ink-faint, var(--gray-color));
		font-variant-numeric: tabular-nums;
		flex-shrink: 0;
	}

	.search-stats:empty {
		display: none;
	}

	.search-stats :global(strong) {
		color: var(--r-ink, var(--heading-color));
		font-weight: 600;
	}

	.search-results {
		flex: 1;
		overflow-y: auto;
		overscroll-behavior: contain;
		padding: 0.35rem 1.15rem 1.25rem;
	}

	.search-tips {
		text-align: center;
		padding: 2.5rem 1rem 2rem;
		color: var(--r-ink-faint, var(--gray-color));
	}

	.search-tips p {
		margin: 0;
		font-size: 0.84rem;
		line-height: 1.6;
	}

	.search-tips :global(.search-tips__keys) {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		gap: 0.35rem 0.45rem;
		margin-top: 0.65rem;
		font-size: var(--r-text-xs, 0.75rem);
		color: var(--r-ink-faint, var(--faint-color));
	}

	.search-tips :global(.search-key-hint) {
		display: inline-flex;
		align-items: center;
		gap: 0.22rem;
		white-space: nowrap;
	}

	.search-tips :global(.search-key-sep) {
		opacity: 0.55;
	}

	.search-tips :global(kbd) {
		display: inline-block;
		margin: 0 0.12rem;
		padding: 0.1rem 0.38rem;
		border: 1px solid var(--r-rule, var(--paper-card-border));
		border-radius: 3px;
		background: var(--r-code-bg, var(--code-background-color));
		color: var(--r-ink-soft, var(--gray-color));
		font-family: var(--r-font-code, var(--code-font));
		font-size: 0.7rem;
		line-height: 1.4;
	}

	@keyframes searchFadeIn {
		from { opacity: 0; }
		to { opacity: 1; }
	}

	@keyframes searchSlideIn {
		from {
			opacity: 0;
			transform: translateY(8px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@media (pointer: coarse) {
		.close-btn {
			width: 40px;
			height: 40px;
		}
	}

	@media (max-width: 640px) {
		.search-modal {
			padding: 1.25rem 0.75rem 1rem;
		}

		.search-modal-content {
			max-height: 82vh;
		}

		.search-modal-header {
			padding: 0.65rem 0.9rem;
		}

		.search-stats {
			padding: 0.55rem 0.9rem 0.15rem;
		}

		.search-results {
			padding: 0.25rem 0.9rem 1.1rem;
		}

		#modal-search-input {
			font-size: 0.95rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.search-modal-overlay,
		.search-modal-content,
		.close-btn {
			animation: none;
			transition: none;
		}
	}
</style>

<!-- 全局样式用于动态插入的搜索结果 -->
<style is:global>
	.search-modal .result-item {
		display: block;
		padding: 0.85rem 0.65rem;
		margin: 0 -0.65rem;
		border-bottom: 1px solid var(--r-divider, var(--paper-card-border-soft));
		border-radius: 3px;
		background: transparent;
		color: inherit;
		text-decoration: none !important;
		transition: background-color 0.18s ease;
	}

	.search-modal .result-item:last-child {
		border-bottom: 0;
	}

	.search-modal .result-item:hover,
	.search-modal .result-item.is-active,
	.search-modal .result-item:focus-visible {
		background: color-mix(in oklab, var(--r-ink, var(--heading-color)) 4.5%, transparent);
		text-decoration: none !important;
		outline: none;
	}

	.search-modal .result-header {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		align-items: baseline;
		column-gap: 1rem;
		row-gap: 0.2rem;
	}

	.search-modal .result-title {
		margin: 0;
		font-family: var(--r-font-body, var(--serif-font));
		font-size: 0.98rem;
		font-weight: 500;
		line-height: 1.48;
		color: var(--r-ink, var(--heading-color));
		transition: color 0.18s ease;
	}

	.search-modal .result-item:hover .result-title,
	.search-modal .result-item.is-active .result-title {
		color: var(--r-link, var(--link-color));
	}

	.search-modal .result-date {
		font-family: var(--r-font-ui, var(--ui-font));
		font-size: var(--r-text-xs, 0.76rem);
		color: var(--r-ink-faint, var(--faint-color));
		font-variant-numeric: tabular-nums;
		white-space: nowrap;
		line-height: 1.5;
	}

	.search-modal .result-description {
		margin: 0.3rem 0 0;
		display: -webkit-box;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
		overflow: hidden;
		font-family: var(--r-font-ui, var(--ui-font));
		font-size: 0.82rem;
		line-height: 1.58;
		color: var(--r-ink-soft, var(--gray-color));
	}

	.search-modal .result-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
		margin-top: 0.45rem;
	}

	.search-modal .result-tags .tag {
		display: inline-flex;
		align-items: center;
		padding: 0.08rem 0.42rem;
		border-radius: 3px;
		background: color-mix(in oklab, var(--r-selection-bg, var(--accent-soft-bg)) 58%, transparent);
		color: var(--r-ink-soft, var(--gray-color));
		font-family: var(--r-font-ui, var(--ui-font));
		font-size: 0.7rem;
		font-weight: 400;
		line-height: 1.45;
	}

	.search-modal .no-results {
		text-align: center;
		padding: 3rem 1.5rem;
		font-size: 0.88rem;
		color: var(--r-ink-faint, var(--gray-color));
	}

	/* 关键词高亮：沿用正文标题的茶绿浅底洗色 */
	.search-modal mark {
		background: var(--r-selection-bg, var(--selection-bg));
		color: var(--r-ink, var(--heading-color));
		padding: 0.02em 0.14em;
		border-radius: 2px;
		font-weight: 500;
	}

	@media (max-width: 640px) {
		.search-modal .result-item {
			padding: 0.75rem 0.5rem;
			margin: 0 -0.5rem;
		}

		.search-modal .result-header {
			grid-template-columns: minmax(0, 1fr);
			row-gap: 0.12rem;
		}

		.search-modal .result-title {
			font-size: 0.94rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.search-modal .result-item,
		.search-modal .result-title {
			transition: none;
		}
	}
</style>
