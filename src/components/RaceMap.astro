---
interface Race {
  name: string;
  date: string;
  location: string;
  lat: number;
  lng: number;
  time?: string;
  pace?: string;
  type?: string;
  status?: string;
}

interface Props {
  races: Race[];
  id?: string;
}

const { races, id } = Astro.props;

const mapRaces = races.filter(
  (r) => r.status === 'completed' && typeof r.lat === 'number' && typeof r.lng === 'number'
);

if (mapRaces.length === 0) {
  return null;
}

const mapId = id || `race-map-${Math.random().toString(36).slice(2, 9)}`;
---

<div class="race-map-wrapper">
  <div id={mapId} class="race-map-container"></div>
</div>

<script define:vars={{ mapId, mapRaces }}>
(function initRaceMap() {
  function doInit() {
    if (!window.L) return;
    const container = document.getElementById(mapId);
    if (!container || container._leaflet_id) return;

    const lats = mapRaces.map((r) => r.lat);
    const lngs = mapRaces.map((r) => r.lng);
    const centerLat = lats.reduce((a, b) => a + b, 0) / lats.length;
    const centerLng = lngs.reduce((a, b) => a + b, 0) / lngs.length;

    const map = L.map(mapId, { zoomControl: false }).setView([centerLat, centerLng], 5);

    L.control.zoom({ position: 'bottomright' }).addTo(map);

    const positron = L.tileLayer(
      'https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png?key=cb1_2xmb_1_d1f716b1071e92bec7091f43',
      {
        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors &copy; <a href="https://carto.com/attributions">CARTO</a>',
        maxZoom: 19,
      }
    );
    let fallbackAdded = false;
    positron.on('tileerror', function () {
      if (!fallbackAdded) {
        map.removeLayer(positron);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
          attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
          maxZoom: 19,
        }).addTo(map);
        fallbackAdded = true;
      }
    });
    positron.addTo(map);

    // Small, high-contrast dots keep the basemap readable.
    const markers = [];
    mapRaces.forEach((race) => {
      const popupHtml = `<b>${race.name}</b><br><small>${race.date}${race.time ? ' · ' + race.time : ''}</small>`;
      const icon = L.divIcon({
        className: 'race-marker-icon',
        html: '<span class="race-marker-dot"></span>',
        iconSize: [24, 24],
        iconAnchor: [12, 12],
        popupAnchor: [0, -12],
      });
      const marker = L.marker([race.lat, race.lng], {
        icon, title: race.name, alt: `${race.location} · ${race.name}`,
      }).addTo(map);
      marker.bindPopup(popupHtml);
      markers.push({ marker, lat: race.lat, lng: race.lng, name: race.name });
    });

    if (mapRaces.length > 1) {
      const group = new L.featureGroup(markers.map((m) => m.marker));
      map.fitBounds(group.getBounds().pad(0.25));
    }

    window.addEventListener('resize', () => map.invalidateSize());
  }

  if (typeof L !== 'undefined') {
    doInit();
  } else {
    const script = document.querySelector('script[src*="leaflet.js"]');
    if (script) {
      script.addEventListener('load', doInit);
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      if (typeof L !== 'undefined') doInit();
    });
  }
})();
</script>

<style>
  .race-map-wrapper {
    position: relative;
    width: 100%;
    height: 280px;
    border-radius: 6px;
    overflow: hidden;
  }

  .race-map-container {
    width: 100%;
    height: 100%;
    background: var(--code-background-color);
  }

  :global([data-theme="dark"]) .race-map-container :global(.leaflet-tile-pane) {
    filter: invert(0.9) hue-rotate(180deg) brightness(1.1) contrast(0.9);
  }

  /* Marker contrast is independent of the basemap, including its dark-mode filter. */
  :global(.race-marker-icon) {
    --marker-color: var(--accent-color);
    display: grid;
    place-items: center;
    background: transparent;
    border: none;
  }

  :global(.race-marker-dot) {
    width: var(--space-md);
    height: var(--space-md);
    box-sizing: border-box;
    background: var(--marker-color);
    border-radius: 50%;
    border: 2px solid var(--paper-card-bg);
    box-shadow: 0 0 0 1px var(--marker-color), 0 1px 3px rgb(0 0 0 / 0.12);
    transition: translate 0.2s ease;
  }

  :global(.race-marker-icon:hover .race-marker-dot),
  :global(.race-marker-icon:focus-visible .race-marker-dot) {
    translate: 0 -1px;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.race-marker-dot) { transition: none; }
  }

  @media (max-width: 768px) {
    .race-map-wrapper {
      height: 220px;
    }
  }
</style>
