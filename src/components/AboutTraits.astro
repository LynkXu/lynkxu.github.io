---
const traitsClass = 'r-about__traits !m-0 !mt-[var(--r-space-md)] !mb-0 !flex !list-none !flex-wrap !items-baseline !gap-x-0 !gap-y-[var(--r-space-xs)] !p-0 [font-family:var(--r-font-ui)]';
const traitItemClass = 'whitespace-nowrap font-normal text-[var(--r-ink-soft)] [font-size:var(--r-text-xs)] leading-[1.6] [&:not(:last-child)]:after:mx-[var(--r-space-xs)] [&:not(:last-child)]:after:text-[var(--r-ink-faint)] [&:not(:last-child)]:after:content-["·"]';

const traits = [
  '全栈开发工程师',
  'Web3 爱好者',
  'APP 体验家',
  '长期主义',
  '混沌中立',
];
---

<ul class={traitsClass} aria-label="个人标签">
  {traits.map((trait) => (
    <li class={traitItemClass}>{trait}</li>
  ))}
</ul>
