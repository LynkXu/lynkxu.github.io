---
interface Props {
	id: string;
	type?: 'gossip' | 'post'; // 区分说说和文章详情页
}

const { id, type = 'gossip' } = Astro.props;
const baseClass = [
	'like-btn pending inline-flex cursor-pointer items-center border-0 bg-transparent p-0 transition-[color,opacity,background] duration-200',
	'disabled:cursor-not-allowed [&.pending]:pointer-events-none',
].join(' ');
const typeClass = type === 'gossip' ? 'gossip is-empty' : 'post is-empty';
const iconClass = 'like-icon shrink-0 transition-transform duration-[180ms]';
---

<button type="button" class={`${baseClass} ${typeClass} group`} data-id={id} aria-label="点赞" aria-pressed="false">
	<svg
		class={`${iconClass} post-heart`}
		width={type === 'post' ? '15' : '14'}
		height={type === 'post' ? '15' : '14'}
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="1.6"
		stroke-linecap="round"
		stroke-linejoin="round"
		aria-hidden="true"
	>
		<path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8L12 21l8.8-8.6a5.5 5.5 0 0 0 0-7.8Z" />
	</svg>
	{type === 'post' ? <span class="like-label">点赞</span> : <span class="like-label gossip-label">赞</span>}
	<span class="like-count"></span>
</button>

<style>
	/* Article & gossip like actions share a quiet paper heart treatment. */
	.post {
		min-height: 44px;
		gap: var(--space-xs);
		padding-inline: var(--space-sm);
		border-radius: 4px;
		font-family: var(--r-font-ui);
		font-size: 0.8rem;
		color: var(--r-ink-soft);
	}
	.post:hover { color: var(--r-ink); background: color-mix(in oklab, var(--r-rule-soft) 24%, transparent); }
	.post:focus-visible,
	.gossip:focus-visible { outline: 2px solid var(--r-ink-soft); outline-offset: var(--space-2xs); }
	.post .like-count { color: var(--r-ink-faint); font-variant-numeric: tabular-nums; }
	.post .like-count::before { content: '·'; margin-right: var(--space-xs); }
	.post.is-empty .like-count { display: none; }
	.post.liked { color: var(--r-ink-soft); }
	.post.liked .post-heart { fill: currentColor; color: color-mix(in oklab, #e06c75 75%, var(--r-ink-soft)); }

	.gossip {
		min-height: 1.75rem;
		gap: 0.32rem;
		padding: 0.2rem 0.5rem;
		border-radius: 4px;
		font-family: var(--r-font-ui);
		font-size: 0.74rem;
		line-height: 1;
		color: var(--r-ink-faint);
	}
	.gossip.pending { opacity: 0.5; }
	.gossip:hover {
		color: var(--r-ink);
		background: color-mix(in oklab, var(--r-ink) 4.5%, transparent);
	}
	.gossip .like-count {
		color: currentColor;
		font-variant-numeric: tabular-nums;
	}
	/* 0 赞时显示「赞」字，有赞时直接显示数字，保持简洁。 */
	.gossip:not(.is-empty) .gossip-label { display: none; }
	.gossip.is-empty .like-count { display: none; }
	.gossip.liked { color: color-mix(in oklab, #d65c67 78%, var(--r-ink-soft)); }
	.gossip.liked .post-heart { fill: currentColor; stroke: currentColor; }

	@media (pointer: coarse) {
		.gossip {
			min-height: 2.2rem;
			padding: 0.35rem 0.65rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.post, .gossip, .like-icon { transition: none; }
	}
</style>

<script>
	// 这里填入你部署好的 Cloudflare Worker 地址
	// 例如：https://likes.your-domain.workers.dev
	const API_URL = 'https://blog-likes.xulinxiao.workers.dev';

	async function initLikes() {
		const buttons = document.querySelectorAll('.like-btn');
		if (buttons.length === 0 || !API_URL) return;

		// 文章空态只隐藏数字；说说保留原来的悬停入口。
		const updateEmptyState = (btn: Element) => {
			const count = parseInt(btn.querySelector('.like-count')?.textContent ?? '') || 0;
			const liked = btn.classList.contains('liked');
			btn.classList.toggle('is-empty', count <= 0 && !liked);
			btn.setAttribute('aria-pressed', String(liked));
			const label = btn.querySelector('.like-label');
			if (label) {
				if (btn.classList.contains('gossip')) {
					label.textContent = '赞';
				} else {
					label.textContent = liked ? '已点赞' : '点赞';
				}
				btn.setAttribute('aria-label', liked ? '取消点赞' : '点赞');
			}
		};

		buttons.forEach(async (btn) => {
			if (btn.getAttribute('data-like-init') === 'true') return;
			// 碎语隐藏分页内的按钮延后到切页时再请求，避免首屏并发拉取全部页。
			if (btn.closest('[hidden]')) return;
			btn.setAttribute('data-like-init', 'true');

			const id = btn.getAttribute('data-id');
			const countSpan = btn.querySelector('.like-count');
			if (!id || !countSpan) return;

			// 检查本地是否已经点赞过
			const isLiked = localStorage.getItem(`liked_${id}`);
			if (isLiked) {
				btn.classList.add('liked');
			}

			// 获取初始点赞数
			try {
				const res = await fetch(`${API_URL}?id=${encodeURIComponent(id)}`);
				if (res.ok) {
					const data = await res.json();
					countSpan.textContent = data.likes || '0';
				} else {
					countSpan.textContent = '0';
				}
			} catch (e) {
				countSpan.textContent = '0';
			}
			updateEmptyState(btn);

			btn.classList.remove('pending');

			// 点击点赞或取消点赞
			btn.addEventListener('click', async () => {
				if (btn.hasAttribute('disabled')) return;

				const isCurrentlyLiked = btn.classList.contains('liked');
				const currentCount = parseInt(countSpan.textContent) || 0;

				// 乐观更新 UI
				btn.setAttribute('disabled', 'true');
				if (isCurrentlyLiked) {
					countSpan.textContent = Math.max(0, currentCount - 1);
					btn.classList.remove('liked');
				} else {
					countSpan.textContent = currentCount + 1;
					btn.classList.add('liked');
				}
				updateEmptyState(btn);

				// 发送请求
				try {
					const res = await fetch(`${API_URL}?id=${encodeURIComponent(id)}&action=${isCurrentlyLiked ? 'unlike' : 'like'}`, {
						method: 'POST'
					});

					if (res.ok) {
						if (isCurrentlyLiked) {
							localStorage.removeItem(`liked_${id}`);
						} else {
							localStorage.setItem(`liked_${id}`, 'true');
						}
					} else {
						// 失败回滚
						countSpan.textContent = currentCount;
						if (isCurrentlyLiked) {
							btn.classList.add('liked');
						} else {
							btn.classList.remove('liked');
						}
						updateEmptyState(btn);
					}
				} catch (e) {
					// 失败回滚
					countSpan.textContent = currentCount;
					if (isCurrentlyLiked) {
						btn.classList.add('liked');
					} else {
						btn.classList.remove('liked');
					}
					updateEmptyState(btn);
				} finally {
					btn.removeAttribute('disabled');
				}
			});
		});
	}

	// 首次加载
	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initLikes);
	} else {
		initLikes();
	}

	// 碎语切页时懒初始化新显示页的点赞按钮
	window.addEventListener('shuoshuo:page-change', initLikes);
</script>
