---
import { SPONSOR_GROUPS } from './sponsorConfig';

const sponsorRootClass = 'sponsor-about m-0 flex flex-col gap-[0.15rem] [container-type:inline-size]';
const foldClass = 'sponsor-fold group m-0 overflow-visible rounded-none border-0 bg-transparent';
const summaryClass = 'cursor-pointer list-none px-0 py-[0.3rem] [font-family:var(--r-font-ui,var(--field-font,var(--ui-font)))] [font-size:var(--r-text-sm,0.8rem)] font-normal text-[var(--r-ink-soft,var(--text-color))] transition-colors before:mr-1 before:text-[0.75em] before:text-[var(--r-ink-faint,var(--gray-color))] before:content-[\"▸_\"] hover:bg-transparent hover:text-[var(--r-ink,var(--heading-color))] [&::-webkit-details-marker]:hidden group-open:border-b-0 group-open:text-[var(--r-ink,var(--heading-color))] group-open:before:content-[\"▾_\"]';
const sponsorGridClass = 'sponsor-grid grid grid-cols-2 gap-[0.6rem] p-[0.75rem] max-[400px]:grid-cols-1';
const sponsorCardClass = 'sponsor-card rounded-[4px] border border-[var(--r-rule,var(--paper-card-border-soft))] bg-[var(--r-code-bg,var(--paper-card-bg))] p-[0.55rem] shadow-none';
const sponsorCardNameClass = 'sponsor-card__name mb-[0.35rem] [font-family:var(--r-font-ui,var(--field-font,var(--ui-font)))] [font-size:0.82rem] font-medium text-[var(--r-ink,var(--heading-color))]';
const qrBoxClass = 'sponsor-card__qr flex items-center justify-center rounded-[4px] border-0 bg-[var(--r-code-bg,oklch(0.99_0.003_80))] p-1';
const qrImageClass = 'm-0 block h-[100px] w-[100px] rounded-[2px] object-contain';
const cryptoListClass = 'crypto-list flex flex-col gap-0 px-[0.75rem] py-0';
const cryptoItemClass = 'crypto-item grid grid-cols-[112px_minmax(0,1fr)] items-start gap-[1rem] border-t border-[var(--r-rule,var(--paper-card-border-soft))] py-[1rem] first:border-t-0 max-[430px]:grid-cols-[88px_minmax(0,1fr)] max-[430px]:gap-[0.75rem] max-[300px]:grid-cols-1';
const cryptoQrClass = 'crypto-item__qr grid aspect-square w-[112px] place-items-center rounded-[4px] border border-[var(--r-rule,var(--paper-card-border-soft))] bg-[var(--r-code-bg,oklch(0.99_0.003_80))] p-[0.35rem] shadow-none max-[430px]:w-[88px] max-[300px]:w-[min(132px,100%)]';
const cryptoQrImageClass = 'm-0 block h-full w-full rounded-[2px] object-contain';
const cryptoContentClass = 'crypto-item__content flex min-w-0 flex-col gap-[0.75rem] max-[430px]:contents';
const cryptoHeadingClass = 'crypto-item__heading flex flex-col gap-[0.25rem] max-[430px]:self-center';
const cryptoTitleClass = 'm-0 [font-family:var(--r-font-ui,var(--field-font,var(--ui-font)))] [font-size:0.9rem] font-medium leading-[1.3] text-[var(--r-ink,var(--heading-color))]';
const cryptoDescClass = 'm-0 max-w-[42ch] [font-size:0.72rem] leading-[1.5] text-[color-mix(in_oklab,var(--r-ink-soft,var(--text-color))_64%,var(--r-ink-faint,var(--gray-color)))]';
const cryptoAddressClass = 'crypto-address grid grid-cols-[minmax(0,1fr)_auto] items-end gap-x-[0.6rem] gap-y-[0.45rem] max-[430px]:col-span-full max-[430px]:items-center max-[300px]:col-auto';
const cryptoLabelClass = 'crypto-address__label col-span-full [font-family:var(--r-font-ui,var(--field-font,var(--ui-font)))] [font-size:0.65rem] font-medium uppercase leading-none tracking-[0.05em] text-[var(--r-ink-faint,var(--gray-color))] max-[430px]:col-auto';
const cryptoCodeClass = 'min-w-0 break-all rounded-[4px] border border-[var(--r-rule,var(--paper-card-border-soft))] bg-[var(--r-code-bg,var(--paper-field-bg))] px-[0.65rem] py-[0.55rem] [font-size:0.69rem] leading-[1.45] text-[var(--r-ink,var(--text-color))] max-[430px]:col-span-full max-[430px]:row-start-2';
const copyButtonClass = 'addr-copy inline-flex min-h-[2.35rem] cursor-pointer items-center justify-center gap-[0.35rem] whitespace-nowrap rounded-[4px] border border-[var(--r-rule,var(--paper-card-border-soft))] bg-[var(--r-code-bg,var(--paper-card-bg))] px-[0.65rem] py-[0.45rem] [font-family:var(--r-font-ui,var(--field-font,var(--ui-font)))] [font-size:0.7rem] font-medium text-[var(--r-ink-soft,var(--text-color))] transition-[border-color,background,color] duration-150 hover:border-[color-mix(in_oklab,var(--r-link,var(--accent-color))_38%,var(--r-rule,var(--paper-card-border-soft)))] hover:bg-[color-mix(in_oklab,var(--r-selection-bg,var(--accent-soft-bg))_40%,var(--r-code-bg,var(--paper-card-bg)))] hover:text-[var(--r-ink,var(--heading-color))] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[color-mix(in_oklab,var(--r-link,var(--accent-color))_58%,transparent)] max-[430px]:col-start-2 max-[430px]:row-start-1 max-[430px]:min-h-[1.85rem] max-[430px]:py-[0.3rem] max-[300px]:min-h-[2.2rem] [&.is-copied]:border-[color-mix(in_oklab,var(--r-link,var(--accent-color))_46%,var(--r-rule,var(--paper-card-border-soft)))] [&.is-copied]:bg-[var(--r-selection-bg,var(--accent-soft-bg))] [&.is-copied]:text-[var(--r-ink,var(--heading-color))] [&_svg]:block [&_svg]:shrink-0';
---

<div class={sponsorRootClass}>
	<details class={foldClass}>
		<summary class={summaryClass}>WeChat / Alipay</summary>
		<div class={sponsorGridClass}>
			{SPONSOR_GROUPS.find((g) => g.name === 'CNY')?.items.map((item) => (
				<div class={sponsorCardClass}>
					<div class={sponsorCardNameClass}>{item.name}</div>
					<div class={qrBoxClass}>
						<img class={qrImageClass} src={item.image} alt={`${item.name} QR Code`} loading="lazy" />
					</div>
				</div>
			))}
		</div>
	</details>

	<details class={foldClass}>
		<summary class={summaryClass}>Crypto</summary>
		<div class={cryptoListClass}>
			{SPONSOR_GROUPS.find((g) => g.name === 'Crypto')?.items.map((item) => (
				<article class={cryptoItemClass}>
					<div class={cryptoQrClass}>
						<img class={cryptoQrImageClass} src={item.image} alt={`${item.name} QR`} loading="lazy" />
					</div>
					<div class={cryptoContentClass}>
						<div class={cryptoHeadingClass}>
							<h3 class={cryptoTitleClass}>{item.name}</h3>
							{item.desc && <p class={cryptoDescClass}>{item.desc}</p>}
						</div>
						{item.address && (
							<div class={cryptoAddressClass}>
								<span class={cryptoLabelClass}>Wallet address</span>
								<code class={cryptoCodeClass}>{item.address}</code>
								<button
									class={copyButtonClass}
									type="button"
									data-clipboard-text={item.address}
									aria-label={`Copy ${item.name} wallet address`}
								>
									<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="0" ry="0"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
									<span class="addr-copy__label" aria-live="polite">复制地址</span>
								</button>
							</div>
						)}
					</div>
				</article>
			))}
		</div>
	</details>
</div>

<script>
	function initSponsorCopy() {
		const root = document.querySelector('.sponsor-about');
		if (!root) return;

		const folds = root.querySelectorAll('.sponsor-fold');
		folds.forEach((fold) => {
			if (fold.getAttribute('data-accordion-bound') === 'true') return;
			fold.setAttribute('data-accordion-bound', 'true');

			fold.addEventListener('toggle', () => {
				if (!fold.open) return;
				folds.forEach((other) => {
					if (other !== fold) other.open = false;
				});
			});
		});

		const copyBtns = root.querySelectorAll('.addr-copy');
		copyBtns.forEach((btn) => {
			if (btn.getAttribute('data-copy-bound') === 'true') return;
			btn.setAttribute('data-copy-bound', 'true');

			btn.addEventListener('click', async () => {
				const text = btn.getAttribute('data-clipboard-text');
				if (!text) return;
				try {
					await navigator.clipboard.writeText(text);
					const label = btn.querySelector('.addr-copy__label');
					btn.classList.add('is-copied');
					if (label) label.textContent = '已复制';
					setTimeout(() => {
						btn.classList.remove('is-copied');
						if (label) label.textContent = '复制地址';
					}, 1500);
				} catch (e) {
					// ignore
				}
			});
		});
	}

	document.addEventListener('DOMContentLoaded', initSponsorCopy);
	document.addEventListener('astro:page-load', initSponsorCopy);
</script>
