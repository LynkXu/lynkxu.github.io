---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'>;

type HeaderLinkProps = Props & {
	showSeparator?: boolean;
};

const { href, class: className, showSeparator = false, ...props } = Astro.props as HeaderLinkProps;
const pathname = Astro.url.pathname.replace(import.meta.env.BASE_URL, '');
const subpath = pathname.match(/[^\/]+/g);
const isActive = href === pathname || href === '/' + (subpath?.[0] || '');
---

<a
	href={href}
	class:list={[
		'relative inline-flex min-h-0 items-center rounded-none border-0 p-0 [font-family:var(--ui-font)] text-[0.72rem] font-[430] leading-[1.25] tracking-[0.005em] text-[var(--gray-color)] no-underline transition-[color,opacity,transform] duration-[250ms] ease-[cubic-bezier(0.2,0.8,0.2,1)] before:text-[var(--faint-color)] before:font-normal hover:-translate-y-px hover:border-b-0 hover:text-[color-mix(in_oklab,var(--heading-color)_74%,var(--gray-color))]',
		showSeparator && "before:mx-[0.55rem] before:content-['·']",
		isActive && 'active border-b-0 font-[480] text-[color-mix(in_oklab,var(--heading-color)_82%,var(--gray-color))]',
		className,
	]}
	aria-current={isActive ? 'page' : undefined}
	{...props}
>
	<span class="nav-link-text"><slot /></span>
</a>
