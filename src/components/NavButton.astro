---
interface Props {
	showBackToTop?: boolean; // 是否显示回到顶部按钮，默认 true
	showReadingProgress?: boolean;
}

const { showBackToTop = true, showReadingProgress = false } = Astro.props;
---

{
	showBackToTop && (
		<div class='nav-buttons-group'>
			<button
				class:list={['nav-button', 'nav-top', { 'nav-top--progress': showReadingProgress }]}
				id='backToTop'
				type='button'
				aria-label='回到顶部'
				data-reading-progress={showReadingProgress ? 'true' : undefined}
				style={showReadingProgress ? '--reading-progress: 0' : undefined}
				hidden
			>
				{showReadingProgress && (
					<svg class='nav-progress' viewBox='0 0 40 40' aria-hidden='true'>
						<circle cx='20' cy='20' r='18' pathLength='1'></circle>
					</svg>
				)}
				<svg
					xmlns='http://www.w3.org/2000/svg'
					width='24'
					height='24'
					viewBox='0 0 24 24'
					fill='none'
					stroke='currentColor'
					stroke-width='2'
					stroke-linecap='round'
					stroke-linejoin='round'
					class='nav-top-icon lucide lucide-arrow-up'
					aria-hidden='true'>
					<path d='m5 12 7-7 7 7' />
					<path d='M12 19V5' />
				</svg>
			</button>
		</div>
	)
}

<script>
	import { calculateReadingProgress } from '../scripts/reading-progress.mjs';

	let backToTopCleanup: (() => void) | null = null;

	function getScrollY() {
		return window.scrollY || document.documentElement.scrollTop || document.body.scrollTop || 0;
	}

	function initBackToTop() {
		backToTopCleanup?.();

		const backToTopBtn = document.getElementById('backToTop') as HTMLButtonElement | null;
		if (!backToTopBtn) return;

		const threshold = 280;
		const progressEnabled = backToTopBtn.dataset.readingProgress === 'true';
		const postContent = progressEnabled
			? document.querySelector<HTMLElement>('.post-content')
			: null;
		let animationFrame = 0;

		function updateControls() {
			animationFrame = 0;
			const scrollY = getScrollY();
			const shouldShow = scrollY > threshold;
			backToTopBtn.classList.toggle('visible', shouldShow);
			backToTopBtn.hidden = !shouldShow;

			if (!postContent) return;

			const bounds = postContent.getBoundingClientRect();
			const progress = calculateReadingProgress(
				scrollY,
				bounds.top + scrollY,
				postContent.offsetHeight,
				window.innerHeight,
			);
			backToTopBtn.classList.toggle('has-reading-progress', progress !== null);
			backToTopBtn.style.setProperty('--reading-progress', String(progress ?? 0));
		}

		function requestUpdate() {
			if (animationFrame) return;
			animationFrame = window.requestAnimationFrame(updateControls);
		}

		function scrollToTop() {
			window.scrollTo({ top: 0, behavior: 'smooth' });
		}

		backToTopBtn.addEventListener('click', scrollToTop);
		window.addEventListener('scroll', requestUpdate, { passive: true });
		window.addEventListener('resize', requestUpdate, { passive: true });
		document.addEventListener('scroll', requestUpdate, { passive: true });

		updateControls();

		backToTopCleanup = () => {
			if (animationFrame) window.cancelAnimationFrame(animationFrame);
			backToTopBtn.removeEventListener('click', scrollToTop);
			window.removeEventListener('scroll', requestUpdate);
			window.removeEventListener('resize', requestUpdate);
			document.removeEventListener('scroll', requestUpdate);
		};
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initBackToTop, { once: true });
	} else {
		initBackToTop();
	}

	document.addEventListener('astro:page-load', initBackToTop);
</script>

<style>
	.nav-buttons-group {
		position: fixed;
		right: 18px;
		bottom: 70px;
		z-index: var(--z-fab);
		margin: 0;
		padding: 0;
		pointer-events: none;
	}

	.nav-button {
		position: relative;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 42px;
		height: 42px;
		padding: 0;
		background: var(--paper-card-bg);
		color: var(--gray-color);
		text-decoration: none;
		font-size: 0.875rem;
		font-weight: 500;
		transition:
			opacity 0.24s ease,
			visibility 0.24s ease,
			transform 0.24s ease,
			background 0.2s ease,
			border-color 0.2s ease,
			color 0.2s ease;
		border: 1px solid var(--paper-card-border);
		box-shadow: var(--paper-card-shadow);
		backdrop-filter: blur(8px);
		-webkit-backdrop-filter: blur(8px);
		outline: none;
		cursor: pointer;
	}

	.nav-button:hover {
		background: color-mix(in oklab, var(--paper-card-bg) 92%, var(--content-bg));
		color: var(--heading-color);
		border-color: var(--paper-card-border);
		text-decoration: none;
		transform: translateY(-1px);
	}

	.nav-button.nav-top--progress,
	.nav-button.nav-top--progress:hover {
		width: 40px;
		height: 40px;
		padding: 0;
		border: 0;
		border-radius: 50%;
		background: transparent;
		box-shadow: none;
		backdrop-filter: none;
		-webkit-backdrop-filter: none;
	}

	.nav-button.nav-top--progress:hover {
		color: var(--heading-color);
		transform: translateY(0);
	}

	.nav-button .nav-top-icon {
		width: 18px;
		height: 18px;
		flex-shrink: 0;
		transition: transform 0.2s ease;
	}

	.nav-button .nav-progress {
		position: absolute;
		inset: 0;
		display: block;
		width: 100%;
		height: 100%;
		color: inherit;
		pointer-events: none;
		transform: rotate(-90deg);
	}

	.nav-progress circle {
		fill: none;
		stroke: currentColor;
		stroke-width: 1px;
		stroke-dasharray: 1;
		stroke-dashoffset: calc(1 - var(--reading-progress, 0));
		stroke-linecap: round;
		vector-effect: non-scaling-stroke;
		opacity: 0;
		transition: opacity 0.2s ease;
	}

	.nav-top.has-reading-progress .nav-progress circle {
		opacity: 0.32;
	}

	.nav-top {
		opacity: 0;
		visibility: hidden;
		transform: translateY(6px);
		pointer-events: none;
	}

	.nav-top.visible {
		opacity: 1;
		visibility: visible;
		transform: translateY(0);
		pointer-events: auto;
	}

	.nav-buttons-group:has(.nav-top.visible) {
		pointer-events: auto;
	}

	.nav-top:hover .nav-top-icon {
		transform: translateY(-2px);
	}

	.nav-top:focus-visible {
		outline: 2px solid var(--accent-color);
		outline-offset: 3px;
	}

	@media (max-width: 640px) {
		.nav-buttons-group {
			right: 14px;
			bottom: 64px;
		}

		.nav-button {
			width: 40px;
			height: 40px;
		}
	}
</style>
