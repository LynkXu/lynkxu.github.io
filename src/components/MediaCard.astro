---
interface Props {
  title: string;
  cover?: string | null;
  rating?: number | null;
  comment?: string | null;
  recordedDate?: string;
  year?: string | number | null;
  link?: string;
  statusLabel?: string;
  kind?: string;
  subtitle?: string;
  stars?: number | null;
}

const {
  title,
  cover,
  comment,
  recordedDate,
  year,
  link,
  statusLabel,
  kind,
  subtitle,
  stars,
} = Astro.props;

const yearLabel = year && year !== '未知' ? String(year) : '';
const subtitleText = subtitle || '';
const filledStars = typeof stars === 'number' ? stars : null;
---

<a href={link} target="_blank" rel="noopener noreferrer" class="media-card no-underline">
  <div class={`cover-frame ${cover ? '' : 'is-missing'}`} data-title={title}>
    {cover ? (
      <img
        src={cover}
        alt=""
        loading="lazy"
        onerror="this.closest('.cover-frame')?.classList.add('is-missing'); this.remove();"
      />
    ) : (
      <span class="cover-fallback">{title}</span>
    )}
  </div>

  <div class="media-info">
    {kind && <span class="media-kind">{kind}</span>}
    <h3 class="media-title">{title}</h3>
    {(subtitleText || yearLabel) && (
      <p class="media-subtitle">{subtitleText || yearLabel}</p>
    )}
    {filledStars !== null && (
      <p class="media-stars" aria-label={`${filledStars} 星`}>
        {Array.from({ length: 5 }, (_, index) => (
          <span class={index < filledStars ? 'is-filled' : 'is-empty'} aria-hidden="true">
            {index < filledStars ? '★' : '☆'}
          </span>
        ))}
      </p>
    )}
    <p class="media-meta">
      {recordedDate && <span>{recordedDate}</span>}
      {statusLabel && <span>{statusLabel}</span>}
    </p>
    {comment && <p class="media-comment">{comment}</p>}
  </div>
</a>

<style>
  .media-card {
    display: grid;
    grid-template-columns: 80px minmax(0, 1fr);
    align-items: start;
    gap: var(--space-sm);
    min-width: 0;
    color: inherit;
    text-decoration: none;
    border-bottom: 0 !important;
  }

  .media-card:hover,
  .media-card:focus-visible {
    border-bottom: 0 !important;
  }

  .media-card:focus-visible {
    outline: 2px solid color-mix(in oklab, var(--accent-color) 72%, transparent);
    outline-offset: 4px;
  }

  .cover-frame {
    position: relative;
    width: 100%;
    aspect-ratio: 2 / 3;
    overflow: hidden;
    border: 1px solid var(--paper-card-border-soft);
    border-radius: var(--paper-card-radius);
    background: var(--paper-field-bg);
  }

  .cover-frame img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.28s ease;
  }

  .media-card:hover .cover-frame img {
    transform: scale(1.02);
  }

  .cover-frame.is-missing {
    display: flex;
    align-items: flex-end;
    padding: var(--space-xs);
  }

  .cover-frame.is-missing::after {
    color: var(--heading-color);
    content: attr(data-title);
    font-family: var(--serif-font);
    font-size: 0.68rem;
    line-height: 1.45;
  }

  .cover-fallback {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }

  .media-info {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 0.22rem;
    padding-top: 1px;
  }

  .media-kind {
    display: inline-flex;
    align-self: start;
    padding: 0.08rem 0.34rem;
    border: 1px solid var(--paper-card-border);
    border-radius: 2px;
    color: var(--gray-color);
    font-family: var(--ui-font);
    font-size: 0.64rem;
    font-weight: var(--weight-semibold);
    line-height: 1.3;
  }

  .media-title {
    display: -webkit-box;
    margin: 0;
    overflow: hidden;
    color: var(--heading-color);
    font-family: var(--serif-font);
    font-size: 0.96rem;
    font-weight: var(--weight-semibold);
    line-height: 1.38;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    transition: color 0.2s ease;
  }

  .media-card:hover .media-title {
    color: var(--link-color);
  }

  .media-subtitle,
  .media-meta,
  .media-comment {
    margin: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .media-subtitle,
  .media-meta {
    color: var(--gray-color);
    font-family: var(--ui-font);
    font-size: 0.7rem;
    line-height: 1.4;
  }

  .media-stars {
    display: flex;
    gap: 0.08rem;
    margin: 0.04rem 0 0;
    color: var(--faint-color);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    line-height: 1;
  }

  .media-stars .is-filled {
    color: var(--heading-color);
  }

  .media-stars .is-empty {
    color: color-mix(in oklab, var(--faint-color) 42%, transparent);
  }

  .media-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    font-variant-numeric: tabular-nums;
  }

  .media-comment {
    display: -webkit-box;
    color: var(--text-color);
    font-family: var(--serif-font);
    font-size: 0.76rem;
    line-height: 1.5;
    white-space: normal;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  @media (max-width: 520px) {
    .media-card {
      grid-template-columns: 76px minmax(0, 1fr);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cover-frame img,
    .media-title {
      transition: none;
    }
  }
</style>
