---
interface ChangelogEntry {
	date: Date;
	note: string;
}

interface Props {
	entries: ChangelogEntry[];
}

const { entries } = Astro.props;

const sorted = [...entries].sort(
	(a, b) => new Date(b.date).getTime() - new Date(a.date).getTime()
);

function formatDate(date: Date): string {
	const d = new Date(date);
	const year = d.getFullYear();
	const month = String(d.getMonth() + 1).padStart(2, '0');
	const day = String(d.getDate()).padStart(2, '0');
	return `${year}.${month}.${day}`;
}

const changelogClass = 'changelog history-fold m-0 [font-family:var(--serif-font)] [font-size:var(--text-sm)] leading-[1.6] text-[var(--gray-color)]';
const summaryClass = 'changelog__summary flex cursor-pointer select-none list-none items-center gap-[0.5rem] outline-none [&::-webkit-details-marker]:hidden [&:hover_.changelog__arrow]:opacity-100 [&:hover_.changelog__count]:opacity-100 [&:hover_.changelog__label]:opacity-100';
const labelClass = 'changelog__label [font-size:var(--text-xs)] uppercase tracking-[0.12em] text-[color-mix(in_oklab,var(--ink-accent)_68%,var(--gray-color))] opacity-88 transition-opacity duration-150';
const countClass = 'changelog__count [font-size:var(--text-xs)] opacity-50 transition-opacity duration-150 [font-variant-numeric:tabular-nums]';
const arrowClass = 'changelog__arrow inline-block text-[0.9rem] leading-none text-[color-mix(in_oklab,var(--ink-accent)_68%,var(--gray-color))] opacity-62 transition-[transform,opacity] duration-200 group-open:rotate-90';
const listClass = 'changelog__list m-0 mt-[0.8rem] flex list-none flex-col gap-[0.4rem] p-0';
const entryClass = 'changelog__entry flex items-baseline gap-[0.5rem]';
const dateClass = 'changelog__date shrink-0 whitespace-nowrap [font-family:var(--code-font)] [font-size:var(--text-xs)] opacity-80 [font-variant-numeric:tabular-nums]';
const sepClass = 'changelog__sep shrink-0 opacity-40';
const noteClass = 'changelog__note leading-[1.5] opacity-75';
---

<details class={`${changelogClass} group`}>
	<summary class={summaryClass}>
		<span class={labelClass}>修订记录</span>
		<span class={countClass}>{sorted.length} 条</span>
		<span class={arrowClass} aria-hidden="true">›</span>
	</summary>
	<ul class={listClass}>
		{sorted.map((entry) => (
			<li class={entryClass}>
				<time class={dateClass} datetime={new Date(entry.date).toISOString()}>
					{formatDate(entry.date)}
				</time>
				<span class={sepClass}>·</span>
				<span class={noteClass}>{entry.note}</span>
			</li>
		))}
	</ul>
</details>
