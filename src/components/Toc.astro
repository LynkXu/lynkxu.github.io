---
import type { MarkdownHeading } from 'astro';

interface Props {
	headings?: MarkdownHeading[];
	minLevel?: number;
	maxLevel?: number;
	title?: string;
}

const { headings = [], minLevel = 2, maxLevel = 3, title = '目录' } = Astro.props;

const items = headings.filter((h) => h.depth >= minLevel && h.depth <= maxLevel);

interface TocNode {
	heading: MarkdownHeading;
	children: TocNode[];
}

function buildTree(list: MarkdownHeading[]): TocNode[] {
	const root: TocNode[] = [];
	const stack: TocNode[] = [];

	for (const heading of list) {
		const node: TocNode = { heading, children: [] };
		while (stack.length > 0 && stack[stack.length - 1].heading.depth >= heading.depth) {
			stack.pop();
		}
		if (stack.length === 0) {
			root.push(node);
		} else {
			stack[stack.length - 1].children.push(node);
		}
		stack.push(node);
	}

	return root;
}

const tree = buildTree(items);
---

{items.length > 0 && (
	<aside class="toc-container" data-has-content="true">
		<nav id="toc-nav" class="toc" aria-label={title}>
			<ul class="toc-list">
				{tree.map((node) => (
					<li class={`toc-item toc-level-${node.heading.depth}`}>
						<a href={`#${node.heading.slug}`} class="toc-link">
							{node.heading.text}
						</a>
						{node.children.length > 0 && (
							<ul class="toc-list">
								{node.children.map((child) => (
									<li class={`toc-item toc-level-${child.heading.depth}`}>
										<a href={`#${child.heading.slug}`} class="toc-link">
											{child.heading.text}
										</a>
										{child.children.length > 0 && (
											<ul class="toc-list">
												{child.children.map((leaf) => (
													<li class={`toc-item toc-level-${leaf.heading.depth}`}>
														<a href={`#${leaf.heading.slug}`} class="toc-link">
															{leaf.heading.text}
														</a>
													</li>
												))}
											</ul>
										)}
									</li>
								))}
							</ul>
						)}
					</li>
				))}
			</ul>
		</nav>
	</aside>
)}
