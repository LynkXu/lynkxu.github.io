---
import { getTrendScale, formatRaceDuration } from '../utils/race-trends.mjs';

interface Point { label: string; axisLabel: string; value: number; displayValue: string; }
interface Props { series: { type: string; data: Point[] }[]; id: string; }
const { series, id } = Astro.props;
const dates = [...new Set(series.flatMap(group => group.data.map(point => point.axisLabel)))].sort();
const groups = series.map(group => ({ ...group, scale: getTrendScale(group.data.map(point => point.value), group.type) }));
const x = (date: string) => dates.length === 1 ? 50 : 8 + dates.indexOf(date) / (dates.length - 1) * 84;
const y = (value: number, scale: ReturnType<typeof getTrendScale>) => 100 - (value - scale.min) / (scale.max - scale.min) * 100;
---

<div class="race-chart" id={id}>
  <div class="chart-head" role="group" aria-label="半马读取左轴，全马读取右轴">
    {groups.map(group => (
      <span class={`legend-item ${group.type === '全马' ? 'full' : 'half'}`}>
        <span class="legend-mark" aria-hidden="true"></span>{group.type}
      </span>
    ))}
  </div>
  <div class="chart-frame" title="横坐标按参赛顺序等距排列；半马读取左轴，全马读取右轴，两侧刻度独立。">
    <div class="chart-plot">
      <svg viewBox="0 0 1000 300" preserveAspectRatio="none" aria-hidden="true" focusable="false">
        {groups[0].scale.ticks.map(tick => <line x1="0" x2="1000" y1={y(tick, groups[0].scale) * 3} y2={y(tick, groups[0].scale) * 3} class="grid-line" />)}
        {groups.map(group => group.data.length > 1 && (
          <path d={group.data.map((point, i) => `${i === 0 ? 'M' : 'L'} ${x(point.axisLabel) * 10} ${y(point.value, group.scale) * 3}`).join(' ')} class={`trend-line ${group.type === '全马' ? 'full' : 'half'}`} />
        ))}
      </svg>
      {groups.map(group => (
        <>
          {group.scale.ticks.map(tick => (
            <span aria-hidden="true" class={`axis-tick ${group.type === '全马' ? 'right full' : 'left half'}`} style={`top: ${y(tick, group.scale)}%`}>{formatRaceDuration(tick)}</span>
          ))}
          {group.data.map((point, index) => (
            <button type="button" class={`chart-point ${group.type === '全马' ? 'full' : 'half'}`} style={`left: ${x(point.axisLabel)}%; top: ${y(point.value, group.scale)}%`} aria-label={`${group.type} · ${point.label} · ${point.displayValue}`} data-label={`${group.type} · ${point.label}`} data-value={point.displayValue}>
              <span class="point-mark" aria-hidden="true"></span>
              {dates.length <= 5 && <span class={`point-value ${index === 0 && group.data.length > 1 ? 'below' : ''}`} aria-hidden="true">{point.displayValue}</span>}
            </button>
          ))}
        </>
      ))}
      {dates.map((date, index) => (
        <span aria-hidden="true" class={`date-label ${index === 0 ? 'first' : index === dates.length - 1 ? 'last' : ''}`} style={`left: ${x(date)}%`}><span class="date-year">{date.slice(0, 4)}</span><span>{date.slice(5)}</span></span>
      ))}
    </div>
    <div class="chart-tooltip"><span class="tooltip-label"></span><strong class="tooltip-value"></strong></div>
  </div>
</div>

<script define:vars={{ id }}>
  (() => {
    const chart = document.getElementById(id);
    if (!chart) return;
    const frame = chart.querySelector('.chart-frame');
    const tooltip = chart.querySelector('.chart-tooltip');
    chart.querySelectorAll('.chart-point').forEach(point => {
      const show = () => {
        tooltip.querySelector('.tooltip-label').textContent = point.dataset.label;
        tooltip.querySelector('.tooltip-value').textContent = point.dataset.value;
        tooltip.classList.add('visible');
        const rect = point.getBoundingClientRect();
        const bounds = frame.getBoundingClientRect();
        const half = tooltip.getBoundingClientRect().width / 2;
        const center = rect.left - bounds.left + rect.width / 2;
        tooltip.style.left = Math.max(half + 4, Math.min(center, bounds.width - half - 4)) + 'px';
        tooltip.style.top = rect.top - bounds.top - 12 + 'px';
      };
      const hide = () => tooltip.classList.remove('visible');
      point.addEventListener('mouseenter', show);
      point.addEventListener('mouseleave', hide);
      point.addEventListener('focus', show);
      point.addEventListener('blur', hide);
    });
  })();
</script>

<style>
  .race-chart {
    --half-color: var(--accent-color);
    /* 暖棕区分全马与墨绿半马；混合主题文字色以兼容浅深背景。 */
    --full-color: color-mix(in oklab, oklch(0.64 0.09 55) 70%, var(--heading-color));
    display: flex;
    flex-direction: column;
    height: 100%;
    box-sizing: border-box;
    font-family: var(--ui-font);
    padding: var(--space-sm) var(--space-md) var(--space-xs);
  }
  .half { color: var(--half-color); }
  .full { color: var(--full-color); }
  .chart-head { display: grid; grid-template-columns: 1fr 1fr; align-items: center; margin-bottom: var(--space-lg); }
  .legend-item { display: inline-flex; align-items: center; gap: var(--space-xs); font-size: var(--text-xs); }
  .legend-item.half { grid-column: 1; }
  .legend-item.full { grid-column: 2; justify-self: end; }
  .legend-mark { width: var(--space-sm); height: var(--space-sm); border: 2px solid currentColor; border-radius: 50%; box-sizing: border-box; }
  .full .legend-mark { border-radius: 0; transform: rotate(45deg); background: currentColor; }
  .chart-frame { position: relative; flex: 1; min-height: 0; padding: var(--space-md) calc(var(--space-2xl) + var(--space-sm)) var(--space-2xl); }
  .chart-plot { position: relative; height: 100%; }
  svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .grid-line { stroke: var(--paper-card-border-soft); stroke-opacity: 0.65; stroke-width: 1; vector-effect: non-scaling-stroke; }
  .trend-line { fill: none; stroke: currentColor; stroke-width: 2.5; stroke-linecap: round; stroke-linejoin: round; vector-effect: non-scaling-stroke; }
  .trend-line.full { stroke-dasharray: 5 5; }
  .axis-tick { position: absolute; top: 0; font-size: var(--text-xs); font-variant-numeric: tabular-nums; line-height: var(--lh-tight); transform: translateY(-50%); }
  .axis-tick.left { right: calc(100% + var(--space-sm)); }
  .axis-tick.right { left: calc(100% + var(--space-sm)); }
  .chart-point { position: absolute; width: var(--space-lg); height: var(--space-lg); transform: translate(-50%, -50%); display: grid; place-items: center; padding: 0; border: 0; background: transparent; cursor: pointer; }
  .point-mark { width: var(--space-sm); height: var(--space-sm); border: 2px solid currentColor; border-radius: 50%; background: var(--paper-card-bg); box-sizing: border-box; }
  .full .point-mark { border-radius: 0; transform: rotate(45deg); background: currentColor; }
  .chart-point:hover .point-mark, .chart-point:focus-visible .point-mark { background: currentColor; }
  .chart-point:focus-visible { outline: 1px solid currentColor; outline-offset: 2px; }
  .point-value { position: absolute; bottom: calc(100% + var(--space-2xs)); white-space: nowrap; font-family: var(--code-font); font-size: var(--text-xs); font-weight: 500; font-variant-numeric: tabular-nums; }
  .point-value.below { bottom: auto; top: calc(100% + var(--space-2xs)); }
  .date-label { position: absolute; top: calc(100% + var(--space-lg)); transform: translateX(-50%); font-size: var(--text-xs); font-variant-numeric: tabular-nums; color: var(--gray-color); white-space: nowrap; }
  .date-year::after { content: "-"; }
  .chart-tooltip { position: absolute; transform: translate(-50%, -100%); opacity: 0; pointer-events: none; width: max-content; max-width: calc(100% - var(--space-md)); box-sizing: border-box; padding: var(--space-xs) var(--space-sm); background: var(--code-background-color); border: 1px solid var(--paper-card-border); border-radius: var(--paper-card-radius); display: grid; gap: var(--space-2xs); font-size: var(--text-xs); z-index: 2; color: var(--gray-color); }
  .chart-tooltip.visible { opacity: 1; }
  .tooltip-value { color: var(--heading-color); font-variant-numeric: tabular-nums; }
  @media (max-width: 640px) {
    .race-chart { padding-inline: var(--space-xs); }
    .chart-head { margin-bottom: var(--space-lg); }
    .chart-frame { padding-inline: var(--space-3xl); }
    .date-label { font-size: 0.68rem; display: flex; flex-direction: column; align-items: center; top: calc(100% + var(--space-md)); }
    .date-year::after { content: none; }
    .point-value { font-size: 0.68rem; }
    .full .point-value { right: 0; bottom: auto; top: calc(100% + var(--space-2xs)); }
    .point-value.below { left: 0; }
    .date-label.first { transform: translateX(-25%); }
    .date-label.last { transform: translateX(-75%); }
  }
</style>
