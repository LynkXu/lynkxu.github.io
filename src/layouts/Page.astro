---
import type { CollectionEntry } from 'astro:content';
import ReadingShell from './ReadingShell.astro';

type Props = CollectionEntry<'page'>['data'] & {
	content?: string;
};

const { title } = Astro.props;
---

<ReadingShell title={title} description={title}>
	<div class="content-limit-width">
		<h1 class="r-page-title">{title}</h1>
		<div class='r-prose post-content content'>
			<slot />
		</div>
	</div>

	<style>
		/* 普通页面与文章页一致：正文与标题左边线对齐且同宽 */
		.content-limit-width > .post-content {
			max-width: 100%;
			margin-left: 0;
			margin-right: 0;
		}
	</style>
</ReadingShell>
