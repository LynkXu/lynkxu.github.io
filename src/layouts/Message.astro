---
import type { CollectionEntry } from 'astro:content';
import ReadingShell from './ReadingShell.astro';
import Comments from '../components/Comments.astro';

type Props = CollectionEntry<'page'>['data'] & {
	content?: string;
};

const { title } = Astro.props;
const useMessageTwikooLazyLoad = false;
---

<ReadingShell title={title} description={title}>
	<section class="r-message" aria-labelledby="message-title">
		<header class="r-message__head r-page-head">
			<h1 id="message-title" class="r-page-title r-page-head__title">留言</h1>
			<p class="r-message__intro r-page-head__note">有什么想说的，或只是路过打个招呼，都可以留在这里。</p>
		</header>
		<div class="r-message__comments">
			<Comments showLinuxDo={false} manualTwikooLoad={useMessageTwikooLazyLoad} />
		</div>
	</section>
</ReadingShell>

<style>
	.r-message__comments,
	.r-message__comments :global(*) {
		--accent-color: var(--r-link);
		--content-bg: var(--r-bg);
		--faint-color: var(--r-ink-faint);
		--field-font: var(--r-font-ui);
		--gray-color: var(--r-ink-soft);
		--heading-color: var(--r-ink);
		--link-color: var(--r-link);
		--paper-card-bg: transparent;
		--paper-card-border: var(--r-rule);
		--paper-card-border-soft: var(--r-rule);
		--paper-card-shadow: none;
		--paper-hover-bg: color-mix(in oklab, var(--r-ink) 5%, transparent);
		--paper-hover-border: var(--r-ink-soft);
		--text-color: var(--r-ink);
	}

	.r-message__comments :global(.comments.single) {
		margin: 0;
	}

	.r-message__comments :global(.twikoo-shell) {
		overflow: visible;
		border: 0;
		border-radius: 0;
		background: transparent;
		box-shadow: none;
	}

	.r-message__comments :global(.twikoo-lazygate) {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		padding: 0.85rem 0;
		border-bottom: 1px solid var(--r-rule);
		font-family: var(--r-font-ui);
		font-size: var(--r-text-sm);
		color: var(--r-ink-soft);
	}

	.r-message__comments :global(.twikoo-lazygate button) {
		cursor: pointer;
		border-radius: 3px;
		border: 1px solid var(--r-rule);
		background: transparent;
		padding: 0.35rem 0.7rem;
		font-family: var(--r-font-ui);
		font-size: var(--r-text-xs);
		color: var(--r-ink);
	}

	.r-message__comments :global(.twikoo-lazygate button:hover) {
		border-color: var(--r-ink-soft);
	}

	.r-message__comments :global(.el-button) {
		border-radius: 3px !important;
		font-family: var(--r-font-ui);
		font-size: var(--r-text-xs) !important;
	}

	.r-message__comments :global(.el-button:not(.el-button--primary):not(.el-button--text)) {
		border-color: var(--r-rule) !important;
		background: transparent !important;
		color: var(--r-ink-soft) !important;
	}

	.r-message__comments :global(.el-button:not(.el-button--primary):not(.el-button--text):hover) {
		border-color: var(--r-ink-soft) !important;
		color: var(--r-ink) !important;
	}

	.r-message__comments :global(.el-button--primary) {
		border-color: var(--r-link) !important;
		background: var(--r-link) !important;
		color: var(--r-bg) !important;
	}

	.r-message__comments :global(.el-button--primary:hover) {
		opacity: 0.9;
	}

	.r-message__comments :global(.el-button--primary.is-disabled) {
		border-color: transparent !important;
		background: color-mix(in oklab, var(--r-link) 38%, var(--r-bg)) !important;
		color: color-mix(in oklab, var(--r-bg) 82%, transparent) !important;
	}

	.r-message__comments :global(.tk-comments-container) {
		border-color: var(--r-rule) !important;
		background: transparent !important;
		color: var(--r-ink) !important;
		box-shadow: none !important;
		font-family: var(--r-font-ui);
	}

	.r-message__comments :global(.tk-submit) {
		border-color: var(--r-card-border, var(--r-memo-border)) !important;
		border-radius: var(--r-card-radius, 6px) !important;
		background: var(--r-card-bg, var(--r-memo-surface)) !important;
		color: var(--r-ink) !important;
		box-shadow: var(--r-card-shadow, none) !important;
		font-family: var(--r-font-ui);
	}

	/* 顶层评论沿用统一纸面卡片：同底色、圆角、描边与轻投影。 */
	.r-message__comments :global(.tk-comments-container > .tk-comment) {
		margin-top: var(--r-space-sm) !important;
		border-radius: var(--r-card-radius, 6px) !important;
		border: 1px solid var(--r-card-border, var(--r-memo-border)) !important;
		background: var(--r-card-bg, var(--r-memo-surface)) !important;
		box-shadow: var(--r-card-shadow, none) !important;
		padding: 0.9rem 1.05rem !important;
	}

	.r-message__comments :global(textarea),
	.r-message__comments :global(input) {
		border-color: transparent !important;
		background: transparent !important;
		color: var(--r-ink) !important;
		box-shadow: none !important;
		font-family: var(--r-font-ui);
	}

	.r-message__comments :global(.tk-meta-input .el-input) {
		border-bottom: 1px solid var(--r-rule) !important;
		background: transparent !important;
		border-radius: 0 !important;
		transition: border-color 0.2s ease;
	}

	.r-message__comments :global(.tk-meta-input .el-input:focus-within) {
		border-bottom-color: var(--r-link) !important;
	}

	.r-message__comments :global(.el-input-group__prepend) {
		border: 0 !important;
		background: transparent !important;
		padding: 0 0.5rem 0 0 !important;
		color: var(--r-ink-soft) !important;
		font-weight: 500;
	}

	.r-message__comments :global(textarea::placeholder),
	.r-message__comments :global(input::placeholder) {
		color: var(--r-ink-faint) !important;
	}
</style>
