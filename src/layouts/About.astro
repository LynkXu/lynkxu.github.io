---
import ReadingShell from './ReadingShell.astro';
import SponsorAbout from '../components/SponsorAbout.astro';
import { AVATAR_IMAGE } from '../consts';

const { title } = Astro.props;
const sectionTitleClass = 'r-section__title !m-0 ![font-family:var(--r-font-ui)] ![font-size:var(--r-text-sm)] !font-semibold !tracking-[0.03em] !text-[var(--r-ink-soft)]';
const pageTitleClass = 'r-page-title !m-0 ![font-family:var(--r-font-body)] ![font-size:var(--r-text-page)] !font-semibold !leading-[var(--r-lh-tight)] !tracking-[-0.018em] !text-[var(--r-ink)]';
const aboutHeadClass = 'r-about__head mb-[var(--r-space-lg)] flex items-center gap-[var(--r-space-md)]';
const aboutAvatarClass = 'r-about__avatar h-16 w-16 shrink-0 rounded-full object-cover';
const aboutNowClass = 'r-about__now m-0 mt-[0.3rem] [font-family:var(--r-font-ui)] [font-size:var(--r-text-sm)] text-[var(--r-ink-soft)]';
const aboutIntroClass = 'r-prose r-about__intro mb-[var(--r-space-lg)] ![font-size:1rem] !leading-[1.75] [&>p]:!mb-[0.75em] [&>p:last-child]:!mb-0';
const traitsClass = 'r-about__traits m-0 mb-[var(--r-space-xl)] flex flex-col gap-[0.55rem] border-0 p-0';
const traitClass = 'r-about__trait grid grid-cols-[2.75rem_minmax(0,1fr)] items-baseline gap-[var(--r-space-md)]';
const traitLabelClass = 'm-0 [font-family:var(--r-font-ui)] [font-size:var(--r-text-xs)] text-[var(--r-ink-faint)]';
const traitValueClass = 'm-0 [font-family:var(--r-font-body)] [font-size:var(--r-text-sm)] leading-[1.5] text-[var(--r-ink-soft)]';
const aboutBlockClass = 'r-about__block mb-[var(--r-space-xl)] last:mb-0 [&_.r-section__head]:mb-[var(--r-space-sm)]';
const aboutLinksClass = 'r-about__links m-0 flex list-none flex-col gap-[0.45rem] p-0 [font-family:var(--r-font-ui)] [font-size:var(--r-text-sm)]';
const aboutLinkClass = 'grid grid-cols-[2.75rem_minmax(0,1fr)] items-baseline gap-[var(--r-space-md)] border-b-0 text-[var(--r-ink-soft)] no-underline hover:text-[var(--r-ink)]';
const aboutLinkLabelClass = 'r-about__link-label [font-size:var(--r-text-xs)] text-[var(--r-ink-faint)]';
const aboutLinkValueClass = 'r-about__link-value break-words text-[var(--r-ink-soft)] group-hover:text-[var(--r-ink)]';
const aboutSponsorClass = 'r-about__sponsor [--accent-color:var(--r-link)] [--heading-color:var(--r-ink)] [--paper-card-bg:var(--r-code-bg)] [--paper-card-border:var(--r-rule)] [--paper-card-border-soft:var(--r-rule)] [--paper-card-shadow:none]';
const aboutHistoryClass = 'r-about__history group [font-family:var(--r-font-ui)] [font-size:var(--r-text-sm)] text-[var(--r-ink-soft)]';
const aboutHistorySummaryClass = 'r-about__history-summary cursor-pointer list-none py-[0.15rem] font-normal text-[var(--r-ink-soft)] marker:hidden hover:text-[var(--r-ink)] [&::-webkit-details-marker]:hidden';
const aboutHistoryListClass = 'm-0 mt-[var(--r-space-sm)] flex list-none flex-col gap-[0.55rem] p-0';
const aboutHistoryItemClass = 'grid grid-cols-[4.5rem_minmax(0,1fr)] items-baseline gap-[var(--r-space-md)]';
const aboutHistoryDateClass = '[font-size:var(--r-text-xs)] text-[var(--r-ink-faint)] [font-variant-numeric:tabular-nums]';
const aboutHistoryTextClass = '[font-family:var(--r-font-body)] leading-[1.55] text-[var(--r-ink-soft)]';

const blogHistory = [
	{ date: '2026.01', text: '购买 lynkxu.com，自建主题，接入 Memos 等数据流' },
	{ date: '2025.06', text: '使用 Astro + Astro Theme Pure' },
	{ date: '2023.06', text: '使用 Gatsby + Breeze Theme' },
	{ date: '2020.09', text: '使用 GitHub Pages + Hexo' },
	{ date: '2018.09', text: '因域名备案问题博客暂停' },
	{ date: '2016.07', text: '购买 linkblog.com + wordpress 开始搭建博客' },
];

const traits = [
	{ label: '日常', value: 'Web3 爱好者 / APP 体验家 / AI 依赖' },
	{ label: '运动', value: '力量训练 / 马拉松 / 骑行 / 散步' },
	{ label: '标签', value: '长期主义 / 混沌中立 / 生人勿近' },
];

const contactLinks = [
	{ href: 'mailto:xulinxiao@live.com', label: '邮箱', value: 'xulinxiao#live.com' },
	{ href: 'https://github.com/LynkXu', label: 'GitHub', value: '@LynkXu', external: true },
];
---

<ReadingShell title={title} description={title}>
	<section class="r-about" aria-labelledby="about-title">
		<header class={aboutHeadClass}>
			<img
				src={AVATAR_IMAGE.src}
				srcset={AVATAR_IMAGE.srcset}
				sizes="64px"
				alt=""
				class={aboutAvatarClass}
				width="64"
				height="64"
				loading="eager"
				decoding="async"
			/>
			<div>
				<h1 id="about-title" class={pageTitleClass}>Hi, I am Lynk</h1>
				<p class={aboutNowClass}>上海 · 全栈工程师</p>
			</div>
		</header>

		<div class={aboutIntroClass}>
			<p>
				一个偏乐观的悲观主义者。一个偏现实的理想主义者。一个想法很多，但却不善表达的人。
			</p>
			<p>很高兴你发现了这里，希望你喜欢我写的内容，也希望你能拥有愉快的一天。</p>
		</div>

		<dl class={traitsClass}>
			{traits.map((trait) => (
				<div class={traitClass}>
					<dt class={traitLabelClass}>{trait.label}</dt>
					<dd class={traitValueClass}>{trait.value}</dd>
				</div>
			))}
		</dl>

		<section class={aboutBlockClass} aria-labelledby="about-contact">
			<header class="r-section__head">
				<h2 id="about-contact" class={sectionTitleClass}>联系</h2>
			</header>
			<ul class={aboutLinksClass}>
				{contactLinks.map((link) => (
					<li>
						<a
							class={`${aboutLinkClass} group`}
							href={link.href}
							target={link.external ? '_blank' : undefined}
							rel={link.external ? 'noopener noreferrer' : undefined}
						>
							<span class={aboutLinkLabelClass}>{link.label}</span>
							<span class={aboutLinkValueClass}>{link.value}</span>
						</a>
					</li>
				))}
			</ul>
		</section>

		<section class={aboutBlockClass} aria-labelledby="about-sponsor">
			<header class="r-section__head">
				<h2 id="about-sponsor" class={sectionTitleClass}>赞助</h2>
			</header>
			<div class={aboutSponsorClass}>
				<SponsorAbout />
			</div>
		</section>

		<section class={aboutBlockClass} aria-labelledby="about-history">
			<header class="r-section__head">
				<h2 id="about-history" class={sectionTitleClass}>博客历程</h2>
			</header>
			<details class={aboutHistoryClass}>
				<summary class={aboutHistorySummaryClass}>展开时间线</summary>
				<ol class={aboutHistoryListClass}>
					{blogHistory.map((item) => (
						<li class={aboutHistoryItemClass}>
							<time class={aboutHistoryDateClass}>{item.date}</time>
							<span class={aboutHistoryTextClass}>{item.text}</span>
						</li>
					))}
				</ol>
			</details>
		</section>
	</section>
</ReadingShell>
