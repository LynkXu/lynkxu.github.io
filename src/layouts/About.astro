---
import ReadingShell from './ReadingShell.astro';
import SponsorAbout from '../components/SponsorAbout.astro';

const { title } = Astro.props;

const headerClass = 'r-about__header mb-[var(--r-space-md)]';
const pageTitleClass = 'r-page-title !m-0 ![font-family:var(--r-font-body)] ![font-size:var(--r-text-display)] !font-semibold !leading-[var(--r-lh-tight)] !tracking-[-0.025em] !text-[var(--r-ink)] max-[640px]:![font-size:var(--r-text-xl)]';
const proseClass = 'r-about__prose r-prose ![font-size:1rem] !leading-[1.82] [&_h3]:!mt-[var(--r-space-lg)] [&_h3]:!mb-[var(--r-space-sm)] [&_h3]:border-0 [&_h3]:border-b [&_h3]:border-[var(--r-divider)] [&_h3]:pb-[var(--r-space-sm)] [&_h3]:![font-family:var(--r-font-ui)] [&_h3]:![font-size:var(--r-text-sm)] [&_h3]:!font-medium [&_h3]:!leading-[1.35] [&_h3]:!tracking-[0.02em] [&_h3]:!text-[var(--r-ink-soft)] [&_p]:!mb-[0.65em] [&_.r-about__closing]:!mt-[var(--r-space-lg)] [&_.r-about__closing]:![font-size:var(--r-text-sm)] [&_.r-about__closing]:!leading-[1.75] [&_.r-about__closing]:!text-[var(--r-ink-faint)]';
const extrasClass = 'r-about__extras mt-[var(--r-space-lg)] border-t border-[var(--r-divider)] pt-[var(--r-space-md)] [font-family:var(--r-font-ui)]';
const extrasTitleClass = '!m-0 !mb-[var(--r-space-xs)] ![font-family:var(--r-font-ui)] ![font-size:var(--r-text-xs)] !font-medium !leading-[1.35] !tracking-[0.02em] !text-[var(--r-ink-faint)]';
const extrasListClass = 'r-about__extras-list flex flex-col gap-[var(--r-space-xs)]';
const historyClass = 'r-about__history group min-w-0';
const historySummaryClass = 'r-about__history-summary cursor-pointer list-none py-[var(--r-space-sm)] [font-size:var(--r-text-sm)] font-medium tracking-[0.01em] text-[var(--r-ink-soft)] marker:hidden hover:text-[var(--r-ink)] [&::-webkit-details-marker]:hidden';
const historyListClass = 'm-0 flex list-none flex-col gap-[0.65rem] px-0 pb-[var(--r-space-md)] pt-[var(--r-space-xs)]';
const historyItemClass = 'grid grid-cols-[4.2rem_minmax(0,1fr)] items-baseline gap-[var(--r-space-md)] [font-size:var(--r-text-xs)] leading-[1.55] max-[420px]:grid-cols-[3.8rem_minmax(0,1fr)] max-[420px]:gap-[var(--r-space-sm)]';
const historyDateClass = 'text-[0.68rem] text-[var(--r-ink-faint)] [font-variant-numeric:tabular-nums]';
const historyTextClass = '[font-family:var(--r-font-body)] text-[var(--r-ink-soft)]';
const sponsorClass = 'r-about__sponsor group min-w-0';
const sponsorSummaryClass = 'r-about__sponsor-summary cursor-pointer list-none py-[var(--r-space-sm)] [font-size:var(--r-text-sm)] font-medium tracking-[0.01em] text-[var(--r-ink-soft)] marker:hidden hover:text-[var(--r-ink)] [&::-webkit-details-marker]:hidden';
const sponsorPanelClass = 'min-w-0 pb-[var(--r-space-md)] pl-[var(--r-space-md)] [--accent-color:var(--r-link)] [--heading-color:var(--r-ink)] [--paper-card-bg:var(--r-bg)] [--paper-card-border:var(--r-rule)] [--paper-card-border-soft:var(--r-rule)] [--paper-card-shadow:none] [&_.sponsor-fold__summary]:![font-size:var(--r-text-xs)]';

const blogHistory = [
	{ date: '2026.01', text: '购买 lynkxu.com，自建主题，接入 Memos 等数据流' },
	{ date: '2025.06', text: '使用 Astro + Astro Theme Pure' },
	{ date: '2023.06', text: '使用 Gatsby + Breeze Theme' },
	{ date: '2020.09', text: '使用 GitHub Pages + Hexo' },
	{ date: '2018.09', text: '因域名备案问题博客暂停' },
	{ date: '2016.07', text: '购买 linkblog.com + WordPress 开始搭建博客' },
];

---

<ReadingShell title={title} description={title}>
	<section class="r-about" aria-labelledby="about-title">
		<header class={headerClass}>
			<h1 id="about-title" class={pageTitleClass}>关于我</h1>
		</header>

		<article class={proseClass}>
			<slot />
		</article>

		<aside class={extrasClass} aria-labelledby="about-more-title">
			<h2 id="about-more-title" class={extrasTitleClass}>附记</h2>
			<div class={extrasListClass}>
				<details class={historyClass}>
					<summary class={historySummaryClass}>博客历史</summary>
					<ol class={historyListClass}>
						{blogHistory.map((item) => (
							<li class={historyItemClass}>
								<time class={historyDateClass}>{item.date}</time>
								<span class={historyTextClass}>{item.text}</span>
							</li>
						))}
					</ol>
				</details>
				<details class={sponsorClass}>
					<summary class={sponsorSummaryClass}>赞助</summary>
					<div class={sponsorPanelClass}>
						<SponsorAbout />
					</div>
				</details>
			</div>
		</aside>
	</section>
</ReadingShell>
