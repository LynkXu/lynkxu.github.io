---
import ReadingShell from './ReadingShell.astro';
import SponsorAbout from '../components/SponsorAbout.astro';
import AboutTraits from '../components/AboutTraits.astro';

const { title } = Astro.props;

const pageTitleClass = 'r-page-title !m-0 ![font-family:var(--r-font-body)] ![font-size:var(--r-text-page)] !font-semibold !leading-[var(--r-lh-tight)] !tracking-[-0.018em] !text-[var(--r-ink-strong,var(--r-ink))]';
const proseClass = 'r-about__prose r-prose md-theme [&_.r-about__closing]:!mt-[var(--r-space-lg)] [&_.r-about__closing]:![font-size:var(--r-text-sm)] [&_.r-about__closing]:!leading-[1.75] [&_.r-about__closing]:!text-[var(--r-ink-faint)]';
const extrasClass = 'r-about__extras [font-family:var(--r-font-body)]';
const extrasTitleClass = 'r-prose-section-title md-section-heading';
const extrasListClass = 'r-about__extras-list flex flex-col gap-[var(--r-space-xs)]';
const historyClass = 'r-about__history group min-w-0';
const historySummaryClass = 'r-about__history-summary cursor-pointer list-none py-[var(--r-space-sm)] [font-family:var(--r-font-body)] [font-size:1rem] font-normal text-[var(--r-ink)] marker:hidden hover:text-[var(--r-link)] [&::-webkit-details-marker]:hidden';
const historyListClass = 'm-0 flex list-none flex-col gap-[var(--r-space-sm)] px-0 pb-[var(--r-space-md)] pt-[var(--r-space-sm)]';
const historyItemClass = 'grid grid-cols-[4.2rem_minmax(0,1fr)] items-baseline gap-[var(--r-space-md)] [font-size:0.96rem] leading-[1.82] max-[420px]:grid-cols-[3.8rem_minmax(0,1fr)] max-[420px]:gap-[var(--r-space-sm)]';
const historyDateClass = '[font-family:var(--r-font-ui)] [font-size:var(--r-text-xs)] text-[var(--r-ink-faint)] [font-variant-numeric:tabular-nums]';
const historyTextClass = '[font-family:var(--r-font-body)] text-[var(--r-ink-soft)]';
const sponsorClass = 'r-about__sponsor group min-w-0';
const sponsorSummaryClass = 'r-about__sponsor-summary cursor-pointer list-none py-[var(--r-space-sm)] [font-family:var(--r-font-body)] [font-size:1rem] font-normal text-[var(--r-ink)] marker:hidden hover:text-[var(--r-link)] [&::-webkit-details-marker]:hidden';
const sponsorPanelClass = 'min-w-0 pb-[var(--r-space-md)] pt-[var(--r-space-xs)] pl-[var(--r-space-md)] [--accent-color:var(--r-link)] [--heading-color:var(--r-ink)] [--paper-card-bg:var(--r-bg)] [--paper-card-border:var(--r-rule)] [--paper-card-border-soft:var(--r-rule)] [--paper-card-shadow:none]';

const blogHistory = [
	{ date: '2026.01', text: '购买 lynkxu.com，自建主题，接入 Memos 等数据流' },
	{ date: '2025.06', text: '使用 Astro + Astro Theme Pure' },
	{ date: '2023.06', text: '使用 Gatsby + Breeze Theme' },
	{ date: '2020.09', text: '使用 GitHub Pages + Hexo' },
	{ date: '2018.09', text: '因域名备案问题博客暂停' },
	{ date: '2016.07', text: '购买 linkblog.com + WordPress 开始搭建博客' },
];

---

<ReadingShell title={title} description={title}>
	<section class="r-about r-card r-card--reading" aria-labelledby="about-title">
		<header class="r-about__header">
			<div class="r-about__identity">
				<h1 id="about-title" class={pageTitleClass}>关于我</h1>
				<div class="r-about__traits-wrap">
					<AboutTraits variant="inline" />
				</div>
			</div>
			<img class="r-about__portrait" src="/avatar-224.webp" width="224" height="224" alt="Lynk 的个人头像" />
		</header>

		<article class={proseClass}>
			<slot />
		</article>

		<aside class={extrasClass} aria-labelledby="about-more-title">
			<h3 id="about-more-title" class={extrasTitleClass}><span class="md-heading-label">附记</span></h3>
			<div class={extrasListClass}>
				<details class={historyClass}>
					<summary class={historySummaryClass}>博客历史</summary>
					<ol class={historyListClass}>
						{blogHistory.map((item) => (
							<li class={historyItemClass}>
								<time class={historyDateClass}>{item.date}</time>
								<span class={historyTextClass}>{item.text}</span>
							</li>
						))}
					</ol>
				</details>
				<details class={sponsorClass}>
					<summary class={sponsorSummaryClass}>赞助</summary>
					<div class={sponsorPanelClass}>
						<SponsorAbout />
					</div>
				</details>
			</div>
		</aside>

		<div class="r-about__colophon" role="region" aria-label="版权与创作说明">
			<div class="r-about__colophon-text">
				<p class="r-about__colophon-main">本站文字均为人工撰写，欢迎署名转载，请勿商用。</p>
				<p class="r-about__colophon-note">部分文章插图与封面图可能由 AI 生成。</p>
			</div>

			<div class="r-about__badges">
				<a
					class="r-about__cc"
					href="/copyright"
					aria-label="CC BY-NC 4.0 版权说明"
					title="CC BY-NC 4.0（署名-非商业性使用）"
				>
					<svg viewBox="5.5 -3.5 64 64" width="19" height="19" aria-hidden="true" focusable="false">
						<path fill="currentColor" d="M37.441-3.5c8.951,0,16.572,3.125,22.857,9.372c3.008,3.009,5.295,6.448,6.857,10.314c1.561,3.867,2.344,7.971,2.344,12.314c0,4.381-0.773,8.486-2.314,12.313c-1.543,3.828-3.82,7.21-6.828,10.143c-3.123,3.085-6.666,5.448-10.629,7.086c-3.961,1.638-8.057,2.457-12.285,2.457s-8.276-0.808-12.143-2.429c-3.866-1.618-7.333-3.961-10.4-7.027c-3.067-3.066-5.4-6.524-7-10.372S5.5,32.767,5.5,28.5c0-4.229,0.809-8.295,2.428-12.2c1.619-3.905,3.972-7.4,7.057-10.486C21.08-0.394,28.565-3.5,37.441-3.5z M37.557,2.272c-7.314,0-13.467,2.553-18.458,7.657c-2.515,2.553-4.448,5.419-5.8,8.6c-1.354,3.181-2.029,6.505-2.029,9.972c0,3.429,0.675,6.734,2.029,9.913c1.353,3.183,3.285,6.021,5.8,8.516c2.514,2.496,5.351,4.399,8.515,5.715c3.161,1.314,6.476,1.971,9.943,1.971c3.428,0,6.75-0.665,9.973-1.999c3.219-1.335,6.121-3.257,8.713-5.771c4.99-4.876,7.484-10.99,7.484-18.344c0-3.543-0.648-6.895-1.943-10.057c-1.293-3.162-3.18-5.98-5.654-8.458C50.984,4.844,44.795,2.272,37.557,2.272z M37.156,23.187l-4.287,2.229c-0.458-0.951-1.019-1.619-1.685-2c-0.667-0.38-1.286-0.571-1.858-0.571c-2.856,0-4.286,1.885-4.286,5.657c0,1.714,0.362,3.084,1.085,4.113c0.724,1.029,1.791,1.544,3.201,1.544c1.867,0,3.181-0.915,3.944-2.743l3.942,2c-0.838,1.563-2,2.791-3.486,3.686c-1.484,0.896-3.123,1.343-4.914,1.343c-2.857,0-5.163-0.875-6.915-2.629c-1.752-1.752-2.628-4.19-2.628-7.313c0-3.048,0.886-5.466,2.657-7.257c1.771-1.79,4.009-2.686,6.715-2.686C32.604,18.558,35.441,20.101,37.156,23.187z M55.613,23.187l-4.229,2.229c-0.457-0.951-1.02-1.619-1.686-2c-0.668-0.38-1.307-0.571-1.914-0.571c-2.857,0-4.287,1.885-4.287,5.657c0,1.714,0.363,3.084,1.086,4.113c0.723,1.029,1.789,1.544,3.201,1.544c1.865,0,3.18-0.915,3.941-2.743l4,2c-0.875,1.563-2.057,2.791-3.541,3.686c-1.486,0.896-3.105,1.343-4.857,1.343c-2.896,0-5.209-0.875-6.941-2.629c-1.736-1.752-2.602-4.19-2.602-7.313c0-3.048,0.885-5.466,2.658-7.257c1.77-1.79,4.008-2.686,6.713-2.686C51.117,18.558,53.938,20.101,55.613,23.187z" />
					</svg>
					<svg viewBox="5.5 -3.5 64 64" width="19" height="19" aria-hidden="true" focusable="false">
						<path fill="currentColor" d="M37.443-3.5c8.988,0,16.57,3.085,22.742,9.257C66.393,11.967,69.5,19.548,69.5,28.5c0,8.991-3.049,16.476-9.145,22.456C53.879,57.319,46.242,60.5,37.443,60.5c-8.649,0-16.153-3.144-22.514-9.43C8.644,44.784,5.5,37.262,5.5,28.5c0-8.761,3.144-16.342,9.429-22.742C21.101-0.415,28.604-3.5,37.443-3.5z M37.557,2.272c-7.276,0-13.428,2.553-18.457,7.657c-5.22,5.334-7.829,11.525-7.829,18.572c0,7.086,2.59,13.22,7.77,18.398c5.181,5.182,11.352,7.771,18.514,7.771c7.123,0,13.334-2.607,18.629-7.828c5.029-4.838,7.543-10.952,7.543-18.343c0-7.276-2.553-13.465-7.656-18.571C50.967,4.824,44.795,2.272,37.557,2.272z M46.129,20.557v13.085h-3.656v15.542h-9.944V33.643h-3.656V20.557c0-0.572,0.2-1.057,0.599-1.457c0.401-0.399,0.887-0.6,1.457-0.6h13.144c0.533,0,1.01,0.2,1.428,0.6C45.918,19.5,46.129,19.986,46.129,20.557z M33.042,12.329c0-3.008,1.485-4.514,4.458-4.514s4.457,1.504,4.457,4.514c0,2.971-1.486,4.457-4.457,4.457S33.042,15.3,33.042,12.329z" />
					</svg>
					<svg viewBox="5.5 -3.5 64 64" width="19" height="19" aria-hidden="true" focusable="false">
						<path fill="currentColor" d="M37.442-3.5c8.99,0,16.571,3.085,22.743,9.256C66.393,11.928,69.5,19.509,69.5,28.5c0,8.992-3.048,16.476-9.145,22.458C53.88,57.32,46.241,60.5,37.442,60.5c-8.686,0-16.19-3.162-22.513-9.485C8.644,44.728,5.5,37.225,5.5,28.5c0-8.762,3.144-16.343,9.429-22.743C21.1-0.414,28.604-3.5,37.442-3.5z M12.7,19.872c-0.952,2.628-1.429,5.505-1.429,8.629c0,7.086,2.59,13.22,7.77,18.4c5.219,5.144,11.391,7.715,18.514,7.715c7.201,0,13.409-2.608,18.63-7.829c1.867-1.79,3.332-3.657,4.398-5.602l-12.056-5.371c-0.421,2.02-1.439,3.667-3.057,4.942c-1.622,1.276-3.535,2.011-5.744,2.2v4.915h-3.714v-4.915c-3.543-0.036-6.782-1.312-9.714-3.827l4.4-4.457c2.094,1.942,4.476,2.913,7.143,2.913c1.104,0,2.048-0.246,2.83-0.743c0.78-0.494,1.172-1.312,1.172-2.457c0-0.801-0.287-1.448-0.858-1.943l-3.085-1.315l-3.771-1.715l-5.086-2.229L12.7,19.872z M37.557,2.214c-7.276,0-13.428,2.571-18.457,7.714c-1.258,1.258-2.439,2.686-3.543,4.287L27.786,19.7c0.533-1.676,1.542-3.019,3.029-4.028c1.484-1.009,3.218-1.571,5.2-1.686V9.071h3.715v4.915c2.934,0.153,5.6,1.143,8,2.971l-4.172,4.286c-1.793-1.257-3.619-1.885-5.486-1.885c-0.991,0-1.876,0.191-2.656,0.571c-0.781,0.381-1.172,1.029-1.172,1.943c0,0.267,0.095,0.533,0.285,0.8l4.057,1.83l2.8,1.257l5.144,2.285l16.397,7.314c0.535-2.248,0.801-4.533,0.801-6.857c0-7.353-2.552-13.543-7.656-18.573C51.005,4.785,44.831,2.214,37.557,2.214z" />
					</svg>
				</a>

				<span class="r-about__badge-sep" aria-hidden="true"></span>

				<a
					class="r-about__notbyai"
					href="https://notbyai.fyi/"
					target="_blank"
					rel="noopener noreferrer"
					aria-label="Written by Humans, Not by AI"
					title="Written by Humans, Not by AI"
				>
					<img
						class="r-about__notbyai-img r-about__notbyai-img--light"
						src="/badges/written-by-human-not-by-ai-white.svg"
						alt="Written by Humans, Not by AI"
						width="100"
						height="32"
						loading="lazy"
						decoding="async"
					/>
					<img
						class="r-about__notbyai-img r-about__notbyai-img--dark"
						src="/badges/written-by-human-not-by-ai-black.svg"
						alt="Written by Humans, Not by AI"
						width="100"
						height="32"
						loading="lazy"
						decoding="async"
					/>
				</a>
			</div>
		</div>
	</section>
</ReadingShell>

<style>
	/* 方案一：卡内作者抬头（左文右头像 + 细线进正文） */
	.r-about__header {
		--r-traits-gap: 0px;
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		column-gap: clamp(1.25rem, 3.5vw, 2rem);
		align-items: center;
		padding-bottom: clamp(1.25rem, 3vw, 1.65rem);
		margin-bottom: clamp(1.35rem, 3.2vw, 1.85rem);
		border-bottom: 1px solid var(--r-divider);
	}

	.r-about__identity {
		min-width: 0;
	}

	.r-about__traits-wrap {
		--r-traits-gap: 0px;
		margin-top: 0.5rem;
	}

	.r-about__traits-wrap :global(.r-about__traits) {
		row-gap: 0.22rem !important;
	}

	.r-about__traits-wrap :global(.r-about__traits li) {
		font-size: 0.76rem !important;
		line-height: 1.55 !important;
		color: var(--r-ink-faint) !important;
	}

	.r-about__portrait {
		width: 4.15rem;
		height: 4.15rem;
		aspect-ratio: 1;
		object-fit: cover;
		padding: 3px;
		border-radius: 50%;
		background: var(--r-card-bg, var(--r-bg));
		border: 1px solid color-mix(in oklab, var(--r-ink) 11%, transparent);
		box-shadow: 0 2px 8px rgba(15, 23, 42, 0.04);
		box-sizing: border-box;
		flex-shrink: 0;
	}

	:global(:root[data-theme="dark"]) .r-about__portrait {
		filter: brightness(0.86) contrast(1.04);
		border-color: color-mix(in oklab, var(--r-ink) 16%, transparent);
		box-shadow: 0 2px 8px rgba(0, 0, 0, 0.26);
	}

	@media (prefers-color-scheme: dark) {
		:global(:root:not([data-theme])) .r-about__portrait {
			filter: brightness(0.86) contrast(1.04);
			border-color: color-mix(in oklab, var(--r-ink) 16%, transparent);
			box-shadow: 0 2px 8px rgba(0, 0, 0, 0.26);
		}
	}

	@media (max-width: 640px) {
		.r-about__header {
			column-gap: var(--space-md);
			align-items: start;
			padding-bottom: 1.1rem;
			margin-bottom: 1.2rem;
		}

		.r-about__portrait {
			width: 3.35rem;
			height: 3.35rem;
			padding: 2px;
		}
	}

	.r-about__colophon {
		margin: var(--r-space-lg) 0 0;
		padding: var(--r-space-md) 0 0;
		border-top: 1px solid var(--r-divider);
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--r-space-md);
	}

	.r-about__colophon-text {
		min-width: 0;
		display: flex;
		flex-direction: column;
		gap: 0.16rem;
	}

	.r-about__colophon-main {
		margin: 0;
		font-family: var(--r-font-body);
		font-size: 0.85rem;
		line-height: 1.65;
		color: var(--r-ink-soft);
		text-wrap: pretty;
	}

	.r-about__colophon-note {
		margin: 0;
		font-family: var(--r-font-ui);
		font-size: var(--r-text-xs);
		line-height: 1.55;
		color: var(--r-ink-faint);
		text-wrap: pretty;
	}

	.r-about__badges {
		flex: 0 0 auto;
		display: inline-flex;
		align-items: center;
		gap: 0.65rem;
	}

	.r-about__cc {
		display: inline-flex;
		align-items: center;
		gap: 0.22rem;
		padding: 0.2rem 0;
		border: 0 !important;
		text-decoration: none !important;
		color: var(--r-ink-soft);
		opacity: 0.78;
		transition: color 0.2s ease, opacity 0.2s ease;
	}

	.r-about__cc svg {
		display: block;
		width: 19px;
		height: 19px;
	}

	.r-about__cc:hover {
		color: var(--r-link);
		opacity: 1;
	}

	.r-about__badge-sep {
		width: 1px;
		height: 1rem;
		background: var(--r-rule);
		opacity: 0.85;
	}

	.r-about__notbyai {
		display: inline-flex;
		align-items: center;
		border: 0 !important;
		text-decoration: none !important;
		opacity: 0.72;
		transition: opacity 0.2s ease;
	}

	.r-about__notbyai:hover {
		opacity: 1;
	}

	.r-about__notbyai-img {
		display: block;
		height: 32px;
		width: auto;
	}

	.r-about__notbyai-img--dark {
		display: none;
	}

	:global(:root[data-theme="dark"]) .r-about__notbyai {
		opacity: 0.78;
	}

	:global(:root[data-theme="dark"]) .r-about__notbyai:hover {
		opacity: 1;
	}

	:global(:root[data-theme="dark"]) .r-about__notbyai-img--light {
		display: none;
	}

	:global(:root[data-theme="dark"]) .r-about__notbyai-img--dark {
		display: block;
	}

	@media (prefers-color-scheme: dark) {
		:global(:root:not([data-theme])) .r-about__notbyai {
			opacity: 0.78;
		}

		:global(:root:not([data-theme])) .r-about__notbyai:hover {
			opacity: 1;
		}

		:global(:root:not([data-theme])) .r-about__notbyai-img--light {
			display: none;
		}

		:global(:root:not([data-theme])) .r-about__notbyai-img--dark {
			display: block;
		}
	}

	.r-about__cc:focus-visible,
	.r-about__notbyai:focus-visible {
		outline: 2px solid var(--r-link);
		outline-offset: 3px;
		border-radius: 3px;
	}

	@media (max-width: 600px) {
		.r-about__colophon {
			flex-direction: column;
			align-items: flex-start;
			gap: var(--r-space-sm);
		}

		.r-about__colophon-main {
			font-size: 0.83rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.r-about__cc,
		.r-about__notbyai {
			transition: none;
		}
	}
</style>
