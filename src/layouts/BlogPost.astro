---
import type { MarkdownHeading } from 'astro';
import type { CollectionEntry } from 'astro:content';
import ReadingShell from './ReadingShell.astro';
import FormattedDate from '../components/FormattedDate.astro';
import NavButton from '../components/NavButton.astro';
import Changelog from '../components/Changelog.astro';
import LikeButton from '../components/LikeButton.astro';

type Props = CollectionEntry<'blog'>['data'] & {
	excerpt?: string;
	postId?: string;
	headings?: MarkdownHeading[];
	showTOC?: boolean;
	tocMinLevel?: number;
	tocMaxLevel?: number;
	readingTime?: number;
};

const {
	title,
	description,
	excerpt,
	pubDate,
	updatedDate,
	tags,
	categories,
	draft,
	changelog,
	postId,
	headings = [],
	showTOC = true,
	tocMinLevel = 2,
	tocMaxLevel = 3,
	readingTime,
} = Astro.props;

const isDev = import.meta.env.DEV;
const topicLabels = tags?.length
	? tags
	: categories?.length
		? categories
		: [];
const topicLinksEnabled = Boolean(tags?.length);

const tocHeadings = headings.filter((h) => h.depth >= tocMinLevel && h.depth <= tocMaxLevel);
const topLevelCount = tocHeadings.filter((h) => h.depth === tocMinLevel).length;
const shouldRenderTOC = showTOC && tocHeadings.length > 0;
---

<ReadingShell title={title} description={description || excerpt || ''}>
	<link rel="stylesheet" href="/lightgallery/css/lightgallery.min.css" slot="head" />

	<article class="r-article r-card r-card--reading">
		<header class="r-article__header">
			<h1 class="r-page-title r-article__title">{title}</h1>

			<div class="r-meta">
				<span><FormattedDate date={pubDate} /></span>
				{topicLabels.map((label) => (
					topicLinksEnabled ? (
						<a href={`/tags/${label}/`} class="r-meta__link">{label}</a>
					) : (
						<span>{label}</span>
					)
				))}
				{readingTime && <span>{readingTime} min</span>}
				{updatedDate && (
					<span>更新于 <FormattedDate date={updatedDate} /></span>
				)}
				{isDev && draft && <span class="r-draft !ml-0">草稿</span>}
			</div>

			{description && <p class="r-article__desc">{description}</p>}
		</header>

		<div class="r-prose md-theme post-content content" id="lightgallery">
			<slot />
		</div>

		<footer class="r-article__tail">
			<div class="r-article__end" aria-hidden="true"></div>
			<LikeButton id={postId || Astro.url.pathname} type="post" />
			{changelog && changelog.length > 0 && <Changelog entries={changelog} />}
		</footer>

		<NavButton
			headings={shouldRenderTOC ? tocHeadings : []}
			tocMinLevel={tocMinLevel}
			tocMaxLevel={tocMaxLevel}
			topLevelCount={topLevelCount}
		/>
	</article>

	<script is:inline src="/lightgallery/js/lightgallery.min.js" defer></script>
</ReadingShell>

<style>
	.r-article__title {
		margin: 0 0 var(--r-space-sm) !important;
		font-family: var(--r-font-body) !important;
		font-size: var(--r-text-display) !important;
		font-weight: 600 !important;
		line-height: 1.22 !important;
		letter-spacing: -0.025em !important;
		color: var(--r-ink-strong, var(--r-ink)) !important;
	}

	.r-meta {
		margin-bottom: 0;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem 0.85rem;
		font-family: var(--r-font-ui);
		font-size: var(--r-text-xs);
		color: var(--r-ink-faint);
	}

	.r-meta__link {
		border-bottom: 0;
		color: var(--r-ink-soft);
		text-decoration: underline;
		text-decoration-color: transparent;
		text-decoration-thickness: 1px;
		text-underline-offset: var(--r-link-underline-offset);
		transition: color 0.2s ease, text-decoration-color 0.2s ease;
	}

	.r-meta__link:hover {
		color: var(--r-link);
		text-decoration-color: var(--r-link-underline-color);
	}

	.r-article__desc {
		margin: var(--r-space-sm) 0 0;
		font-family: var(--r-font-body);
		font-size: 1rem;
		line-height: 1.7;
		color: var(--r-ink-soft);
	}

	.r-article__tail {
		margin-top: var(--r-space-lg);
		padding-top: var(--r-space-md);
		border-top: 0;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--r-space-md);
	}

	.r-article__end {
		height: 1px;
		width: 2rem;
		background: var(--r-rule);
	}

	.r-article__tail :global(.changelog) {
		align-self: stretch;
		text-align: left;
		font-family: var(--r-font-ui);
		color: var(--r-ink-soft);
		--accent-color: var(--r-link);
		--ink-accent: var(--r-ink-faint);
		--serif-font: var(--r-font-ui);
	}

	.r-article__tail :global(.changelog *) {
		--accent-color: var(--r-link);
		--ink-accent: var(--r-ink-faint);
		--serif-font: var(--r-font-ui);
	}

	.r-article {
		position: relative;
		--dock-gap: var(--space-md);
	}

	@media (min-width: 1280px) {
		.r-article {
			--dock-gap: var(--space-lg);
		}
	}

	/* 881px–1059px：目录按钮仍贴近正文白卡右侧外沿，避免漂到视口角落 */
	@media (min-width: 881px) and (max-width: 1059px) {
		.r-article :global(.reading-dock) {
			left: calc(50% + var(--portal-content-width, 43.75rem) / 2 + var(--dock-gap));
			right: auto;
			bottom: var(--r-space-xl);
			align-items: flex-start;
		}
	}
</style>

<script>
	// 1. LightGallery for article prose images
	function initLightGallery() {
		const postContent = document.querySelector('.post-content');
		const container = document.getElementById('lightgallery');
		const lg = (window as any).lightGallery;
		if (!postContent || !container || typeof lg !== 'function') return;
		if (container.getAttribute('data-lg-ready') === 'true') return;
		container.setAttribute('data-lg-ready', 'true');

		const images = postContent.querySelectorAll('img');
		images.forEach((img) => {
			if (img.closest('.link-card') || img.parentElement?.tagName === 'A') return;
			const link = document.createElement('a');
			link.href = img.src;
			link.className = 'no-link';
			link.setAttribute('data-sub-html', img.alt || '');
			img.parentNode?.insertBefore(link, img);
			link.appendChild(img);
		});

		lg(container, {
			selector: 'a[href$=".jpg"], a[href$=".jpeg"], a[href$=".png"], a[href$=".gif"], a[href$=".webp"]',
			mode: 'lg-fade',
			cssEasing: 'ease',
			speed: 600,
			hideBarsDelay: 2000,
			controls: true,
			download: true,
			counter: true,
			thumbnail: true,
		});
	}

	function waitForLightGallery(attempts = 0) {
		if (typeof (window as any).lightGallery === 'function') {
			initLightGallery();
		} else if (attempts < 40) {
			window.setTimeout(() => waitForLightGallery(attempts + 1), 100);
		}
	}

	// 2. Code block language badge & copy button
	const COPY_ICON =
		'<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>';
	const CHECK_ICON =
		'<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>';

	function resolveLang(block: HTMLElement, code: HTMLElement | null) {
		if (block.dataset.language) return block.dataset.language.trim();
		if (!code) return '';
		const langClass = code.className.split(/\s+/).find((c) => c.startsWith('language-'));
		return langClass ? langClass.replace('language-', '') : '';
	}

	function enhanceCodeBlocks() {
		const codeBlocks = document.querySelectorAll<HTMLElement>('.r-article pre:not(.code-block-added)');
		codeBlocks.forEach((block) => {
			block.classList.add('code-block-added');
			const wrapper = document.createElement('div');
			wrapper.className = 'code-wrapper';
			if (block.parentNode) {
				block.parentNode.insertBefore(wrapper, block);
				wrapper.appendChild(block);
			}

			const header = document.createElement('div');
			header.className = 'code-header';

			const code = block.querySelector('code');
			const lang = resolveLang(block, code);
			if (lang) {
				const langLabel = document.createElement('span');
				langLabel.className = 'code-lang';
				langLabel.textContent = lang;
				header.appendChild(langLabel);
			}

			const copyBtn = document.createElement('button');
			copyBtn.type = 'button';
			copyBtn.className = 'copy-btn';
			copyBtn.setAttribute('aria-label', '复制代码');
			copyBtn.innerHTML = COPY_ICON;
			copyBtn.addEventListener('click', async () => {
				try {
					if (!code) return;
					await navigator.clipboard.writeText(code.innerText);
					copyBtn.innerHTML = CHECK_ICON;
					copyBtn.classList.add('copied');
					copyBtn.setAttribute('aria-label', '已复制');
					window.setTimeout(() => {
						copyBtn.innerHTML = COPY_ICON;
						copyBtn.classList.remove('copied');
						copyBtn.setAttribute('aria-label', '复制代码');
					}, 1800);
				} catch (err) {
					console.error('Copy failed:', err);
				}
			});
			header.appendChild(copyBtn);
			wrapper.insertBefore(header, block);
		});
	}

	// 3. Fallback client hydration only for LinkCards not pre-rendered at build time
	async function hydrateUncachedLinkCards() {
		const cards = document.querySelectorAll<HTMLElement>('.link-card[data-url]:not(.link-card--ready)');
		if (cards.length === 0) return;

		const LS_KEY = 'linkcard:cache';
		const CACHE_TTL = 7 * 24 * 60 * 60 * 1000;

		const readCache = (url: string) => {
			try {
				const cache = JSON.parse(localStorage.getItem(LS_KEY) || '{}');
				const entry = cache?.[url];
				if (!entry || Date.now() - (entry._ts || 0) > CACHE_TTL) return null;
				return entry;
			} catch {
				return null;
			}
		};

		const writeCache = (url: string, data: { title: string; description: string; image: string }) => {
			try {
				const cache = JSON.parse(localStorage.getItem(LS_KEY) || '{}');
				cache[url] = { ...data, _ts: Date.now() };
				localStorage.setItem(LS_KEY, JSON.stringify(cache));
			} catch {
				// ignore
			}
		};

		const renderCard = (el: HTMLElement, url: string, meta: { title?: string; description?: string; image?: string }) => {
			if (!meta?.title) return;
			const style =
				el.dataset.style ||
				(el.classList.contains('link-card--cover')
					? 'cover'
					: el.classList.contains('link-card--minimal')
						? 'minimal'
						: 'default');
			const hostname = (() => {
				try {
					return new URL(url).hostname;
				} catch {
					return url;
				}
			})();

			const anchor = document.createElement('a');
			anchor.href = url;
			anchor.target = '_blank';
			anchor.rel = 'noopener noreferrer';
			anchor.className = 'link-card__content';

			if (meta.image && style !== 'minimal') {
				const imgWrap = document.createElement('div');
				imgWrap.className = 'link-card__image-wrapper';
				const img = document.createElement('img');
				img.src = meta.image;
				img.alt = '';
				img.loading = 'lazy';
				img.decoding = 'async';
				img.onerror = () => {
					imgWrap.style.display = 'none';
				};
				imgWrap.appendChild(img);
				anchor.appendChild(imgWrap);
			}

			const body = document.createElement('div');
			body.className = 'link-card__body';
			const heading = document.createElement('span');
			heading.className = 'link-card__title';
			heading.textContent = meta.title;
			body.appendChild(heading);

			if (meta.description && style !== 'minimal') {
				const desc = document.createElement('p');
				desc.textContent = meta.description;
				body.appendChild(desc);
			}

			const host = document.createElement('span');
			host.className = 'link-card__host';
			host.textContent = hostname;
			body.appendChild(host);

			anchor.appendChild(body);
			el.replaceChildren(anchor);
			el.classList.add('link-card--ready');
		};

		for (const el of cards) {
			const url = el.getAttribute('data-url');
			if (!url) continue;
			const cached = readCache(url);
			if (cached?.title) {
				renderCard(el, url, cached);
				continue;
			}
			try {
				const controller = new AbortController();
				const timeout = window.setTimeout(() => controller.abort(), 5000);
				const res = await fetch(`https://api.microlink.io/?url=${encodeURIComponent(url)}`, {
					signal: controller.signal,
				});
				window.clearTimeout(timeout);
				if (!res.ok) continue;
				const json = await res.json();
				const data = json?.data;
				if (!data?.title) continue;
				const meta = {
					title: data.title || '',
					description: data.description || '',
					image: data.image?.url || '',
				};
				writeCache(url, meta);
				renderCard(el, url, meta);
			} catch {
				// Keep SSR fallback link
			}
		}
	}

	function initArticle() {
		enhanceCodeBlocks();
		waitForLightGallery();
		hydrateUncachedLinkCards();
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initArticle, { once: true });
	} else {
		initArticle();
	}
</script>
