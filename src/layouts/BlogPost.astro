---
import type { CollectionEntry } from 'astro:content';
import ReadingShell from './ReadingShell.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Toc from '../components/Toc.astro';
import NavButton from '../components/NavButton.astro';
import Changelog from '../components/Changelog.astro';
import LikeButton from '../components/LikeButton.astro';

type Props = CollectionEntry<'blog'>['data'] & {
	postId?: string;
	showTOC?: boolean;
	tocMinLevel?: number;
	tocMaxLevel?: number;
	readingTime?: number;
};

const {
	title,
	description,
	pubDate,
	updatedDate,
	tags,
	categories,
	draft,
	changelog,
	postId,
	showTOC = true,
	tocMinLevel = 2,
	tocMaxLevel = 3,
	readingTime,
} = Astro.props;

const isDev = import.meta.env.DEV;
const topicLabels = tags?.length
	? tags
	: categories?.length
		? categories
		: [];
const topicLinksEnabled = Boolean(tags?.length);
const articleClass = [
	'r-article',
	'[&_.code-wrapper]:relative [&_.code-wrapper]:my-[1.25rem] [&_.code-wrapper]:overflow-hidden [&_.code-wrapper]:rounded-[4px] [&_.code-wrapper]:bg-[var(--r-code-bg)]',
	'[&_.code-header]:absolute [&_.code-header]:right-0 [&_.code-header]:top-0 [&_.code-header]:z-[2] [&_.code-header]:flex [&_.code-header]:items-center [&_.code-header]:gap-[0.5rem] [&_.code-header]:px-[0.55rem] [&_.code-header]:py-[0.35rem]',
	'[&_.code-lang]:[font-family:var(--r-font-code)] [&_.code-lang]:[font-size:0.7rem] [&_.code-lang]:text-[var(--r-ink-faint)]',
	'[&_.copy-btn]:cursor-pointer [&_.copy-btn]:border-0 [&_.copy-btn]:bg-transparent [&_.copy-btn]:p-[2px] [&_.copy-btn]:text-[var(--r-ink-faint)] [&_.copy-btn]:opacity-55 [&_.copy-btn:focus-visible]:opacity-100 [&_.code-wrapper:hover_.copy-btn]:opacity-100',
	'[&_.code-wrapper_pre]:!m-0 [&_.code-wrapper_pre]:!rounded-none [&_.code-wrapper_pre]:!bg-transparent [&_.code-wrapper_pre]:!px-[1rem] [&_.code-wrapper_pre]:!pb-[1rem] [&_.code-wrapper_pre]:!pt-[1.5rem]',
	'[&_.nav-buttons-group]:fixed [&_.nav-buttons-group]:bottom-[var(--r-space-lg)] [&_.nav-buttons-group]:right-[var(--r-page-inline)] [&_.nav-buttons-group]:z-20',
	'[&_.nav-button]:inline-flex [&_.nav-button]:h-auto [&_.nav-button]:min-h-9 [&_.nav-button]:w-auto [&_.nav-button]:min-w-9 [&_.nav-button]:cursor-pointer [&_.nav-button]:items-center [&_.nav-button]:justify-center [&_.nav-button]:rounded-none [&_.nav-button]:border-0 [&_.nav-button]:bg-transparent [&_.nav-button]:p-[var(--space-2xs)] [&_.nav-button]:text-[var(--r-ink-soft)] [&_.nav-button]:shadow-none [&_.nav-button]:backdrop-blur-none [&_.nav-button:hover]:translate-y-0 [&_.nav-button:hover]:bg-transparent [&_.nav-button:hover]:text-[var(--r-ink)] [&_.nav-button_svg]:block [&_.nav-button_svg]:h-[18px] [&_.nav-button_svg]:w-[18px]',
	'[&_.link-card]:my-[var(--r-space-lg)] [&_.link-card]:overflow-hidden [&_.link-card]:rounded-[4px] [&_.link-card]:border [&_.link-card]:border-[var(--r-rule)] [&_.link-card]:bg-transparent [&_.link-card]:shadow-none [&_.link-card:hover]:translate-y-0 [&_.link-card:hover]:bg-transparent [&_.link-card:hover]:shadow-none [&_.link-card_a]:text-inherit [&_.link-card_a]:no-underline',
	'[&_.link-card__content]:flex [&_.link-card__content]:w-full [&_.link-card__content]:items-stretch [&_.link-card__content]:gap-0 [&_.link-card__content]:border-b-0 [&_.link-card__content]:text-inherit [&_.link-card__content]:no-underline max-[640px]:[&_.link-card__content]:flex-col',
	'[&_.link-card__image-wrapper]:relative [&_.link-card__image-wrapper]:min-h-0 [&_.link-card__image-wrapper]:flex-[0_0_140px] [&_.link-card__image-wrapper]:max-w-[140px] [&_.link-card__image-wrapper]:overflow-hidden [&_.link-card__image-wrapper]:bg-[color-mix(in_oklab,var(--r-bg)_55%,var(--r-surface))] [&_.link-card__image-wrapper_img]:block [&_.link-card__image-wrapper_img]:h-full [&_.link-card__image-wrapper_img]:w-full [&_.link-card__image-wrapper_img]:object-cover max-[640px]:[&_.link-card__image-wrapper]:aspect-[16/9] max-[640px]:[&_.link-card__image-wrapper]:max-h-[160px] max-[640px]:[&_.link-card__image-wrapper]:w-full max-[640px]:[&_.link-card__image-wrapper]:max-w-none max-[640px]:[&_.link-card__image-wrapper]:flex-[0_0_auto]',
	'[&_.link-card__body]:flex [&_.link-card__body]:min-w-0 [&_.link-card__body]:flex-1 [&_.link-card__body]:flex-col [&_.link-card__body]:justify-center [&_.link-card__body]:gap-[0.28rem] [&_.link-card__body]:px-[var(--r-space-md)] [&_.link-card__body]:py-[var(--r-space-sm)] max-[640px]:[&_.link-card__body]:px-[1rem] max-[640px]:[&_.link-card__body]:py-[0.85rem] [&_.link-card__body_h3]:m-0 [&_.link-card__body_h3]:mb-[var(--r-space-xs)] [&_.link-card__body_h3]:line-clamp-2 [&_.link-card__body_h3]:[font-family:var(--r-font-body)] [&_.link-card__body_h3]:[font-size:var(--r-text)] [&_.link-card__body_h3]:font-medium [&_.link-card__body_h3]:leading-[1.45] [&_.link-card__body_h3]:text-[var(--r-ink)] [&_.link-card__body_p]:m-0 [&_.link-card__body_p]:mb-[var(--r-space-xs)] [&_.link-card__body_p]:line-clamp-2 [&_.link-card__body_p]:[font-family:var(--r-font-ui)] [&_.link-card__body_p]:[font-size:var(--r-text-sm)] [&_.link-card__body_p]:leading-[1.58] [&_.link-card__body_p]:text-[var(--r-ink-soft)] [&_.link-card__host]:mt-[0.35rem] [&_.link-card__host]:inline-flex [&_.link-card__host]:items-center [&_.link-card__host]:gap-[0.35rem] [&_.link-card__host]:[font-family:var(--r-font-ui)] [&_.link-card__host]:[font-size:var(--r-text-xs)] [&_.link-card__host]:font-medium [&_.link-card__host]:tracking-[0.035em] [&_.link-card__host]:text-[var(--r-ink-faint)] [&_.link-card__host]:opacity-70',
	'[&_.link-card--cover_.link-card__content]:flex-col [&_.link-card--cover_.link-card__image-wrapper]:aspect-[2.2/1] [&_.link-card--cover_.link-card__image-wrapper]:max-h-[200px] [&_.link-card--cover_.link-card__image-wrapper]:w-full [&_.link-card--cover_.link-card__image-wrapper]:max-w-none [&_.link-card--cover_.link-card__image-wrapper]:flex-[0_0_auto] [&_.link-card--minimal_.link-card__content]:px-[var(--r-space-md)] [&_.link-card--minimal_.link-card__content]:py-[var(--r-space-sm)] [&_.link-card--minimal_.link-card__body]:gap-[0.15rem] [&_.link-card--minimal_.link-card__body]:p-0 [&_.link-card--minimal_.link-card__body_p]:line-clamp-1',
].join(' ');
const articleTitleClass = 'r-page-title !m-0 !mb-[var(--r-space-sm)] ![font-family:var(--r-font-body)] ![font-size:var(--r-text-display)] !font-bold !leading-[1.22] !tracking-[-0.025em] !text-[var(--r-ink)]';
const articleHeaderClass = 'r-article__header mb-[0.35rem]';
const metaClass = 'r-meta mb-[1rem] flex flex-wrap gap-x-[0.85rem] gap-y-[0.5rem] [font-family:var(--r-font-ui)] [font-size:var(--r-text-xs)] text-[var(--r-ink-faint)]';
const metaLinkClass = 'border-b-0 text-[var(--r-ink-soft)] underline decoration-transparent decoration-1 underline-offset-[var(--r-link-underline-offset)] transition-[color,text-decoration-color] duration-200 hover:text-[var(--r-link)] hover:decoration-[var(--r-link-underline-color)]';
const articleDescClass = 'r-article__desc mt-[0.15rem] mb-[1.35rem] [font-family:var(--r-font-body)] [font-size:1rem] leading-[1.7] text-[var(--r-ink-soft)]';
const tocClass = [
	'r-toc group mt-[0.2rem] mb-[var(--r-space-md)] pt-0 [font-family:var(--r-font-ui)] [font-size:var(--r-text-xs)] text-[var(--r-ink-faint)]',
	'[&_.toc-container]:ml-[0.4rem] [&_.toc-container]:mt-[0.5rem] [&_.toc-container]:border-0 [&_.toc-container]:border-l [&_.toc-container]:border-[var(--r-divider)] [&_.toc-container]:bg-transparent [&_.toc-container]:pl-[1.05rem] [&_.toc-container]:shadow-none',
	'[&_.toc-toggle]:hidden [&_.toc]:!block [&_.toc-list]:m-0 [&_.toc-list]:list-none [&_.toc-list]:p-0 [&_.toc-list_.toc-list]:mt-[0.12rem] [&_.toc-list_.toc-list]:pl-[0.7rem] [&_.toc-item]:my-[0.08rem]',
	'[&_.toc_a]:border-b-0 [&_.toc_a]:text-[var(--r-ink-faint)] [&_.toc_a]:no-underline [&_.toc_a]:[font-size:var(--r-text-xs)] [&_.toc_a]:font-normal [&_.toc_a]:leading-[1.45] [&_.toc_a:hover]:text-[var(--r-ink-soft)] [&_.toc_a.active]:font-medium [&_.toc_a.active]:text-[var(--r-ink-soft)] [&_.toc_a.active]:no-underline',
].join(' ');
const tocSummaryClass = 'r-toc__summary inline-flex cursor-pointer list-none items-center border-l border-l-[var(--r-rule)] bg-[color-mix(in_oklab,var(--r-rule-soft)_34%,transparent)] px-[0.5rem] py-[0.2rem] font-normal leading-[1.35] text-[var(--r-ink)] hover:bg-[color-mix(in_oklab,var(--r-rule-soft)_48%,transparent)] hover:text-[var(--r-ink)] [&::-webkit-details-marker]:hidden';
const articleTailClass = 'r-article__tail mt-[var(--r-space-lg)] flex flex-col items-center gap-[var(--r-space-md)] border-t-0 pt-[var(--r-space-md)] [@media(hover:hover)]:[&:hover_.like-btn.post.is-empty]:pointer-events-auto [@media(hover:hover)]:[&:hover_.like-btn.post.is-empty]:opacity-55 [&_.changelog]:self-stretch [&_.changelog]:text-left [&_.changelog]:[--accent-color:var(--r-link)] [&_.changelog]:[--ink-accent:var(--r-ink-faint)] [&_.changelog]:[--serif-font:var(--r-font-ui)] [&_.changelog_*]:[--accent-color:var(--r-link)] [&_.changelog_*]:[--ink-accent:var(--r-ink-faint)] [&_.changelog_*]:[--serif-font:var(--r-font-ui)] [&_.changelog]:[font-family:var(--r-font-ui)] [&_.changelog]:text-[var(--r-ink-soft)] [&_.like-btn]:[font-family:var(--r-font-ui)] [&_.like-btn]:text-[var(--r-ink-soft)]';
const articleEndClass = 'r-article__end tracking-[0.2em] text-[var(--r-ink-faint)]';
---

<ReadingShell title={title} description={description || ''}>
	<link rel="stylesheet" href="/lightgallery/css/lightgallery.min.css" slot="head" />

	<article class={articleClass}>
		<header class={articleHeaderClass}>
			<h1 class={articleTitleClass} transition:name={postId ? `post-title-${postId}` : undefined}>{title}</h1>

			<div class={metaClass}>
				<span><FormattedDate date={pubDate} /></span>
				{topicLabels.map((label) => (
					topicLinksEnabled ? (
						<a href={`/tags/${label}/`} class={metaLinkClass}>{label}</a>
					) : (
						<span>{label}</span>
					)
				))}
				{readingTime && <span>{readingTime} min</span>}
				{updatedDate && (
					<span>更新于 <FormattedDate date={updatedDate} /></span>
				)}
				{isDev && draft && <span>草稿</span>}
			</div>

			{description && <p class={articleDescClass}>{description}</p>}
		</header>

		{showTOC && (
			<details class={tocClass}>
				<summary class={tocSummaryClass}>目录</summary>
				<Toc minLevel={tocMinLevel} maxLevel={tocMaxLevel} title="本页目录" />
			</details>
		)}

		<div class="r-prose post-content content" id="lightgallery">
			<slot />
		</div>

		<footer class={articleTailClass}>
			<div class={articleEndClass} aria-hidden="true">·</div>
			<LikeButton id={postId || Astro.url.pathname} type="post" />
			{changelog && changelog.length > 0 && <Changelog entries={changelog} />}
		</footer>

		<NavButton showBackToTop={true} />
	</article>

	<script is:inline src="/lightgallery/js/lightgallery.min.js" defer></script>

	<script is:inline>
		(function () {
			let lgInstance = null;
			let lgInitialized = false;

			function initLightGallery() {
				if (lgInitialized) return;
				lgInitialized = true;

				if (lgInstance) {
					try { lgInstance.destroy(true); } catch (e) {}
					lgInstance = null;
				}

				const postContent = document.querySelector('.post-content');
				if (postContent) {
					const images = postContent.querySelectorAll('img');
					images.forEach(function (img) {
						const src = img.src;
						if (img.parentElement.tagName === 'A') return;
						const link = document.createElement('a');
						link.href = src;
						link.className = 'no-link';
						link.setAttribute('data-sub-html', img.alt || '');
						img.parentNode.insertBefore(link, img);
						link.appendChild(img);
					});

					const container = document.getElementById('lightgallery');
					if (container && typeof window !== 'undefined' && 'lightGallery' in window) {
						lgInstance = window.lightGallery(container, {
							selector: 'a[href$=".jpg"], a[href$=".jpeg"], a[href$=".png"], a[href$=".gif"], a[href$=".webp"]',
							mode: 'lg-fade',
							cssEasing: 'ease',
							speed: 600,
							hideBarsDelay: 2000,
							controls: true,
							download: true,
							counter: true,
							thumbnail: true,
						});
					}
				}
			}

			function onReady() {
				if (typeof window.lightGallery === 'function') {
					initLightGallery();
				} else {
					setTimeout(onReady, 100);
				}
			}

			if (document.readyState === 'loading') {
				document.addEventListener('DOMContentLoaded', onReady);
			} else {
				onReady();
			}
			document.addEventListener('astro:page-load', onReady);
			document.addEventListener('astro:before-preparation', function () {
				lgInitialized = false;
				if (lgInstance) {
					try { lgInstance.destroy(true); } catch (e) {}
					lgInstance = null;
				}
			});
		})();
	</script>

	<script is:inline>
		(function () {
			function addCopyButtons() {
				const codeBlocks = document.querySelectorAll('pre:not(.code-block-added)');
				codeBlocks.forEach((block) => {
					block.classList.add('code-block-added');
					const wrapper = document.createElement('div');
					wrapper.className = 'code-wrapper';
					if (block.parentNode) {
						block.parentNode.insertBefore(wrapper, block);
						wrapper.appendChild(block);
					}
					const header = document.createElement('div');
					header.className = 'code-header';
					const code = block.querySelector('code');
					let lang = '';
					if (block.dataset.language) {
						lang = block.dataset.language;
					} else if (code) {
						const classList = code.className.split(' ');
						const langClass = classList.find((c) => c.startsWith('language-'));
						if (langClass) lang = langClass.replace('language-', '');
					}
					const langLabel = document.createElement('span');
					langLabel.className = 'code-lang';
					langLabel.textContent = lang;
					const copyBtn = document.createElement('button');
					copyBtn.className = 'copy-btn';
					copyBtn.setAttribute('aria-label', 'Copy');
					copyBtn.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>';
					copyBtn.addEventListener('click', async () => {
						try {
							if (code) {
								const text = code.innerText;
								await navigator.clipboard.writeText(text);
								copyBtn.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>';
								copyBtn.classList.add('copied');
								setTimeout(() => {
									copyBtn.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>';
									copyBtn.classList.remove('copied');
								}, 2000);
							}
						} catch (err) {
							console.error('Copy failed:', err);
						}
					});
					header.appendChild(langLabel);
					header.appendChild(copyBtn);
					wrapper.insertBefore(header, block);
				});
			}

			function onReady() { addCopyButtons(); }
			if (document.readyState === 'loading') {
				document.addEventListener('DOMContentLoaded', onReady);
			} else { onReady(); }
			document.addEventListener('astro:page-load', onReady);
		})();
	</script>

	<script is:inline>
		(function () {
			if (!document.querySelector('.post-content')) return;

			const LS_KEY = 'linkcard:cache';
			const REQUESTS_KEY = 'linkcard:requests';
			const RATE_WINDOW = 60000;
			const RATE_MAX = 10;
			const CACHE_TTL = 7 * 24 * 60 * 60 * 1000;

			function getRequests() {
				try {
					const raw = localStorage.getItem(REQUESTS_KEY);
					if (!raw) return [];
					const data = JSON.parse(raw);
					if (!Array.isArray(data)) return [];
					const now = Date.now();
					return data.filter((ts) => now - ts < RATE_WINDOW);
				} catch (e) { return []; }
			}

			function pushRequest() {
				const reqs = getRequests();
				reqs.push(Date.now());
				try { localStorage.setItem(REQUESTS_KEY, JSON.stringify(reqs)); } catch (e) {}
				return reqs;
			}

			function canRequest() { return getRequests().length < RATE_MAX; }

			function getCache(url) {
				try {
					const raw = localStorage.getItem(LS_KEY);
					if (!raw) return null;
					const cache = JSON.parse(raw);
					if (!cache || typeof cache !== 'object') return null;
					const entry = cache[url];
					if (!entry) return null;
					if (Date.now() - (entry._ts || 0) > CACHE_TTL) return null;
					return entry;
				} catch (e) { return null; }
			}

			function setCache(url, data) {
				try {
					const raw = localStorage.getItem(LS_KEY);
					const cache = raw ? JSON.parse(raw) : {};
					cache[url] = { ...data, _ts: Date.now() };
					localStorage.setItem(LS_KEY, JSON.stringify(cache));
				} catch (e) {}
			}

			async function fetchMeta(url) {
				const cached = getCache(url);
				if (cached) return cached;
				if (!canRequest()) return null;
				pushRequest();

				try {
					const controller = new AbortController();
					const timeout = setTimeout(() => controller.abort(), 5000);
					const res = await fetch(
						`https://api.microlink.io/?url=${encodeURIComponent(url)}`,
						{ signal: controller.signal }
					);
					clearTimeout(timeout);
					if (!res.ok) return null;
					const json = await res.json();
					if (!json.data) return null;
					const { title, description, image } = json.data;
					const result = {
						title: title || '',
						description: description || '',
						image: image?.url || '',
					};
					setCache(url, result);
					return result;
				} catch (e) { return null; }
			}

			function renderCard(el, url, meta) {
				const style = el.dataset.style || 'default';
				const hostname = (() => { try { return new URL(url).hostname; } catch (e) { return url; } })();
				if (!meta || !meta.title) return;

				let html = `<a href="${url}" target="_blank" rel="noopener noreferrer" class="link-card__content">`;
				if (style === 'cover' && meta.image) {
					html += `<div class="link-card__image-wrapper"><img src="${meta.image}" alt="" loading="lazy" decoding="async" onerror="this.style.display='none'" /></div>`;
				} else if (style !== 'minimal' && meta.image) {
					html += `<div class="link-card__image-wrapper"><img src="${meta.image}" alt="" loading="lazy" decoding="async" onerror="this.style.display='none'" /></div>`;
				}
				html += `<div class="link-card__body"><h3>${meta.title}</h3>`;
				if (meta.description && style !== 'minimal') {
					html += `<p>${meta.description}</p>`;
				}
				html += `<span class="link-card__host">${hostname}</span></div></a>`;
				el.innerHTML = html;
				el.classList.add('link-card--ready');
			}

			function scanAndConvert() {
				const contentEl = document.querySelector('.post-content');
				if (!contentEl) return;
				const paragraphs = contentEl.querySelectorAll('p');
				paragraphs.forEach((p) => {
					const text = p.textContent.trim();
					const match = text.match(/^::link-card\{url="([^"]+)"(?:\s*,\s*style="([^"]+)")?\}$/);
					if (match) {
						const url = match[1];
						const style = match[2] || '';
						const styleClass = style ? `link-card--${style}` : '';
						p.outerHTML = '<div class="link-card ' + styleClass + '" data-url="' + url + '"' + (style ? ' data-style="' + style + '"' : '') + '><a href="' + url + '" target="_blank" rel="noopener noreferrer" class="link-card__fallback">' + url + '</a></div>';
					}
				});
			}

			async function initCards() {
				scanAndConvert();
				const cards = document.querySelectorAll('.link-card[data-url]');
				if (cards.length === 0) return;
				for (const el of cards) {
					const url = el.getAttribute('data-url');
					if (!url) continue;
					const cached = getCache(url);
					if (cached && cached.title) {
						renderCard(el, url, cached);
						continue;
					}
					const meta = await fetchMeta(url);
					if (meta) renderCard(el, url, meta);
				}
			}

			if (document.readyState === 'loading') {
				document.addEventListener('DOMContentLoaded', initCards);
			} else { initCards(); }
			document.addEventListener('astro:page-load', initCards);
		})();
	</script>
</ReadingShell>
