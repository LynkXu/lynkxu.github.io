---
import type { CollectionEntry } from 'astro:content';
import ReadingShell from './ReadingShell.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Toc from '../components/Toc.astro';
import NavButton from '../components/NavButton.astro';
import Changelog from '../components/Changelog.astro';
import LikeButton from '../components/LikeButton.astro';

type Props = CollectionEntry<'blog'>['data'] & {
	postId?: string;
	showTOC?: boolean;
	tocMinLevel?: number;
	tocMaxLevel?: number;
	readingTime?: number;
};

const {
	title,
	description,
	pubDate,
	updatedDate,
	tags,
	categories,
	draft,
	changelog,
	postId,
	showTOC = true,
	tocMinLevel = 2,
	tocMaxLevel = 3,
	readingTime,
} = Astro.props;

const isDev = import.meta.env.DEV;
const topicLabels = tags?.length
	? tags
	: categories?.length
		? categories
		: [];
const topicLinksEnabled = Boolean(tags?.length);
const articleClass = [
	'r-article',
	'[&_.nav-buttons-group]:fixed [&_.nav-buttons-group]:bottom-[var(--r-space-lg)] [&_.nav-buttons-group]:right-[var(--r-page-inline)] [&_.nav-buttons-group]:z-20',
	'[&_.nav-button]:inline-flex [&_.nav-button]:h-auto [&_.nav-button]:min-h-9 [&_.nav-button]:w-auto [&_.nav-button]:min-w-9 [&_.nav-button]:cursor-pointer [&_.nav-button]:items-center [&_.nav-button]:justify-center [&_.nav-button]:rounded-none [&_.nav-button]:border-0 [&_.nav-button]:bg-transparent [&_.nav-button]:p-[var(--space-2xs)] [&_.nav-button]:text-[var(--r-ink-soft)] [&_.nav-button]:shadow-none [&_.nav-button]:backdrop-blur-none [&_.nav-button:hover]:translate-y-0 [&_.nav-button:hover]:bg-transparent [&_.nav-button:hover]:text-[var(--r-ink)] [&_.nav-button_svg]:block [&_.nav-button_svg]:h-[18px] [&_.nav-button_svg]:w-[18px]',
].join(' ');
const articleTitleClass = 'r-page-title !m-0 !mb-[var(--r-space-sm)] ![font-family:var(--r-font-body)] ![font-size:var(--r-text-display)] !font-bold !leading-[1.22] !tracking-[-0.025em] !text-[var(--r-ink)]';
const articleHeaderClass = 'r-article__header mb-[0.35rem]';
const metaClass = 'r-meta mb-[1rem] flex flex-wrap gap-x-[0.85rem] gap-y-[0.5rem] [font-family:var(--r-font-ui)] [font-size:var(--r-text-xs)] text-[var(--r-ink-faint)]';
const metaLinkClass = 'border-b-0 text-[var(--r-ink-soft)] underline decoration-transparent decoration-1 underline-offset-[var(--r-link-underline-offset)] transition-[color,text-decoration-color] duration-200 hover:text-[var(--r-link)] hover:decoration-[var(--r-link-underline-color)]';
const articleDescClass = 'r-article__desc mt-[0.15rem] mb-[1.35rem] [font-family:var(--r-font-body)] [font-size:1rem] leading-[1.7] text-[var(--r-ink-soft)]';
const tocClass = [
	'r-toc group mt-[0.2rem] mb-[var(--r-space-md)] border-l border-l-[var(--r-rule)] bg-[color-mix(in_oklab,var(--r-rule-soft)_22%,transparent)] pt-0 [font-family:var(--r-font-ui)] [font-size:var(--r-text-xs)] text-[var(--r-ink-faint)]',
	'[&_.toc-container]:mt-0 [&_.toc-container]:border-0 [&_.toc-container]:border-t [&_.toc-container]:border-[var(--r-divider)] [&_.toc-container]:bg-transparent [&_.toc-container]:px-[0.75rem] [&_.toc-container]:py-[0.65rem] [&_.toc-container]:shadow-none',
	'[&_.toc-toggle]:hidden [&_.toc]:!block [&_.toc-list]:m-0 [&_.toc-list]:list-none [&_.toc-list]:p-0 [&_.toc-list_.toc-list]:mt-[0.12rem] [&_.toc-list_.toc-list]:pl-[0.7rem] [&_.toc-item]:my-[0.08rem]',
	'[&_.toc_a]:border-b-0 [&_.toc_a]:text-[var(--r-ink-faint)] [&_.toc_a]:no-underline [&_.toc_a]:[font-size:var(--r-text-xs)] [&_.toc_a]:font-normal [&_.toc_a]:leading-[1.45] [&_.toc_a:hover]:text-[var(--r-ink-soft)] [&_.toc_a.active]:font-medium [&_.toc_a.active]:text-[var(--r-ink-soft)] [&_.toc_a.active]:no-underline',
].join(' ');
const tocSummaryClass = 'r-toc__summary flex min-h-7 w-full cursor-pointer list-none items-center box-border select-none bg-transparent px-[0.75rem] py-[0.1rem] group-open:min-h-8 group-open:py-[0.2rem] font-medium leading-[1.35] tracking-[0.02em] text-[var(--r-ink-soft)] transition-colors duration-200 hover:bg-[color-mix(in_oklab,var(--r-rule-soft)_24%,transparent)] hover:text-[var(--r-ink)] [&::-webkit-details-marker]:hidden';
const articleTailClass = 'r-article__tail mt-[var(--r-space-lg)] flex flex-col items-center gap-[var(--r-space-md)] border-t-0 pt-[var(--r-space-md)] [@media(hover:hover)]:[&:hover_.like-btn.post.is-empty]:pointer-events-auto [@media(hover:hover)]:[&:hover_.like-btn.post.is-empty]:opacity-55 [&_.changelog]:self-stretch [&_.changelog]:text-left [&_.changelog]:[--accent-color:var(--r-link)] [&_.changelog]:[--ink-accent:var(--r-ink-faint)] [&_.changelog]:[--serif-font:var(--r-font-ui)] [&_.changelog_*]:[--accent-color:var(--r-link)] [&_.changelog_*]:[--ink-accent:var(--r-ink-faint)] [&_.changelog_*]:[--serif-font:var(--r-font-ui)] [&_.changelog]:[font-family:var(--r-font-ui)] [&_.changelog]:text-[var(--r-ink-soft)] [&_.like-btn]:[font-family:var(--r-font-ui)] [&_.like-btn]:text-[var(--r-ink-soft)]';
const articleEndClass = 'r-article__end tracking-[0.2em] text-[var(--r-ink-faint)]';
---

<ReadingShell title={title} description={description || ''}>
	<link rel="stylesheet" href="/lightgallery/css/lightgallery.min.css" slot="head" />

	<article class={articleClass}>
		<header class={articleHeaderClass}>
			<h1 class={articleTitleClass} transition:name={postId ? `post-title-${postId}` : undefined}>{title}</h1>

			<div class={metaClass}>
				<span><FormattedDate date={pubDate} /></span>
				{topicLabels.map((label) => (
					topicLinksEnabled ? (
						<a href={`/tags/${label}/`} class={metaLinkClass}>{label}</a>
					) : (
						<span>{label}</span>
					)
				))}
				{readingTime && <span>{readingTime} min</span>}
				{updatedDate && (
					<span>更新于 <FormattedDate date={updatedDate} /></span>
				)}
				{isDev && draft && <span>草稿</span>}
			</div>

			{description && <p class={articleDescClass}>{description}</p>}
		</header>

		{showTOC && (
			<details class={tocClass}>
				<summary class={tocSummaryClass}>目录</summary>
				<Toc minLevel={tocMinLevel} maxLevel={tocMaxLevel} title="本页目录" />
			</details>
		)}

		<div class="r-prose post-content content" id="lightgallery">
			<slot />
		</div>

		<footer class={articleTailClass}>
			<div class={articleEndClass} aria-hidden="true">·</div>
			<LikeButton id={postId || Astro.url.pathname} type="post" />
			{changelog && changelog.length > 0 && <Changelog entries={changelog} />}
		</footer>

		<NavButton showBackToTop={true} />
	</article>

	<script is:inline src="/lightgallery/js/lightgallery.min.js" defer></script>

	<script is:inline>
		(function () {
			let lgInstance = null;
			let lgInitialized = false;

			function initLightGallery() {
				if (lgInitialized) return;
				lgInitialized = true;

				if (lgInstance) {
					try { lgInstance.destroy(true); } catch (e) {}
					lgInstance = null;
				}

				const postContent = document.querySelector('.post-content');
				if (postContent) {
					const images = postContent.querySelectorAll('img');
					images.forEach(function (img) {
						const src = img.src;
						if (img.parentElement.tagName === 'A') return;
						const link = document.createElement('a');
						link.href = src;
						link.className = 'no-link';
						link.setAttribute('data-sub-html', img.alt || '');
						img.parentNode.insertBefore(link, img);
						link.appendChild(img);
					});

					const container = document.getElementById('lightgallery');
					if (container && typeof window !== 'undefined' && 'lightGallery' in window) {
						lgInstance = window.lightGallery(container, {
							selector: 'a[href$=".jpg"], a[href$=".jpeg"], a[href$=".png"], a[href$=".gif"], a[href$=".webp"]',
							mode: 'lg-fade',
							cssEasing: 'ease',
							speed: 600,
							hideBarsDelay: 2000,
							controls: true,
							download: true,
							counter: true,
							thumbnail: true,
						});
					}
				}
			}

			function onReady() {
				if (typeof window.lightGallery === 'function') {
					initLightGallery();
				} else {
					setTimeout(onReady, 100);
				}
			}

			if (document.readyState === 'loading') {
				document.addEventListener('DOMContentLoaded', onReady);
			} else {
				onReady();
			}
			document.addEventListener('astro:page-load', onReady);
			document.addEventListener('astro:before-preparation', function () {
				lgInitialized = false;
				if (lgInstance) {
					try { lgInstance.destroy(true); } catch (e) {}
					lgInstance = null;
				}
			});
		})();
	</script>

	<script is:inline>
		(function () {
			const COPY_ICON = '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>';
			const CHECK_ICON = '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>';

			function resolveLang(block, code) {
				if (block.dataset.language) return block.dataset.language.trim();
				if (!code) return '';
				const langClass = code.className.split(/\s+/).find((c) => c.startsWith('language-'));
				return langClass ? langClass.replace('language-', '') : '';
			}

			function addCopyButtons() {
				const codeBlocks = document.querySelectorAll('.r-article pre:not(.code-block-added)');
				codeBlocks.forEach((block) => {
					block.classList.add('code-block-added');
					const wrapper = document.createElement('div');
					wrapper.className = 'code-wrapper';
					if (block.parentNode) {
						block.parentNode.insertBefore(wrapper, block);
						wrapper.appendChild(block);
					}

					const header = document.createElement('div');
					header.className = 'code-header';

					const code = block.querySelector('code');
					const lang = resolveLang(block, code);
					if (lang) {
						const langLabel = document.createElement('span');
						langLabel.className = 'code-lang';
						langLabel.textContent = lang;
						header.appendChild(langLabel);
					}

					const copyBtn = document.createElement('button');
					copyBtn.type = 'button';
					copyBtn.className = 'copy-btn';
					copyBtn.setAttribute('aria-label', '复制代码');
					copyBtn.innerHTML = COPY_ICON;
					copyBtn.addEventListener('click', async () => {
						try {
							if (!code) return;
							await navigator.clipboard.writeText(code.innerText);
							copyBtn.innerHTML = CHECK_ICON;
							copyBtn.classList.add('copied');
							copyBtn.setAttribute('aria-label', '已复制');
							setTimeout(() => {
								copyBtn.innerHTML = COPY_ICON;
								copyBtn.classList.remove('copied');
								copyBtn.setAttribute('aria-label', '复制代码');
							}, 1800);
						} catch (err) {
							console.error('Copy failed:', err);
						}
					});
					header.appendChild(copyBtn);
					wrapper.insertBefore(header, block);
				});
			}

			function onReady() { addCopyButtons(); }
			if (document.readyState === 'loading') {
				document.addEventListener('DOMContentLoaded', onReady);
			} else { onReady(); }
			document.addEventListener('astro:page-load', onReady);
		})();
	</script>

	<script is:inline>
		(function () {
			if (!document.querySelector('.post-content')) return;

			const LS_KEY = 'linkcard:cache';
			const REQUESTS_KEY = 'linkcard:requests';
			const RATE_WINDOW = 60000;
			const RATE_MAX = 10;
			const CACHE_TTL = 7 * 24 * 60 * 60 * 1000;

			function getRequests() {
				try {
					const raw = localStorage.getItem(REQUESTS_KEY);
					if (!raw) return [];
					const data = JSON.parse(raw);
					if (!Array.isArray(data)) return [];
					const now = Date.now();
					return data.filter((ts) => now - ts < RATE_WINDOW);
				} catch (e) { return []; }
			}

			function pushRequest() {
				const reqs = getRequests();
				reqs.push(Date.now());
				try { localStorage.setItem(REQUESTS_KEY, JSON.stringify(reqs)); } catch (e) {}
				return reqs;
			}

			function canRequest() { return getRequests().length < RATE_MAX; }

			function getCache(url) {
				try {
					const raw = localStorage.getItem(LS_KEY);
					if (!raw) return null;
					const cache = JSON.parse(raw);
					if (!cache || typeof cache !== 'object') return null;
					const entry = cache[url];
					if (!entry) return null;
					if (Date.now() - (entry._ts || 0) > CACHE_TTL) return null;
					return entry;
				} catch (e) { return null; }
			}

			function setCache(url, data) {
				try {
					const raw = localStorage.getItem(LS_KEY);
					const cache = raw ? JSON.parse(raw) : {};
					cache[url] = { ...data, _ts: Date.now() };
					localStorage.setItem(LS_KEY, JSON.stringify(cache));
				} catch (e) {}
			}

			async function fetchMeta(url) {
				const cached = getCache(url);
				if (cached) return cached;
				if (!canRequest()) return null;
				pushRequest();

				try {
					const controller = new AbortController();
					const timeout = setTimeout(() => controller.abort(), 5000);
					const res = await fetch(
						`https://api.microlink.io/?url=${encodeURIComponent(url)}`,
						{ signal: controller.signal }
					);
					clearTimeout(timeout);
					if (!res.ok) return null;
					const json = await res.json();
					if (!json.data) return null;
					const { title, description, image } = json.data;
					const result = {
						title: title || '',
						description: description || '',
						image: image?.url || '',
					};
					setCache(url, result);
					return result;
				} catch (e) { return null; }
			}

			function resolveCardStyle(el) {
				if (el.dataset.style) return el.dataset.style;
				if (el.classList.contains('link-card--cover')) return 'cover';
				if (el.classList.contains('link-card--minimal')) return 'minimal';
				return 'default';
			}

			function renderCard(el, url, meta) {
				const style = resolveCardStyle(el);
				const hostname = (() => { try { return new URL(url).hostname; } catch (e) { return url; } })();
				if (!meta || !meta.title) return;

				let html = `<a href="${url}" target="_blank" rel="noopener noreferrer" class="link-card__content">`;
				if (style === 'cover' && meta.image) {
					html += `<div class="link-card__image-wrapper"><img src="${meta.image}" alt="" loading="lazy" decoding="async" onerror="this.style.display='none'" /></div>`;
				} else if (style !== 'minimal' && meta.image) {
					html += `<div class="link-card__image-wrapper"><img src="${meta.image}" alt="" loading="lazy" decoding="async" onerror="this.style.display='none'" /></div>`;
				}
				html += `<div class="link-card__body"><h3>${meta.title}</h3>`;
				if (meta.description && style !== 'minimal') {
					html += `<p>${meta.description}</p>`;
				}
				html += `<span class="link-card__host">${hostname}</span></div></a>`;
				el.innerHTML = html;
				el.classList.add('link-card--ready');
			}

			function scanAndConvert() {
				const contentEl = document.querySelector('.post-content');
				if (!contentEl) return;
				const paragraphs = contentEl.querySelectorAll('p');
				paragraphs.forEach((p) => {
					const text = p.textContent.trim();
					const match = text.match(/^::link-card\{url="([^"]+)"(?:\s*,\s*style="([^"]+)")?\}$/);
					if (match) {
						const url = match[1];
						const style = match[2] || '';
						const styleClass = style ? `link-card--${style}` : '';
						p.outerHTML = '<div class="link-card ' + styleClass + '" data-url="' + url + '"' + (style ? ' data-style="' + style + '"' : '') + '><a href="' + url + '" target="_blank" rel="noopener noreferrer" class="link-card__fallback">' + url + '</a></div>';
					}
				});
			}

			async function initCards() {
				scanAndConvert();
				const cards = document.querySelectorAll('.link-card[data-url]');
				if (cards.length === 0) return;
				for (const el of cards) {
					const url = el.getAttribute('data-url');
					if (!url) continue;
					const cached = getCache(url);
					if (cached && cached.title) {
						renderCard(el, url, cached);
						continue;
					}
					const meta = await fetchMeta(url);
					if (meta) renderCard(el, url, meta);
				}
			}

			if (document.readyState === 'loading') {
				document.addEventListener('DOMContentLoaded', initCards);
			} else { initCards(); }
			document.addEventListener('astro:page-load', initCards);
		})();
	</script>
</ReadingShell>
